---
// A page head: a card on the plot, its band carrying the plate number, the
// name and the scale, then the title (5 columns) and the lede (7). A second
// card can sit beside it through the slot (Contact's data).
interface Props {
  no: string;
  name: string;
  scale?: string;
  title: string;
  lead?: string;
}
const { no, name, scale, title, lead } = Astro.props;
const side = Astro.slots.has("default");
---

<section class:list={["field", "field--page", side && "field--side"]}>
  <div class="sheet">
    <div class="card page-card">
      <div class="band">
        <span class="band__no">{no}</span>
        <span class="band__name">{name}</span>
        {scale && <span class="band__scale">{scale}</span>}
      </div>
      <div class="page-card__body">
        <h1 class="h-display">{title}</h1>
        {lead && <p class="lede">{lead}</p>}
      </div>
    </div>
    <slot />
  </div>
</section>

<style is:global>
  .field--page > .sheet {
    grid-template-columns: 1fr;
    padding-block: 24px;
  }
  .field--page + .panel {
    margin-top: 24px;
  }
  .field--page.field--side > .sheet {
    grid-template-columns: 5fr 7fr;
  }
  .page-card {
    display: flex;
    flex-direction: column;
  }
  .page-card__body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 32px;
    align-items: start;
    padding: 28px 32px;
  }
  .page-card__body .lede {
    margin-top: 6px;
    max-width: 60ch;
  }
  .field--side .page-card__body {
    display: block;
  }
  .field--side .page-card__body .lede {
    margin-top: 16px;
  }
  @media (max-width: 800px) {
    .field--page > .sheet,
    .field--page.field--side > .sheet {
      grid-template-columns: 1fr;
      padding-block: 12px;
    }
    .page-card__body {
      display: block;
      padding: 20px 16px 24px;
    }
    .page-card__body .lede,
    .field--side .page-card__body .lede {
      margin-top: 14px;
    }
  }
</style>
