---
// The exploded axonometric — the plate this whole direction is named for.
//
// Membrane, walls, structure and deck separated in the vertical, on a true
// isometric, with numbered callouts on dashed leaders. Rendered to SVG at
// build time: it is the site's central explanation, so it must be present in
// the HTML with no JavaScript, no WebGL and no waiting.
//
// The viewBox is computed from the geometry rather than hand-set, so the
// drawing can never grow out of its box when the spread or scale changes.

import {
  marquee, isometric, pts, tone, callout,
  INK, LINE, LINE_SOFT, FILL, type P3,
} from "../lib/draft";

interface Props {
  /** Vertical separation between layers, in metres. */
  spread?: number;
}
const { spread = 5.5 } = Astro.props;

const M = marquee();
const SCALE = 16;
const P0 = isometric({ scale: SCALE, cx: 0, cy: 0 });

const lift = (q: readonly P3[], dy: number): P3[] =>
  q.map(([x, y, z]) => [x, y + dy, z] as P3);

const deckY = -spread * 0.9;
const deck = M.panels.find((p) => p.part === "deck")!;
const deckLifted = lift(deck.quad, deckY);

const LAYERS = [
  { dy: spread * 2, panels: M.panels.filter((p) => p.part === "roof") },
  { dy: spread, panels: M.panels.filter((p) => p.part === "wall" || p.part === "gable") },
];

// ---- fit the box to the drawing ------------------------------------------
const all: P3[] = [
  ...deckLifted,
  ...M.members.flatMap(([a, b]) => [a, b]),
  ...LAYERS.flatMap((l) => l.panels.flatMap((p) => lift(p.quad, l.dy))),
];
const xs = all.map((p) => P0(p)[0]);
const ys = all.map((p) => P0(p)[1]);
const minX = Math.min(...xs), maxX = Math.max(...xs);
const minY = Math.min(...ys), maxY = Math.max(...ys);

// Room on each side for the callout labels, which sit outside the object.
const PAD_X = 285;
const PAD_Y = 34;
const VB_W = maxX - minX + PAD_X * 2;
const VB_H = maxY - minY + PAD_Y * 2;
const P = isometric({ scale: SCALE, cx: -minX + PAD_X, cy: -minY + PAD_Y });

let g = "";

// ---- deck, at the bottom --------------------------------------------------
g += `<polygon points="${pts(deckLifted, P)}" fill="${FILL}" stroke="${LINE}" stroke-width="1.2"/>`;
for (let i = 1; i < 6; i++) {
  const t = i / 6;
  const a: P3 = [-M.hw, deckY, -M.hd + t * M.spec.d];
  const b: P3 = [M.hw, deckY, -M.hd + t * M.spec.d];
  const [x1, y1] = P(a); const [x2, y2] = P(b);
  g += `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="${LINE_SOFT}" stroke-width=".7"/>`;
}

// ---- the frame: drawn heaviest, because it is the object ------------------
for (const [a, b] of M.members) {
  const [x1, y1] = P(a); const [x2, y2] = P(b);
  g += `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="${INK}" stroke-width="1.6" stroke-linecap="round"/>`;
}

// ---- lifted envelope layers ----------------------------------------------
for (const layer of LAYERS) {
  for (const p of layer.panels) {
    g += `<polygon points="${pts(lift(p.quad, layer.dy), P)}" fill="${tone(p.quad)}" fill-opacity="0.94" stroke="${LINE}" stroke-width="1.1" stroke-linejoin="round"/>`;
  }
}

// ---- callouts — these numbers are the key printed beneath the drawing -----
const a1 = P([-M.hw / 2, (M.spec.eave + M.spec.ridge) / 2 + spread * 2, -M.hd / 2]);
const a2 = P([M.hw, M.spec.eave / 2 + spread, M.hd / 3]);
const a3 = P([-M.hw, M.spec.eave / 2, M.hd]);
const a4 = P([0, deckY, M.hd / 2]);

const RIGHT = VB_W - PAD_X + 70;
const LEFT = PAD_X - 70;

g += callout(1, [a1[0], a1[1]], [RIGHT, PAD_Y + 40], "Membrană & acoperiș");
g += callout(2, [a2[0], a2[1]], [RIGHT, PAD_Y + (maxY - minY) * 0.45], "Pereți laterali");
g += callout(3, [a3[0], a3[1]], [LEFT, PAD_Y + (maxY - minY) * 0.62], "Structură portantă", { align: "end" });
g += callout(4, [a4[0], a4[1]], [LEFT, VB_H - PAD_Y - 24], "Pardoseală modulară", { align: "end" });
---

<figure class="plate-drawing">
  <svg viewBox={`0 0 ${VB_W.toFixed(0)} ${VB_H.toFixed(0)}`} role="img" aria-labelledby="ex-t ex-d">
    <title id="ex-t">Vedere explodată a cortului</title>
    <desc id="ex-d">
      Desen axonometric al unui cort de 15 × 10 m, cu straturile separate pe
      verticală: 1 membrana și acoperișul, 2 pereții laterali, 3 structura
      portantă, 4 pardoseala modulară.
    </desc>
    <g set:html={g} />
  </svg>
  <figcaption class="dim">
    Fig. 1 — Cort 15 × 10 m, vedere explodată. Axonometrie, scara 1:100.
  </figcaption>
</figure>

<style>
  .plate-drawing { margin: 0; }
  .plate-drawing svg { display: block; width: 100%; height: auto; }
  figcaption {
    margin-top: 1.15rem;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--color-ink-2);
    text-transform: uppercase;
  }
</style>
