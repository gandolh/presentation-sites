---
// The title block of the set: who drew it, what it is, and when. Here it
// carries navigation and the legal identification the site is required to
// publish. Facts are separate parts, not joined with a middle dot.
import { site } from "../content/site";
import { withBase } from "@sites/kit";

const year = new Date().getFullYear();
const nav = [
  { href: "/", label: "Acasă", no: "00" },
  { href: "/corturi/", label: "Corturi", no: "01" },
  { href: "/servicii/", label: "Servicii", no: "02" },
  { href: "/zona/", label: "Zonă", no: "03" },
  { href: "/contact/", label: "Contact", no: "04" },
];
const legal = [
  { href: "/confidentialitate/", label: "Politică de confidențialitate" },
  { href: "/termeni/", label: "Termeni și condiții" },
  { href: "/cookie-uri/", label: "Politică de cookie-uri" },
];
const L = site.legal;
---

<footer class="foot">
  <div class="sheet">
    <div class="foot__grid">
      <div class="foot__cell">
        <p class="label">Beneficiar / Executant</p>
        <p class="foot__word">SUBCORT</p>
        <p class="foot__sub">{site.tagline}</p>
      </div>

      <nav class="foot__cell" aria-label="Navigare subsol">
        <p class="label">Planșe</p>
        <ul>
          {nav.map((l) => (
            <li>
              <a href={withBase(l.href)}>
                <i>{l.no}</i>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="foot__cell" aria-label="Documente legale">
        <p class="label">Documente</p>
        <ul>
          {legal.map((l) => (
            <li>
              <a href={withBase(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="foot__cell">
        <p class="label">Contact</p>
        <ul>
          <li>
            <a href={`tel:+${site.phoneE164}`}>{site.phone}</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li class="foot__addr">
            {site.address}, {site.city}
          </li>
        </ul>
        <div class="foot__social">
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="foot__rev">
      <div class="foot__legal">
        <span>{L.legalName}</span>
        <span>CUI: {L.cui}</span>
        <span>Reg. Com.: {L.regNumber}</span>
        <span>Capital social: {L.shareCapital}</span>
      </div>
      <p>
        {site.address}, {site.city}, jud. {site.county}
      </p>
      {site.demo.show && <p>{site.demo.text}</p>}
      <div class="foot__row">
        <span>
          © {year} {site.name}
        </span>
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener">
          ANPC, Soluționarea Alternativă a Litigiilor
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 48px;
    background: var(--color-fill-2);
    border-top: 1.5px solid var(--color-ink);
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr;
  }
  .foot__cell {
    padding: 28px 24px 24px 0;
    border-right: 1px solid var(--color-hair);
  }
  .foot__cell + .foot__cell {
    padding-left: 24px;
  }
  .foot__cell:last-child {
    border-right: 0;
  }
  .foot__word {
    margin-top: 8px;
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: 700;
  }
  .foot__sub {
    margin-top: 8px;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .foot__cell ul {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .foot__cell ul a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--color-line-soft);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .foot__cell ul a:hover,
  .foot__rev a:hover {
    color: var(--color-signal-hover);
    text-decoration-color: var(--color-signal-hover);
  }
  .foot__cell ul a i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .foot__addr {
    padding-top: 4px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .foot__social {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .foot__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    color: var(--color-ink-2);
  }
  .foot__social a:hover {
    border-color: var(--color-signal-hover);
    color: var(--color-signal-hover);
  }
  .foot__social a:active {
    background: var(--color-fill-2);
  }
  .foot__rev {
    padding: 20px 0 32px;
    border-top: 1px solid var(--color-hair);
    font-size: var(--text-label);
    line-height: 1.57;
    color: var(--color-ink-2);
  }
  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .foot__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    margin-top: 12px;
  }
  .foot__rev a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--color-line-soft);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 1099px) {
    .foot__grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot__cell {
      border-right: 0;
      border-bottom: 1px solid var(--color-hair);
      padding-left: 0 !important;
    }
  }
  @media (max-width: 800px) {
    .foot {
      margin-top: 32px;
    }
    .foot__grid {
      grid-template-columns: 1fr;
    }
    .foot__cell {
      padding: 20px 0;
    }
    .foot__row {
      justify-content: flex-start;
    }
  }
</style>
