---
// A revision note across the top of the sheet: this is a concept drawing, and
// the company and contact details on it are fictional.
import { site } from "../content/site";
---

{site.demo.show && (
  <div class="demo-note">
    <div class="sheet">
      <p>
        <b>Notă</b>
        {site.demo.text}
      </p>
    </div>
  </div>
)}

<style>
  .demo-note {
    background: var(--color-signal-soft);
    color: var(--color-on-signal-soft);
  }
  .demo-note p {
    padding-block: 8px;
    font-size: var(--text-label);
    line-height: 1.43;
    font-weight: 500;
  }
  .demo-note b {
    margin-right: 8px;
    font-weight: 700;
  }
</style>
