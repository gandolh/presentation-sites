---
// A revision note across the top of the sheet: this is a concept drawing, and
// the company and contact details on it are fictional.
import { site } from "../content/site";
---
{site.demo.show && (
  <div class="demo-note">
    <div class="sheet"><p><span class="dim">NOTĂ</span>{site.demo.text}</p></div>
  </div>
)}

<style>
  .demo-note {
    background: var(--color-signal-soft);
    border-bottom: 1px solid color-mix(in oklab, var(--color-signal) 25%, transparent);
    color: var(--color-on-signal-soft);
  }
  .demo-note p {
    padding-block: 0.45rem;
    font-size: 0.76rem;
    line-height: 1.5;
    text-align: center;
  }
  .demo-note span {
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    margin-right: 0.7rem;
    opacity: 0.75;
  }
</style>
