---
// One numbered panel in the set: a head band with its number, name and scale,
// then the content. Panels lie on the ground with a 24 px gutter.
interface Props {
  no: string;
  name: string;
  scale?: string;
  /** The id of the heading inside the body, when it has one. */
  labelledby?: string;
  label?: string;
  /** Less air above the content, for a panel with no heading in view. */
  tight?: boolean;
}
const { no, name, scale, labelledby, label, tight = false } = Astro.props;
---

<section class="panel" aria-labelledby={labelledby} aria-label={labelledby ? undefined : (label ?? name)}>
  <div class="band">
    <span class="band__no">{no}</span>
    <span class="band__name">{name}</span>
    {scale && <span class="band__scale">{scale}</span>}
  </div>
  <div class:list={["panel__body", tight && "panel__body--tight"]}>
    <slot />
  </div>
</section>
