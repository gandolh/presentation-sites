---
import Base from "../layouts/Base.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Plate from "../components/Plate.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { services } from "../content/services";
---

<Base
  path="/servicii/"
  title={`Servicii prin parteneri · ${site.name}`}
  description="Pe lângă cort, coordonăm catering, muzică și decor prin parteneri locali, la cerere și contra cost. Tu alegi, noi ne ocupăm de logistică în cort."
>
  <DemoBanner />
  <Nav current="/servicii/" />

  <main id="main">
    <PageHeader
      plate="02 · Servicii"
      scale="Anexă"
      title="Mai mult decât cortul, prin parteneri"
      lead="Dacă vrei, ne ocupăm și de ce se întâmplă sub cort. Coordonăm catering, muzică și decor prin firme locale, la cerere și contra cost. Cortul rămâne baza neutră peste care se construiește restul."
    />

    <Plate no="02.1 · Anexe" note="Prin parteneri locali" tight>
      <ul class="services">
        {services.map((s, i) => (
          <li class="reveal service">
            <span class="callout-no" aria-hidden="true">{i + 1}</span>
            <h3 class="heading-md mt-4">{s.title}</h3>
            <p class="mt-3 text-[0.93rem] leading-relaxed text-[var(--color-ink-2)]">{s.description}</p>
          </li>
        ))}
      </ul>
    </Plate>

    {/* The "prin parteneri" framing, stated once — not repeated per item. */}
    <Plate no="02.2 · Notă" note="Condiții" title="Toate, prin parteneri locali">
      <div class="mt-7 grid gap-5 md:grid-cols-2 md:gap-10">
        <p class="prose-measure leading-relaxed text-[var(--color-ink-2)]">
          Aceste servicii sunt asigurate de furnizori din zonă, cu care lucrăm.
          Le coordonăm pentru tine ca să fie la locul lor înainte de eveniment,
          dar alegerea îți aparține și costul lor se adaugă separat de cort.
        </p>
        <p class="prose-measure leading-relaxed text-[var(--color-ink-2)]">
          Nu impunem un pachet fix. Poți lua doar cortul, sau cortul plus
          oricare dintre cele de mai sus.
        </p>
      </div>
    </Plate>
  </main>

  <Footer />
</Base>

<style>
  .services { display: grid; gap: 2.25rem 3rem; }
  @media (min-width: 760px) { .services { grid-template-columns: repeat(3, 1fr); } }
  .service { border-top: 1.5px solid var(--color-ink); padding-top: 1.25rem; }
</style>
