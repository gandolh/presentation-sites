---
import Base from "../layouts/Base.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Nav from "../components/Nav.astro";
import HeroScene from "../components/HeroScene.astro";
import ExplodedPlate from "../components/ExplodedPlate.astro";
import Plate from "../components/Plate.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { withBase } from "@sites/kit";
import { steps } from "../content/zone";
import { amenities } from "../content/tents";

// The key to the exploded plate. Each entry is one callout on the drawing, in
// callout order — the numbers on the page and the numbers on the drawing are
// the same numbers, which is the whole point of a key.
const byTitle = (t: string) => amenities.find((a) => a.title === t)?.description ?? "";
const KEY = [
  {
    n: 1,
    title: "Membrană & acoperiș",
    description: "Învelitoarea care ține apa și soarele afară, tensionată peste structură și fixată pe toată lungimea.",
  },
  {
    n: 2,
    title: "Pereți laterali",
    description: byTitle("Pereți laterali"),
  },
  {
    n: 3,
    title: "Structură portantă",
    description:
      "Cadrele și panele care duc toată sarcina în teren, montate la deschiderea aleasă, în travei de 2,5 m.",
  },
  {
    n: 4,
    title: "Pardoseală modulară",
    description: byTitle("Pardoseală modulară"),
  },
];
---

<Base path="/">
  <DemoBanner />
  <Nav current="/" />

  <main id="main">
    {/* ===================== THE FIELD =====================
        The structure assembles itself out of the same layers the exploded
        plate draws further down. The copy card and the title block lie on the plot. */}
    <section class="field" aria-label="Subcort — corturi pentru evenimente">
      <div class="sheet">
        <div class="card hero-copy">
          <h1 class="h-display">Un spațiu pregătit, oriunde ai nevoie de el.</h1>
          <p class="lede">
            Aducem structura la tine, o ridicăm pe terenul tău și o pregătim complet: pardoseală, pereți, iluminat și
            climatizare. Tu te ocupi de eveniment, noi de spațiul în care are loc.
          </p>
          <a href={withBase("/corturi/")} class="link-btn">
            Vezi dimensiunile și dotările
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        <div class="hero-right">
          <div class="hero-plate">
            <HeroScene />
          </div>
          {/* The title block: the key dimensions, with the place first on a phone. */}
          <div class="card tb">
            <dl>
              <div>
                <dt>Deschidere</dt>
                <dd class="fig">8‒20 m</dd>
              </div>
              <div>
                <dt>Suprafață</dt>
                <dd class="fig">64‒300 m²</dd>
              </div>
              <div>
                <dt>Capacitate</dt>
                <dd class="fig">40‒320</dd>
              </div>
              <div>
                <dt>Montaj</dt>
                <dd>La tine acasă</dd>
              </div>
              <div>
                <dt>Zonă</dt>
                <dd>
                  {site.county}, {site.region}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    {/* ===================== PANEL 01: the exploded view ===================== */}
    <Plate no="01" name="Alcătuire" scale="Axonometrie 1:100" labelledby="p1">
      <div class="intro">
        <h2 id="p1" class="h-section">
          Ce vine odată cu cortul
        </h2>
        <p>
          Venim cu structura, o ridicăm pe terenul tău și o pregătim complet. Lăsăm un spațiu gata de folosit, potrivit
          oricărei ocazii, și revenim după eveniment ca să demontăm.
        </p>
      </div>

      <div class="draw">
        <ExplodedPlate />
        {/* This list is the drawing's key: the numbers here are the numbers on the plate beside it. */}
        <ol class="parts">
          {KEY.map((k) => (
            <li class="reveal">
              <span class="dot" aria-hidden="true">
                {k.n}
              </span>
              <div>
                <h3 class="h-title">{k.title}</h3>
                <p>{k.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </Plate>

    {/* ===================== PANEL 02: the sequence =====================
        The numbers carry information here: the order is the content. */}
    <Plate no="02" name="Execuție" scale="Succesiunea lucrărilor" labelledby="p2">
      <div class="intro">
        <h2 id="p2" class="h-section">
          Cum funcționează
        </h2>
        <p>Patru etape, de la prima discuție până la demontare. De logistică ne ocupăm noi, cap-coadă.</p>
      </div>

      <ol class="steps">
        {steps.map((s) => (
          <li class="reveal step">
            <div class="step__head">
              <span class="step__no" aria-hidden="true">
                {s.n}
              </span>
              <h3 class="h-title">{s.title}</h3>
            </div>
            <p>{s.description}</p>
          </li>
        ))}
      </ol>
    </Plate>
  </main>

  <Footer />
</Base>

<style>
  /* ---- the hero ------------------------------------------------------- */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 32px;
  }
  .hero-copy .lede {
    margin-top: 20px;
  }
  .hero-copy .link-btn {
    margin-top: 24px;
  }
  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .hero-plate {
    display: contents;
  }
  .tb {
    width: 100%;
  }
  .tb dl {
    display: grid;
    grid-template-columns: repeat(5, auto);
    margin: 0;
  }
  .tb dl > div {
    min-width: 0;
    padding: 14px 16px;
    border-left: 1px solid var(--color-hair);
  }
  .tb dl > div:first-child {
    border-left: 0;
  }
  .tb dd {
    white-space: nowrap;
  }
  .tb dd.fig {
    font-size: var(--text-figure);
  }

  /* ---- the key beside the drawing --------------------------------------- */
  .draw {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 32px;
    margin-top: 32px;
    align-items: start;
  }
  .parts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .parts li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--color-hair);
  }
  .parts li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .parts p {
    margin-top: 4px;
    color: var(--color-ink-2);
  }

  /* ---- the sequence ----------------------------------------------------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-hair);
  }
  .step {
    padding: 24px 24px 8px 0;
  }
  .step + .step {
    padding-left: 24px;
    border-left: 1px solid var(--color-hair);
  }
  .step__head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .step__no {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.33;
    color: var(--color-signal);
  }
  .step p {
    margin-top: 12px;
    color: var(--color-ink-2);
  }

  @media (max-width: 1099px) {
    .tb dl {
      grid-template-columns: repeat(6, 1fr);
    }
    .tb dl > div {
      grid-column: span 2;
    }
    .tb dl > div:nth-child(n + 4) {
      grid-column: span 3;
      border-top: 1px solid var(--color-hair);
    }
    .tb dl > div:nth-child(4) {
      border-left: 0;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
    .step:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .step:nth-child(n + 3) {
      border-top: 1px solid var(--color-hair);
    }
  }

  @media (max-width: 800px) {
    .hero-copy {
      padding: 20px 16px;
    }
    .hero-copy .lede {
      margin-top: 14px;
    }
    .hero-copy .link-btn {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: 18px;
    }
    .hero-right {
      display: block;
      background: var(--color-paper);
      border: 1px solid var(--color-edge);
      border-top: 1.5px solid var(--color-ink);
    }
    /* The drawing sits on its own gridded plate at the head of the spec card. */
    .hero-plate {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
      background-color: var(--color-field);
      background-image:
        linear-gradient(var(--color-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
      background-size: 32px 32px;
      background-position: -1px -1px;
      border-bottom: 1px solid var(--color-hair);
    }
    .tb {
      border: 0;
      background: transparent;
    }
    .tb dl {
      display: flex;
      flex-direction: column;
    }
    .tb dl > div,
    .tb dl > div:nth-child(n + 4) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 48px;
      padding: 0 16px;
      border-left: 0;
      border-top: 1px solid var(--color-hair);
    }
    /* The place leads the list, so it is on the first screen. */
    .tb dl > div:last-child {
      order: -1;
      border-top: 0;
    }
    .tb dd {
      margin: 0;
      text-align: right;
    }
    .draw {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 24px;
    }
    .parts li {
      padding: 16px 0;
    }
    .steps {
      grid-template-columns: 1fr;
      margin-top: 24px;
    }
    .step,
    .step + .step {
      padding: 20px 0 8px;
      border-left: 0;
    }
    .step + .step {
      border-top: 1px solid var(--color-hair);
    }
  }
</style>
