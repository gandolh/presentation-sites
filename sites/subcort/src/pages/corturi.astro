---
import Base from "../layouts/Base.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Plate from "../components/Plate.astro";
import Footer from "../components/Footer.astro";
import TentScale from "../components/TentScale.tsx";
import { site } from "../content/site";
import { tents, amenities } from "../content/tents";

const included = amenities.filter((a) => a.kind === "inclus");
const optional = amenities.filter((a) => a.kind === "optional");

// "8 × 8 m" → { w, d } so the plan can draw a true footprint and the table can
// scale its dimension bars against the largest format.
const parsed = tents.map((t) => {
  const [w, d] = t.size.split("×").map((n) => parseInt(n.trim(), 10));
  return { ...t, w, d, areaNum: parseInt(t.area, 10) };
});
const maxArea = Math.max(...parsed.map((p) => p.areaNum));

// "90‒110 persoane": the range in the figure face, the unit as text.
const seatedParts = (v: string) => {
  const at = v.indexOf(" ");
  return at < 0 ? { range: "", rest: v } : { range: v.slice(0, at), rest: v.slice(at) };
};

const formats = parsed.map((p) => ({
  w: p.w,
  d: p.d,
  label: `${p.w} × ${p.d} m`,
  area: p.areaNum,
  seated: p.seated,
  standing: p.standing,
  note: p.note,
}));
---

<Base
  path="/corturi/"
  title={`Corturi & capacități · ${site.name}`}
  description="Dimensiuni de corturi de la 8×8 la 15×20 m, cu capacități între 40 și 320 de invitați. Pardoseală, iluminat și pereți incluse; încălzire, răcire și mobilier opționale."
>
  <DemoBanner />
  <Nav current="/corturi/" />

  <main id="main">
    <PageHeader
      no="Planșa 01"
      name="Corturi"
      scale="Scara 1:100"
      title="Dimensiuni și capacități"
      lead="Patru formate care acoperă de la o reuniune restrânsă în curte până la un eveniment cu peste trei sute de invitați. Capacitatea depinde de aranjarea meselor, pe care o stabilim împreună."
    />

    {/* The plan: the one instrument on the site. A table of square metres does
        not answer "how big is that on my ground?": a footprint drawn to scale
        against a parked car does. */}
    <Plate no="01.1" name="Plan" scale="Caroiaj 1 m" labelledby="c1">
      <h2 id="c1" class="h-section plan-title">
        Cât ocupă, de fapt, pe teren
      </h2>
      <TentScale client:visible formats={formats} initial={1} />
    </Plate>

    <Plate no="01.2" name="Tabel" scale="Formate & capacități" labelledby="c2">
      <h2 id="c2" class="h-section">
        Toate patru, alături
      </h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col">Format</th>
              <th scope="col">Suprafață</th>
              <th scope="col">Cu mese</th>
              <th scope="col">În picioare</th>
              <th scope="col" class="bar">
                Scară relativă
              </th>
            </tr>
          </thead>
          <tbody>
            {parsed.map((t) => (
              <tr>
                <th scope="row">{t.size}</th>
                <td class="ar" data-l="Suprafață">
                  {t.area}
                </td>
                <td data-l="Cu mese">
                  <span class="rg">{seatedParts(t.seated).range}</span>
                  {seatedParts(t.seated).rest}
                </td>
                <td data-l="În picioare">{t.standing}</td>
                <td class="bar">
                  {/* A dimension bar, not a progress bar: a rule with tick
                      terminators, sized to the footprint. */}
                  <span class="dimbar" style={`--f:${(t.areaNum / maxArea) * 100}%`} aria-hidden="true">
                    <i></i>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="prose">
        Capacitățile sunt orientative și se schimbă în funcție de plan: mese rotunde, mese lungi, bufet sau scaune în
        rânduri. Pentru un teren cu formă neregulată, găsim împreună varianta care se potrivește.
      </p>

      <ul class="notes">
        {parsed.map((t) => (
          <li>
            <b>{t.size}</b>
            <span>{t.note}</span>
          </li>
        ))}
      </ul>
    </Plate>

    <Plate no="01.3" name="Dotări" scale="Incluse & opționale" labelledby="c3">
      <h2 id="c3" class="h-section">
        Dotări
      </h2>
      <p class="lede amenities-lede">
        Ce vine odată cu cortul și ce se adaugă în funcție de sezon și de cum vrei spațiul.
      </p>

      <div class="ams">
        <div class="amcol">
          <p class="ch">Incluse</p>
          <ul>
            {included.map((a, i) => (
              <li class="reveal am">
                <span class="dot" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3 class="h-title">{a.title}</h3>
                  <p>{a.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="amcol">
          <p class="ch opt">Opționale</p>
          <ul>
            {optional.map((a, i) => (
              <li class="reveal am">
                <span class="dot" aria-hidden="true">
                  {i + included.length + 1}
                </span>
                <div>
                  <h3 class="h-title">{a.title}</h3>
                  <p>{a.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Plate>
  </main>

  <Footer />
</Base>

<style>
  .plan-title {
    max-width: 20ch;
  }

  /* ---- the table: four formats side by side ----------------------------- */
  .tbl-wrap {
    margin-top: 32px;
  }
  .tbl {
    width: 100%;
    border-collapse: collapse;
  }
  .tbl th[scope="col"] {
    padding: 12px 20px 12px 16px;
    background: var(--color-fill-2);
    border-bottom: 1.5px solid var(--color-ink);
    text-align: left;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: var(--text-label--font-weight);
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .tbl td,
  .tbl th[scope="row"] {
    padding: 16px 20px 16.5px 16px;
    border-bottom: 1px solid var(--color-hair);
    text-align: left;
    vertical-align: middle;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .tbl th[scope="row"] {
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .tbl td.ar {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-ink);
  }
  .tbl .bar {
    width: 30%;
  }

  /* A dimension bar: extension ticks at each end, the measured run between. */
  .dimbar {
    display: block;
    position: relative;
    height: 14px;
  }
  .dimbar::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1px dashed var(--color-line-soft);
  }
  .dimbar i {
    position: absolute;
    left: 0;
    top: 50%;
    width: var(--f);
    border-top: 1.5px solid var(--color-signal);
  }
  .dimbar i::before,
  .dimbar i::after {
    content: "";
    position: absolute;
    top: -5px;
    height: 11px;
    border-left: 1.5px solid var(--color-signal);
  }
  .dimbar i::before {
    left: 0;
  }
  .dimbar i::after {
    right: 0;
  }

  .prose {
    max-width: 68ch;
    margin-top: 24px;
    color: var(--color-ink-2);
  }
  .notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 40px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .notes li {
    display: flex;
    gap: 16px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .notes b {
    flex: 0 0 88px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-ink);
  }

  /* ---- the amenities: two columns, the optional band on signal-soft ---- */
  .amenities-lede {
    max-width: 60ch;
    margin-top: 16px;
  }
  .ams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 32px;
  }
  .amcol {
    border: 1px solid var(--color-edge);
    border-top: 1.5px solid var(--color-ink);
  }
  .amcol .ch {
    display: flex;
    align-items: center;
    min-height: 48px;
    margin: 0;
    padding: 8px 24px;
    background: var(--color-fill-2);
    border-bottom: 1px solid var(--color-hair);
    font-weight: 600;
  }
  .amcol .ch.opt {
    background: var(--color-signal-soft);
    border-bottom-color: var(--color-signal-soft);
    color: var(--color-on-signal-soft);
  }
  .amcol ul {
    margin: 0;
    padding: 8px 24px;
    list-style: none;
  }
  .am {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--color-hair);
  }
  .am:first-child {
    border-top: 0;
  }
  .am p {
    margin-top: 4px;
    color: var(--color-ink-2);
  }

  @media (max-width: 800px) {
    .ams {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .amcol .ch {
      padding: 8px 16px;
    }
    .amcol ul {
      padding: 4px 16px;
    }
    .notes {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .notes li {
      flex-direction: column;
      gap: 4px;
      padding: 16px 0;
      border-top: 1px solid var(--color-hair);
    }
    .notes li:first-child {
      padding-top: 0;
      border-top: 0;
    }
    .notes b {
      flex: none;
    }

    /* The table folds per format: the size, then its figures in pairs, then the bar. */
    .tbl-wrap {
      margin-top: 20px;
    }
    .tbl thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .tbl,
    .tbl tbody,
    .tbl tr,
    .tbl td,
    .tbl th {
      display: block;
    }
    .tbl tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--color-hair);
    }
    .tbl tr:first-child {
      padding-top: 0;
    }
    .tbl td,
    .tbl th[scope="row"] {
      padding: 0;
      border: 0;
    }
    .tbl th[scope="row"] {
      grid-column: 1 / -1;
    }
    .tbl td[data-l]::before {
      content: attr(data-l);
      display: block;
      font-size: var(--text-label);
      line-height: var(--text-label--line-height);
      font-weight: var(--text-label--font-weight);
      color: var(--color-ink-2);
      font-family: var(--font-sans);
    }
    .tbl td.bar {
      grid-column: 1 / -1;
      width: auto;
      padding-top: 8px;
    }
  }
</style>
