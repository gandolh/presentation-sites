---
import Base from "../layouts/Base.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Plate from "../components/Plate.astro";
import Footer from "../components/Footer.astro";
import { site, telLink } from "../content/site";
---

<Base
  path="/contact/"
  title={`Contact · ${site.name}`}
  description={`Date de contact Subcort: telefon, email și program, în ${site.city}, ${site.county}.`}
>
  <DemoBanner />
  <Nav current="/contact/" />

  <main id="main">
    {/* Display only. No form, no booking widget, no call button, by design:
        the site informs and steps back. */}
    <PageHeader
      no="Planșa 04"
      name="Contact"
      scale="Date de identificare"
      title="Unde ne găsești"
      lead="Spune-ne data, locul și numărul de invitați, iar noi te ajutăm cu spațiul. Mai jos sunt datele noastre, ne poți scrie sau suna când îți convine."
    >
      <div class="card data-card">
        <div class="band">
          <span class="band__no">04.1</span>
          <span class="band__name">Date</span>
          <span class="band__scale">Contact direct</span>
        </div>
        <dl class="rows">
          <div class="crow">
            <dt>Telefon</dt>
            <dd>
              <a href={telLink()} class="big fig">
                {site.phone}
              </a>
            </dd>
          </div>
          <div class="crow">
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${site.email}`} class="big">
                {site.email}
              </a>
            </dd>
          </div>
          <div class="crow">
            <dt>Adresă</dt>
            <dd class="big">
              {site.address}, {site.city}, jud. {site.county}
            </dd>
          </div>
        </dl>
      </div>
    </PageHeader>

    <Plate no="04.2" name="Program" labelledby="hours" tight>
      <h2 id="hours" class="sr-only">
        Program
      </h2>
      <div class="hrs">
        <ul>
          {site.hours.map((h) => (
            <li>
              <span>{h.day}</span>
              <b>{h.value}</b>
            </li>
          ))}
        </ul>
        <p>Pentru montaje în zone mai îndepărtate din {site.region}, stabilim programul în funcție de distanță.</p>
      </div>
    </Plate>
  </main>

  <Footer />
</Base>

<style>
  .data-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .rows {
    margin: 0;
    padding: 0 32px 8px;
  }
  .crow {
    padding: 16px 0;
    border-top: 1px solid var(--color-hair);
  }
  .crow:first-child {
    border-top: 0;
  }
  .big {
    display: inline-block;
    margin-top: 4px;
    font-size: 1.5rem;
    line-height: 1.33;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  a.big {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--color-line-soft);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  a.big:hover {
    color: var(--color-signal-hover);
    text-decoration-color: var(--color-signal-hover);
  }
  .big.fig {
    font-size: 1.5rem;
  }

  .hrs {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 32px;
    align-items: start;
  }
  .hrs ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hrs li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--color-hair);
  }
  .hrs li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .hrs li span {
    color: var(--color-ink-2);
  }
  .hrs li b {
    font-family: var(--font-mono);
    font-weight: 600;
    text-align: right;
  }
  .hrs p {
    font-size: var(--text-lede);
    line-height: var(--text-lede--line-height);
    color: var(--color-ink-2);
  }

  @media (max-width: 800px) {
    .rows {
      padding: 0 16px 4px;
    }
    .big,
    .big.fig {
      font-size: 1.25rem;
      line-height: 1.4;
    }
    .hrs {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .hrs li {
      flex-wrap: wrap;
    }
    .hrs li:last-child b {
      flex-basis: 100%;
      margin-top: 2px;
      text-align: start;
    }
  }
</style>
