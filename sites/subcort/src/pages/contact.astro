---
import Base from "../layouts/Base.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Plate from "../components/Plate.astro";
import Footer from "../components/Footer.astro";
import { site, telLink } from "../content/site";
---

<Base
  path="/contact/"
  title={`Contact · ${site.name}`}
  description={`Date de contact Subcort: telefon, email și program, în ${site.city}, ${site.county}.`}
>
  <DemoBanner />
  <Nav current="/contact/" />

  <main id="main">
    <PageHeader
      plate="04 · Contact"
      scale="Date de identificare"
      title="Unde ne găsești"
      lead="Spune-ne data, locul și numărul de invitați, iar noi te ajutăm cu spațiul. Mai jos sunt datele noastre — ne poți scrie sau suna când îți convine."
    />

    {/* Display only. No form, no booking widget, no call button — by design;
        the site informs and steps back. */}
    <Plate no="04.1 · Date" note="Contact direct" tight>
      <div class="contact-grid">
        <dl class="contact-list">
          <div class="contact-row">
            <dt class="datum-key">Telefon</dt>
            <dd><a href={telLink()} class="contact-big link-quiet dim">{site.phone}</a></dd>
          </div>
          <div class="contact-row">
            <dt class="datum-key">Email</dt>
            <dd><a href={`mailto:${site.email}`} class="contact-big link-quiet">{site.email}</a></dd>
          </div>
          <div class="contact-row">
            <dt class="datum-key">Adresă</dt>
            <dd class="contact-big">{site.address}, {site.city}, jud. {site.county}</dd>
          </div>
        </dl>

        <aside class="hours">
          <h2 class="heading-md">Program</h2>
          <dl class="mt-4">
            {site.hours.map((h) => (
              <div class="hours__row">
                <dt class="text-[0.9rem] text-[var(--color-ink-2)]">{h.day}</dt>
                <dd class="text-[0.9rem] font-semibold text-right dim">{h.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-5 text-[0.87rem] leading-relaxed text-[var(--color-ink-2)]">
            Pentru montaje în zone mai îndepărtate din {site.region}, stabilim
            programul în funcție de distanță.
          </p>
        </aside>
      </div>
    </Plate>
  </main>

  <Footer />
</Base>

<style>
  .contact-grid { display: grid; gap: 2.5rem; margin-top: 0.5rem; }
  @media (min-width: 860px) { .contact-grid { grid-template-columns: 1.35fr 1fr; gap: 4rem; align-items: start; } }

  .contact-row { padding: 1.25rem 0; border-top: 1px solid var(--color-hair); }
  .contact-row:first-child { border-top: 1.5px solid var(--color-ink); }
  .contact-row:last-child { border-bottom: 1px solid var(--color-hair); }
  .contact-big {
    display: inline-block;
    margin-top: 0.45rem;
    font-size: clamp(1.12rem, 2vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .hours { background: var(--color-fill-2); border: 1px solid var(--color-hair); padding: 1.5rem; }
  .hours__row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--color-hair);
  }
  .hours__row:last-child { border-bottom: 0; }
</style>
