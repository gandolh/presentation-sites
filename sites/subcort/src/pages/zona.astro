---
import Base from "../layouts/Base.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Plate from "../components/Plate.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { steps, coverage } from "../content/zone";
---

<Base
  path="/zona/"
  title={`Zonă acoperită & montaj · ${site.name}`}
  description={`Acoperim ${coverage.primary} și ne deplasăm în toată ${coverage.region}. Livrăm, montăm la fața locului și demontăm după eveniment.`}
>
  <DemoBanner />
  <Nav current="/zona/" />

  <main id="main">
    <PageHeader
      plate="03 · Zonă"
      scale="Acoperire"
      title={`Acoperim ${coverage.primary} și ${coverage.region}`}
      lead="Aducem cortul la adresa ta, îl montăm complet și revenim să-l demontăm după eveniment. De partea logistică te scutim cu totul."
    />

    {/* The sequence. The numbers earn their place: the order is the content. */}
    <Plate no="03.1 · Proces" note="Succesiunea lucrărilor" title="De la prima discuție la demontare" tight>
      <ol class="process">
        {steps.map((s) => (
          <li class="reveal process__step">
            <span class="process__no dim" aria-hidden="true">{s.n}</span>
            <div>
              <h3 class="heading-md">{s.title}</h3>
              <p class="mt-2 prose-measure leading-relaxed text-[var(--color-ink-2)]">{s.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </Plate>

    <Plate no="03.2 · Acoperire" note="Localități" title={`Județul ${coverage.primary}, plus toată ${coverage.region}`}>
      <p class="lede mt-5">{coverage.note}</p>

      <ul class="localities">
        {coverage.localities.map((loc) => (
          <li class="locality"><span class="locality__tick" aria-hidden="true"></span>{loc}</li>
        ))}
      </ul>

      <p class="mt-7 prose-measure text-[0.92rem] leading-relaxed text-[var(--color-ink-2)]">
        Lista de mai sus e orientativă — ne deplasăm și în afara ei, în toată {site.region}.
      </p>
    </Plate>
  </main>

  <Footer />
</Base>

<style>
  .process { margin-top: 2.25rem; }
  .process__step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-hair);
  }
  .process__step:first-child { border-top: 1.5px solid var(--color-ink); }
  .process__step:last-child { border-bottom: 1px solid var(--color-hair); }
  @media (min-width: 700px) { .process__step { grid-template-columns: 5rem 1fr; gap: 0 2.5rem; } }
  .process__no { font-size: 0.95rem; font-weight: 500; color: var(--color-signal); letter-spacing: 0.06em; }

  .localities {
    margin-top: 2rem;
    display: grid;
    gap: 0.8rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
  }
  .locality { display: flex; align-items: center; gap: 0.7rem; font-size: 0.97rem; }
  /* a survey mark, not a bullet */
  .locality__tick {
    width: 9px; height: 9px; flex: 0 0 auto;
    border: 1.5px solid var(--color-signal);
    transform: rotate(45deg);
  }
</style>
