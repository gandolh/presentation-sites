---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { withBase } from "@sites/kit";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description = `${title} · ${site.name}`, updated = site.legal.documentsUpdated } = Astro.props;
---

<Base title={`${title} · ${site.name}`} description={description}>
  <header class="nav">
    <div class="sheet nav__inner">
      <a href={withBase("/")} class="nav__word">
        SUBCORT
      </a>
      <a href={withBase("/")} class="link-btn">
        ← Înapoi la site
      </a>
    </div>
  </header>

  <main id="main">
    <section class="panel legal-panel" aria-labelledby="legal-title">
      <div class="band">
        <span class="band__scale">Ultima actualizare: {updated}</span>
      </div>
      <div class="panel__body">
        <h1 id="legal-title" class="h-section">
          {title}
        </h1>
        <article class="legal-prose">
          <slot />
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style is:global>
  .legal-panel {
    max-width: 56rem;
    margin-top: 32px;
  }
  .legal-prose {
    max-width: 70ch;
    margin-top: 24px;
    color: var(--color-ink-2);
    line-height: 1.72;
    font-size: var(--text-body);
  }
  .legal-prose h2 {
    margin-top: 40px;
    margin-bottom: 12px;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 650;
    color: var(--color-ink);
  }
  .legal-prose h3 {
    margin-top: 28px;
    margin-bottom: 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal-prose p {
    margin-bottom: 1rem;
  }
  .legal-prose ul,
  .legal-prose ol {
    margin: 0 0 1.15rem 1.15rem;
    display: grid;
    gap: 0.45rem;
  }
  .legal-prose ul {
    list-style: square;
  }
  .legal-prose ol {
    list-style: decimal;
  }
  .legal-prose li::marker {
    color: var(--color-signal);
  }
  .legal-prose strong {
    color: var(--color-ink);
    font-weight: 700;
  }
  .legal-prose a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line-soft);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition:
      color 160ms ease-out,
      text-decoration-color 160ms ease-out;
  }
  .legal-prose a:hover {
    color: var(--color-signal-hover);
    text-decoration-color: currentColor;
  }
  .legal-prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.94rem;
  }
  .legal-prose th,
  .legal-prose td {
    text-align: left;
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: 1px solid var(--color-hair);
    vertical-align: top;
  }
  .legal-prose th {
    color: var(--color-ink);
    font-weight: 700;
    border-bottom-color: var(--color-ink);
  }
  @media (max-width: 800px) {
    .legal-panel {
      margin-top: 12px;
    }
  }
</style>
