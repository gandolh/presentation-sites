---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { withBase } from "@sites/kit";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const {
  title,
  description = `${title} · ${site.name}`,
  updated = site.legal.documentsUpdated,
} = Astro.props;
---

<Base title={`${title} · ${site.name}`} description={description}>
  <header class="border-b border-[var(--color-hair)]">
    <div class="sheet flex items-center justify-between gap-4 py-5">
      <a href={withBase("/")} class="text-[1.2rem] font-bold tracking-[-0.005em]">SUBCORT</a>
      <a href={withBase("/")} class="btn-outline !py-2 !px-3.5 !text-[0.86rem]">
        ← Înapoi la site
      </a>
    </div>
  </header>

  <main id="main" class="sheet max-w-3xl py-12 md:py-20">
    <h1 class="heading-lg">{title}</h1>
    <p class="mt-4 text-sm text-[var(--color-ink-2)] dim">
      Ultima actualizare: {updated}
    </p>

    <article class="legal-prose mt-10">
      <slot />
    </article>
  </main>

  <Footer />
</Base>

<style is:global>
  .legal-prose {
    color: var(--color-ink-2);
    line-height: 1.72;
    font-size: 1rem;
    max-width: 70ch;
  }
  .legal-prose h2 {
    font-weight: 800;
    font-size: clamp(1.2rem, 2.6vw, 1.45rem);
    letter-spacing: -0.026em;
    color: var(--color-ink);
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
  }
  .legal-prose h3 {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose p { margin-bottom: 1rem; }
  .legal-prose ul,
  .legal-prose ol {
    margin: 0 0 1.15rem 1.15rem;
    display: grid;
    gap: 0.45rem;
  }
  .legal-prose ul { list-style: square; }
  .legal-prose ol { list-style: decimal; }
  .legal-prose li::marker { color: var(--color-signal); }
  .legal-prose strong { color: var(--color-ink); font-weight: 700; }
  .legal-prose a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line-soft);
    transition: color 160ms ease-out, text-decoration-color 160ms ease-out;
  }
  .legal-prose a:hover {
    color: var(--color-signal);
    text-decoration-color: currentColor;
  }
  .legal-prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.94rem;
  }
  .legal-prose th,
  .legal-prose td {
    text-align: left;
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: 1px solid var(--color-hair);
    vertical-align: top;
  }
  .legal-prose th {
    color: var(--color-ink);
    font-weight: 700;
    border-bottom-color: var(--color-ink);
  }
</style>
