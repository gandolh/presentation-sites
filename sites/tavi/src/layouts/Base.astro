---
// Newsreader with its optical-size axis (roman and italic) and IBM Plex Mono for figures, self-hosted through
// Fontsource: the site makes no third-party request.
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import { absoluteUrl, pagePath, withBase } from "@sites/kit";

interface Props {
  title?: string;
  description?: string;
  // Root-relative path of this page. Builds the canonical; defaults to the page being rendered.
  path?: string;
}

const name = "Tavi Ceasornicaru";
const {
  title = name,
  description = "A wristwatch movement you can wind, slow down and take apart, drawn for Tavi, who loves clocks and watches and repairs wristwatches.",
  path = pagePath(Astro.url.pathname),
} = Astro.props;

// Absolute on the configured `site` origin: scrapers need full URLs.
const canonical = absoluteUrl(path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fdfbf7" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Before the first paint: scripting is on, and the drawings play unless the visitor asked for less motion. -->
    <script is:inline>
      {
        const root = document.documentElement;
        root.classList.add("js");
        root.dataset.playing = matchMedia("(prefers-reduced-motion: reduce)").matches ? "false" : "true";
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
