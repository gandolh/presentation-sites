---
import type { Pose } from "../../lib/figure.ts";

// One step of a chapter's prose. It carries the pose its figure takes while the step holds the reading line; the
// first step is active before anything scrolls. A step may end on a hint (the `hint` slot) that points at a control
// in the figure's tray; without scripting the tray shows no control, so the hint is hidden too.
interface Props {
  /** The step's number in its chapter; the figure's `data-step` while it is active. */
  n: number;
  pose: Pose;
}

const { n, pose } = Astro.props;
---

<div class:list={["step", { "is-active": n === 1 }]} data-step={n} data-explode={pose.e}>
  <p>
    <slot />
  </p>
  {Astro.slots.has("hint") && (
    <span class="try no-js:hidden">
      <svg viewBox="0 0 28 14" aria-hidden="true">
        <path class="track" d="M2 7h24" />
        <path class="moved" d="M2 7h13" />
        <circle class="thumb" cx="15" cy="7" r="5" />
      </svg>
      <span>
        <slot name="hint" />
      </span>
    </span>
  )}
</div>
