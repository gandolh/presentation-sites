---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Contents from "../components/Contents.astro";
import Footer from "../components/Footer.astro";

// One long page: the hero, the contents band, then the chapters in order; chapter 7 is the footer. Each chapter's head
// is here; the chapter briefs add its steps and its figure, and may reword the head.
const chapters = [
  { id: "energy", head: "1. Energy, wound into a spring" },
  { id: "wheels", head: "2. Wheels, hours into seconds" },
  { id: "escapement", head: "3. Escapement, let out tooth by tooth" },
  { id: "balance", head: "4. Balance, six swings a second" },
  { id: "together", head: "5. Together, apart and back again" },
  { id: "bench", head: "6. The bench, Tavi’s tools" },
];
---

<Base>
  <Header />
  <main id="top">
    <Hero />
    <Contents />

    {chapters.map((chapter) => (
      <section class="chapter" id={chapter.id} aria-labelledby={`${chapter.id}-head`}>
        <div class="wrap">
          <div class="chapter-head">
            <h2 id={`${chapter.id}-head`}>{chapter.head}</h2>
          </div>
        </div>
      </section>
    ))}
  </main>

  <Footer />
</Base>
