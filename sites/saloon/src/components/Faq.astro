---
import { Icon } from "astro-icon/components";
import { faq } from "../content/faq";
import { waLink } from "../content/site";

// FAQPage structured data: helps the FAQ surface as rich results in search.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section id="intrebari" class="section band">
  <div class="container-page">
    <h2 class="reveal heading-lg">Întrebări frecvente</h2>

    {/*
      One raised card with ruled rows. The "still stuck?" prompt sits beside it,
      so the whitespace next to a readable measure does a job.
    */}
    <div class="faq">
      <div class="card faq__list reveal">
        {faq.map((item) => (
          <details class="faq__item group">
            <summary>
              <span>{item.q}</span>
              <Icon name="ph:plus" size={20} class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>

      <aside class="card faq__help reveal" style="--i: 2">
        <p class="faq__help-title">Nu ai găsit răspunsul?</p>
        <p class="label-md muted">Scrie-mi pe WhatsApp și îți răspund cât pot de repede.</p>
        <a
          href={waLink("Bună, Ana! Am o întrebare despre serviciile tale.")}
          target="_blank"
          rel="noopener"
          class="link"
        >
          Întreabă-mă
          <Icon name="ph:arrow-right" size={18} aria-hidden="true" />
        </a>
      </aside>
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 3.5rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  .faq__list {
    overflow: hidden;
  }

  .faq__item + .faq__item {
    border-top: 1px solid var(--color-outline-variant);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item :global(.faq__icon) {
    flex: none;
    color: var(--color-primary);
    transition: transform 300ms;
  }

  .faq__item[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }

  .faq__item p {
    max-width: 62ch;
    padding: 0 1.5rem 1.25rem;
    color: var(--color-on-surface-variant);
  }

  .faq__help {
    padding: 1.5rem;
    background-color: var(--color-blush);
    border-radius: var(--radius-lg);
  }

  .faq__help-title {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30;
    font-weight: 500;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
  }

  .faq__help p + p {
    margin-top: 0.5rem;
  }

  .faq__help .link {
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 760px) {
    .faq__item summary {
      padding-inline: 1.25rem;
    }

    .faq__item p {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item :global(.faq__icon) {
      transition: none;
    }
  }
</style>
