---
import { Icon } from "astro-icon/components";
import { faq } from "../content/faq";
import { waLink } from "../content/site";

// FAQPage structured data — helps the FAQ surface as rich results in search.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section id="intrebari" class="section">
  <div class="container-page">
    <h2 class="reveal heading-lg">Întrebări frecvente</h2>

    {/*
      The accordion is capped at a readable measure, which used to leave the
      right third of the container as an orphaned void. The "still stuck?"
      prompt lives there instead, so the whitespace is doing a job.
    */}
    <div
      class="mt-8 md:mt-12 grid gap-x-16 gap-y-8 md:grid-cols-[minmax(0,1fr)_minmax(0,17rem)] md:items-start"
    >
      <div class="space-y-3">
      {
        faq.map((item, i) => (
          <details
            class="reveal group card !p-0 overflow-hidden"
            style={`--i: ${i}`}
          >
            <summary
              class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5 font-medium text-[var(--color-on-surface)]"
            >
              <span>{item.q}</span>
              <Icon
                name="ph:plus"
                size={20}
                class="flex-shrink-0 transition-transform duration-300 group-open:rotate-45 text-[var(--color-gold)]"
                aria-hidden="true"
              />
            </summary>
            <p class="px-6 pb-5 -mt-1 text-[var(--color-on-surface-variant)] leading-relaxed">
              {item.a}
            </p>
          </details>
        ))
      }
      </div>

      <aside
        class="reveal md:sticky md:top-28 rounded-[1rem] bg-[var(--color-surface-container)] px-6 py-6"
        style="--i: 2"
      >
        <p class="font-display text-xl leading-snug text-[var(--color-on-surface)]">
          Nu ai găsit răspunsul?
        </p>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-on-surface-variant)]">
          Scrie-mi pe WhatsApp și îți răspund cât pot de repede.
        </p>
        <a
          href={waLink(
            "Bună, Ana! Am o întrebare despre serviciile tale.",
          )}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center min-h-[44px] label-md uppercase text-[var(--color-on-surface)] underline underline-offset-4 decoration-[var(--color-outline-variant)] hover:decoration-[var(--color-blush-deep)] hover:text-[var(--color-blush-deep)] transition-colors"
        >
          Întreabă-mă →
        </a>
      </aside>
    </div>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />
</section>
