---
import MobileMenu from "./MobileMenu.tsx";

const links = [
  { href: "#despre", label: "Despre" },
  { href: "#servicii", label: "Servicii" },
  { href: "#galerie", label: "Galerie" },
  { href: "#intrebari", label: "Întrebări" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container-page site-header__bar">
    <a href="#acasa" class="wordmark site-header__mark">
      Unghii by Ana
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="#programari" class="btn btn-pill site-header__pill">
      Programează-te
    </a>
    <MobileMenu client:load />
  </div>
</header>

<style>
  /* Sticky and always opaque: the ground, with a hairline under it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-index-header);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4.25rem;
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    justify-self: start;
    font-size: 1.75rem;
    line-height: 2rem;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .site-header__nav ul {
    display: flex;
    gap: 0.5rem;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-full);
    font-weight: 500;
    color: var(--color-on-surface-variant);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-on-surface);
  }

  .site-header__pill {
    justify-self: end;
  }

  @media (max-width: 900px) {
    .site-header__bar {
      grid-template-columns: 1fr auto auto;
      gap: 0.75rem;
      height: 4rem;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__mark {
      font-size: 1.5rem;
      line-height: 1.875rem;
    }
  }

  @media (max-width: 760px) {
    .site-header__bar {
      grid-template-columns: 1fr auto;
      gap: 0;
    }

    .site-header__pill {
      display: none;
    }
  }
</style>
