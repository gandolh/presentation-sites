---
// Hygiene & sterilisation — a strong trust signal in the RO market.
//
// Presented as a numbered sequence rather than three icon cards: this is a
// protocol Ana follows in order, and the previous layout repeated Services'
// exact circular-icon-badge grid, so the two sections read as the same
// template twice. Numerals carry the "there is a procedure here" meaning that
// a shield or a bin icon only gestures at.
const points = [
  {
    title: "Sterilizare în autoclav",
    body: "Instrumentarul metalic este sterilizat în autoclav după fiecare clientă, standardul medical pentru eliminarea completă a microorganismelor.",
  },
  {
    title: "Consumabile de unică folosință",
    body: "Pilele, buffer-ele și alte consumabile care nu se pot steriliza sunt de unică folosință, proaspete pentru fiecare programare.",
  },
  {
    title: "Dezinfecție & suprafețe curate",
    body: "Masa de lucru, lampa și suprafețele sunt dezinfectate între cliente, iar mâinile igienizate riguros înainte de fiecare serviciu.",
  },
];
---

<section id="igiena" class="section">
  <div class="container-page">
    <div class="hygiene">
      <div class="reveal">
        <h2 class="heading-lg">Curățenie fără compromisuri</h2>
        <p class="hygiene__lead muted">
          Sănătatea ta contează la fel de mult ca aspectul unghiilor. Iată cum am grijă de igienă la fiecare programare.
        </p>
      </div>

      <ol class="card hygiene__list reveal">
        {points.map((p, i) => (
          <li>
            <span class="hygiene__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="heading-md">{p.title}</h3>
              <p class="hygiene__body">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .hygiene {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }

  .hygiene__lead {
    margin-top: 1rem;
  }

  .hygiene__list {
    padding: 0.5rem 2.5rem;
  }

  .hygiene__list li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
  }

  .hygiene__list li + li {
    border-top: 1px solid var(--color-outline-variant);
  }

  .hygiene__num {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    color: var(--color-gold-ink);
  }

  .hygiene__body {
    max-width: 60ch;
    margin-top: 0.5rem;
    color: var(--color-on-surface-variant);
  }

  @media (max-width: 900px) {
    .hygiene {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 760px) {
    .hygiene__list {
      padding: 0.25rem 1.25rem;
    }

    .hygiene__list li {
      grid-template-columns: 2rem 1fr;
      gap: 0.75rem;
      padding: 1.25rem 0;
    }
  }
</style>
