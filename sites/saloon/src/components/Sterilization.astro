---
// Hygiene & sterilisation — a strong trust signal in the RO market.
//
// Presented as a numbered sequence rather than three icon cards: this is a
// protocol Ana follows in order, and the previous layout repeated Services'
// exact circular-icon-badge grid, so the two sections read as the same
// template twice. Numerals carry the "there is a procedure here" meaning that
// a shield or a bin icon only gestures at.
const points = [
  {
    title: "Sterilizare în autoclav",
    body: "Instrumentarul metalic este sterilizat în autoclav după fiecare clientă, standardul medical pentru eliminarea completă a microorganismelor.",
  },
  {
    title: "Consumabile de unică folosință",
    body: "Pilele, buffer-ele și alte consumabile care nu se pot steriliza sunt de unică folosință, proaspete pentru fiecare programare.",
  },
  {
    title: "Dezinfecție & suprafețe curate",
    body: "Masa de lucru, lampa și suprafețele sunt dezinfectate între cliente, iar mâinile igienizate riguros înainte de fiecare serviciu.",
  },
];
---

<section
  id="igiena"
  class="section bg-[var(--color-surface-container-low)]"
>
  <div class="container-page">
    <div class="grid gap-x-16 gap-y-10 md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
      <div class="reveal md:sticky md:top-28 md:self-start">
        <h2 class="heading-lg">Curățenie fără compromisuri</h2>
        <p class="mt-5 text-[var(--color-on-surface-variant)] leading-relaxed">
          Sănătatea ta contează la fel de mult ca aspectul unghiilor. Iată cum
          am grijă de igienă la fiecare programare.
        </p>
      </div>

      <ol class="space-y-10 md:space-y-12">
        {
          points.map((p, i) => (
            <li class="reveal flex gap-5 md:gap-7" style={`--i: ${i}`}>
              <span
                class="font-display shrink-0 text-2xl leading-none pt-1 text-[var(--color-gold-ink)] tabular-nums"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="heading-md">{p.title}</h3>
                <p class="mt-3 max-w-prose text-[var(--color-on-surface-variant)] leading-relaxed">
                  {p.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
