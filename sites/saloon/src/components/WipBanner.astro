// in the flow above the sticky header and scrolls away with the page.
// Romanian only.
---

<div class="notice">
  <p class="label-md">Site în lucru. Pentru programări, scrie-mi oricând pe WhatsApp.</p>
</div>

<style>
  .notice {
    min-height: 2.25rem;
    padding: 0.5rem 1.25rem;
    background-color: var(--color-secondary-container);
    color: var(--color-on-secondary-container);
    border-bottom: 1px solid var(--color-gold);
    text-align: center;
  }

  .notice p {
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .notice {
      padding: 0.375rem 1rem;
    }
  }
</style>
