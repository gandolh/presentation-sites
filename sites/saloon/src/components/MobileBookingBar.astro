---
import { Icon } from "astro-icon/components";
import { site, waLink } from "../content/site";
---

{/*
  The phone's docked booking bar: the WhatsApp pill and a round call button,
  from the first paint. The audience books almost entirely from phones, and the
  header's booking pill is hidden there, so this is the one-tap path to the
  success action at every scroll position.

  No-JS / crawler default: visible (it is core functionality, never gated on
  JS). The inline script only *refines* when to hide it: while the full-screen
  menu is open, and while the Programează-te or Unde mă găsești button is on
  screen (where a full WhatsApp button already sits, so the bar would double
  it). Over the footer it stays, since the footer's WhatsApp link is a small
  social icon.
*/}
<div id="mobile-booking-bar" data-state="shown">
  <div class="mbb__inner">
    <a
      href={waLink()}
      target="_blank"
      rel="noopener"
      class="btn btn-whatsapp mbb__cta"
      aria-label={`Scrie-mi pe WhatsApp la ${site.phone}`}
    >
      <Icon name="ph:whatsapp-logo" size={22} aria-hidden="true" />
      <span>Scrie-mi pe WhatsApp</span>
    </a>
    <a href={`tel:+${site.phoneE164}`} class="mbb__call" aria-label="Sună-mă">
      <Icon name="ph:phone" size={24} aria-hidden="true" />
    </a>
  </div>
</div>

<style>
  #mobile-booking-bar {
    display: none;
  }

  @media (max-width: 760px) {
    #mobile-booking-bar {
      display: block;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: var(--z-index-dock);
      min-height: 4.5rem;
      padding: 0.625rem 1.25rem;
      /* Clear the home indicator / rounded corners on notched phones. */
      padding-bottom: max(0.625rem, env(safe-area-inset-bottom));
      background-color: var(--color-surface-container-lowest);
      border-top: 1px solid var(--color-outline-variant);
      box-shadow: var(--shadow-card);
    }
  }

  @media (max-width: 380px) {
    #mobile-booking-bar {
      padding-inline: 1rem;
    }
  }

  .mbb__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 30rem;
    margin-inline: auto;
  }

  .mbb__cta {
    flex: 1;
    min-width: 0;
    padding-inline: 1rem;
  }

  .mbb__call {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-outline);
    background-color: var(--color-surface-container-lowest);
    color: var(--color-on-surface);
    text-decoration: none;
  }

  /* JS-refined behaviour: once the script adds .js-fab, the bar can slide out
     of view. Without JS this rule never applies, so the bar stays visible. */
  :global(.js-fab) #mobile-booking-bar {
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 320ms ease-out;
  }

  :global(.js-fab) #mobile-booking-bar[data-state="hidden"] {
    transform: translateY(120%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js-fab) #mobile-booking-bar {
      transition: opacity 200ms ease-out;
    }

    :global(.js-fab) #mobile-booking-bar[data-state="hidden"] {
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const bar = document.getElementById("mobile-booking-bar");
    if (!bar) return;

    // Opt into the JS-refined hide behaviour. Until this runs, CSS keeps the
    // bar visible (no-JS / crawler safe), and it is never hidden at first paint.
    document.documentElement.classList.add("js-fab");

    // The buttons that make the bar redundant: the Programează-te card and the
    // Unde mă găsești WhatsApp button.
    const buttons = Array.prototype.slice.call(document.querySelectorAll("[data-booking-cta]"));

    let buttonOnScreen = false;
    let menuOpen = false;

    function apply() {
      bar.dataset.state = menuOpen || buttonOnScreen ? "hidden" : "shown";
    }

    if ("IntersectionObserver" in window && buttons.length) {
      const visible = new Set();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) visible.add(e.target);
            else visible.delete(e.target);
          });
          buttonOnScreen = visible.size > 0;
          apply();
        },
        { threshold: 0 },
      );
      buttons.forEach((el) => io.observe(el));
    }

    // Hide while the full-screen mobile menu is open. The menu locks body
    // scroll via overflow:hidden, so watch that as the signal.
    const mo = new MutationObserver(() => {
      const open = document.body.style.overflow === "hidden";
      if (open !== menuOpen) {
        menuOpen = open;
        apply();
      }
    });
    mo.observe(document.body, { attributes: true, attributeFilter: ["style"] });
  })();
</script>
