---
import { Icon } from "astro-icon/components";
---

<section id="loialitate" class="section">
  <div class="container-page">
    <div class="card loyalty reveal">
      <div class="loyalty__grid">
        <div>
          <h2 class="heading-lg">Cu cât vii mai des, cu atât te răsfeți mai mult.</h2>
          <span class="gold-divider"></span>
        </div>

        <div>
          <div class="perk">
            <span class="perk__coin perk__coin--figure" aria-hidden="true">
              5
            </span>
            <p>
              La fiecare <strong>a 5-a programare</strong>, primești
              <strong>20% reducere</strong> la serviciul ales. Ne ținem evidența, tu te bucuri de unghii frumoase.
            </p>
          </div>

          <div class="perk">
            <span class="perk__coin" aria-hidden="true">
              <Icon name="ph:users-three" size={20} aria-hidden="true" />
            </span>
            <p>
              <strong>Recomandă o prietenă</strong> și primiți amândouă
              <strong>10% reducere</strong> la următoarea vizită.
            </p>
          </div>

          <div class="perk">
            <span class="perk__coin" aria-hidden="true">
              <Icon name="ph:gift" size={20} aria-hidden="true" />
            </span>
            <p>
              <strong>Voucher cadou</strong>: surprinde pe cineva drag cu un card cadou pentru serviciile mele. Scrie-mi
              pe WhatsApp și îl pregătesc.
            </p>
          </div>

          <div class="loyalty__cta">
            <a href="#programari" class="btn btn-primary">
              Programează-te acum
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .loyalty {
    padding: 4rem;
    background-color: var(--color-blush);
  }

  .loyalty__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .loyalty h2 {
    font-size: 2.5rem;
    line-height: 2.875rem;
    color: var(--color-on-primary-container);
  }

  .perk {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .perk + .perk {
    margin-top: 1.25rem;
  }

  .perk__coin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant);
    color: var(--color-on-primary-container);
  }

  .perk__coin--figure {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .loyalty__cta {
    margin-top: 1.75rem;
  }

  @media (max-width: 900px) {
    .loyalty__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 760px) {
    .loyalty {
      padding: 1.75rem 1.25rem;
    }

    .loyalty h2 {
      font-size: 1.75rem;
      line-height: 2.125rem;
    }
  }
</style>
