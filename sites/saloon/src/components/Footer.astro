---
import { Icon } from "astro-icon/components";
import { site, waLink } from "../content/site";
import { withBase } from "@sites/kit";

const year = new Date().getFullYear();
const links = [
  { href: "/#acasa", label: "Acasă" },
  { href: "/#servicii", label: "Servicii" },
  { href: "/#galerie", label: "Galerie" },
  { href: "/#contact", label: "Contact" },
];
const legalLinks = [
  { href: "/confidentialitate/", label: "Politică de confidențialitate" },
  { href: "/termeni/", label: "Termeni și condiții" },
  { href: "/cookie-uri/", label: "Politică de cookie-uri" },
];
---

<footer class="footer on-inverse">
  <div class="container-page">
    <div class="footer__grid">
      <div>
        <span class="wordmark footer__mark">Unghii by Ana</span>
        <p class="label-md footer__blurb">{site.description}</p>
      </div>

      <nav aria-label="Navigare">
        <h3 class="footer__head">Navigare</h3>
        {links.map((link) => (
          <a href={withBase(link.href)} class="footer__link">
            {link.label}
          </a>
        ))}
      </nav>

      <nav aria-label="Legal">
        <h3 class="footer__head">Legal</h3>
        {legalLinks.map((link) => (
          <a href={withBase(link.href)} class="footer__link">
            {link.label}
          </a>
        ))}
      </nav>

      <div>
        <h3 class="footer__head">Contact</h3>
        <a href={`tel:+${site.phoneE164}`} class="footer__link num">
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="footer__link">
          {site.email}
        </a>
        <p class="label-md footer__address">
          {site.address}, {site.city}
        </p>

        <div class="footer__social">
          <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">
            <Icon name="ph:instagram-logo" size={20} aria-hidden="true" />
          </a>
          <a href={site.social.facebook} aria-label="Facebook" target="_blank" rel="noopener">
            <Icon name="ph:facebook-logo" size={20} aria-hidden="true" />
          </a>
          <a href={waLink()} aria-label="WhatsApp" target="_blank" rel="noopener">
            <Icon name="ph:whatsapp-logo" size={20} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>

    <!-- Business identification (Legea 365/2002 art. 5) + ANPC SAL -->
    <div class="footer__legal label-md">
      <ul>
        <li>{site.legal.legalName}</li>
        <li>CUI: {site.legal.cui}</li>
        <li>Reg. Com.: {site.legal.regNumber}</li>
        {site.legal.form === "SRL" && site.legal.shareCapital && <li>Capital social: {site.legal.shareCapital}</li>}
        <li>
          {site.address}, {site.city}, jud. {site.county}
        </li>
      </ul>
      <div class="footer__row">
        <p>
          © {year} {site.name}. Toate drepturile rezervate.
        </p>
        <a
          href="https://reclamatiisal.anpc.ro/"
          target="_blank"
          rel="noopener"
          aria-label="ANPC: Soluționarea Alternativă a Litigiilor"
          class="footer__anpc"
        >
          <b>ANPC</b>
          <span>Soluționarea Alternativă a Litigiilor (SAL)</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-inverse-surface);
    color: var(--color-inverse-on-surface);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr 1.2fr;
    gap: 3rem;
    padding: 4rem 0 3rem;
  }

  .footer__mark {
    display: inline-block;
    font-size: 1.875rem;
    line-height: 2rem;
  }

  .footer__blurb {
    max-width: 28ch;
    margin-top: 0.75rem;
    font-weight: 400;
    color: var(--color-inverse-on-surface-variant);
  }

  .footer__head {
    margin-bottom: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    color: var(--color-inverse-on-surface-variant);
  }

  .footer__link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    color: var(--color-inverse-on-surface);
    text-decoration: none;
  }

  .footer__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .footer__address {
    margin-top: 0.25rem;
    font-weight: 400;
  }

  .footer__social {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--color-inverse-on-surface);
  }

  .footer__social a:hover {
    background-color: var(--color-inverse-wash);
  }

  .footer__legal {
    padding: 1.5rem 0 1.75rem;
    border-top: 1px solid var(--color-inverse-line);
    font-weight: 400;
    color: var(--color-inverse-on-surface-variant);
  }

  .footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .footer__anpc {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--color-inverse-on-surface);
    text-decoration: none;
  }

  .footer__anpc b {
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-inverse-wash);
    font-weight: 600;
  }

  @media (max-width: 1040px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 3rem 0 2rem;
    }

    .footer__mark {
      font-size: 1.75rem;
    }

    /* The docked booking bar is fixed over the bottom of the page: keep the
       legal block clear of it. */
    .footer__legal {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
