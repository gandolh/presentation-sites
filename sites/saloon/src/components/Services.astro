---
import { Icon } from "astro-icon/components";
import { services } from "../content/services";
import { waLink } from "../content/site";
---

{/*
  A salon menu, not a feature grid: a raised card with a blush head band and
  ruled rows, the price right beside its name, the way a printed salon menu
  reads. It sits in the hero beside the photograph, so /#servicii lands on it.
*/}
<section id="servicii" class="card menu" aria-labelledby="h-servicii">
  <header class="menu__head">
    <h2 class="heading-lg" id="h-servicii">
      Servicii & prețuri
    </h2>
    <p class="label-md muted">Prețuri orientative. Pentru o ofertă personalizată, scrie-mi pe WhatsApp.</p>
  </header>

  <ul class="menu__rows">
    {services.map((s) => (
      <li class="menu__row">
        <div class="menu__top">
          <h3 class="heading-md">{s.title}</h3>
          <b class="menu__price">
            {s.price.split(" / ").map((part, i) => (
              <>
                {i > 0 && " "}
                <span>{i > 0 ? `/ ${part}` : part}</span>
              </>
            ))}
          </b>
        </div>
        <div class="menu__mid">
          <p class="menu__sub">{s.subtitle}</p>
          <a
            href={waLink(`Bună, Ana! Aș dori o programare pentru ${s.title}. Când ai un loc liber?`)}
            target="_blank"
            rel="noopener"
            class="link"
            aria-label={`Programează, ${s.title}`}
          >
            Programează
            <Icon name="ph:arrow-right" size={18} aria-hidden="true" />
          </a>
        </div>
        <p class="menu__desc">{s.description}</p>
      </li>
    ))}
  </ul>

  <p class="label-md muted menu__foot">
    Nu găsești ce cauți?{" "}
    <span class="menu__nowrap">
      <a
        href={waLink("Bună, Ana! Aș vrea să întreb despre un serviciu care nu e în listă.")}
        target="_blank"
        rel="noopener"
      >
        Întreabă-mă pe WhatsApp
      </a>
      .
    </span>
  </p>
</section>

<style>
  .menu {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .menu__head {
    padding: 0.875rem 1.5rem 0.75rem;
    background-color: var(--color-blush);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .menu__head p {
    margin-top: 0.125rem;
    font-weight: 400;
  }

  .menu__rows {
    padding-inline: 1.5rem;
  }

  .menu__row {
    padding: 0.625rem 0 0.75rem;
  }

  .menu__row + .menu__row {
    border-top: 1px solid var(--color-outline-variant);
  }

  .menu__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
  }

  .menu__top h3 {
    flex: none;
    white-space: nowrap;
  }

  /* The price never clips: "/ unghie" wraps to a second line before it does. */
  .menu__price {
    margin-left: auto;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    color: var(--color-gold-ink);
    text-align: right;
  }

  .menu__price span {
    white-space: nowrap;
  }

  .menu__mid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.25rem;
  }

  .menu__sub {
    min-width: 0;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    color: var(--color-secondary);
  }

  .menu__row .link {
    margin-block: -0.75rem;
  }

  .menu__desc {
    margin-top: 0.125rem;
    color: var(--color-on-surface-variant);
  }

  .menu__foot {
    padding: 0.5rem 1.5rem 0.375rem;
    border-top: 1px solid var(--color-outline-variant);
    font-weight: 400;
  }

  .menu__foot a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-on-surface);
    text-decoration-color: var(--color-gold-ink);
    text-underline-offset: 3px;
  }

  .menu__nowrap {
    white-space: nowrap;
  }

  @media (min-width: 901px) {
    .menu__row {
      padding: 0.75rem 0 0.875rem;
    }

    .menu__desc {
      margin-top: 0.25rem;
    }
  }

  @media (max-width: 760px) {
    .menu__head {
      padding: 0.75rem 1.25rem 0.625rem;
    }

    .menu__rows {
      padding-inline: 1.25rem;
    }

    .menu__row {
      padding: 0.5rem 0 0.625rem;
    }

    .menu__foot {
      padding-inline: 1.25rem;
    }
  }

  @media (max-width: 380px) {
    .menu__head,
    .menu__foot {
      padding-inline: 1rem;
    }

    .menu__rows {
      padding-inline: 1rem;
    }
  }
</style>
