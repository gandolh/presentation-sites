---
import { Icon } from "astro-icon/components";
import { hoursTable, site, waLink } from "../content/site";
---

<section id="contact" class="section section--tight band">
  <div class="container-page">
    <h2 class="reveal heading-lg">Unde mă găsești</h2>

    <div class="contact">
      <div class="card info reveal">
        <dl>
          <div>
            <dt class="label-md">Telefon și WhatsApp</dt>
            <dd>
              <a class="big num" href={`tel:+${site.phoneE164}`}>
                {site.phone}
              </a>
            </dd>
          </div>

          <div>
            <dt class="label-md">Zonă</dt>
            <dd>
              <span class="big">
                {site.city}, {site.county}
              </span>
              <p class="label-md info__note">Îți comunic adresa exactă pe WhatsApp când stabilim programarea.</p>
            </dd>
          </div>

          <div>
            <dt class="label-md">Email</dt>
            <dd>
              <a class="big" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="reveal">
        <div class="card info">
          <dl>
            <div>
              <dt class="label-md">Program</dt>
              <dd>
                <ul class="hours">
                  {hoursTable.map((h) => (
                    <li>
                      <span class="muted">{h.day}</span>
                      <b>{h.value}</b>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          </dl>
        </div>

        <p class="contact__lead muted">
          Cel mai simplu mod de a-ți face o programare este pe WhatsApp: îmi scrii ce serviciu te interesează și
          stabilim împreună ziua și ora.
        </p>
        <div class="contact__btns">
          <a href={waLink()} target="_blank" rel="noopener" class="btn btn-whatsapp" data-booking-cta>
            <Icon name="ph:whatsapp-logo" size={22} aria-hidden="true" />
            Scrie-mi pe WhatsApp
          </a>
          <a href={`tel:+${site.phoneE164}`} class="btn btn-line">
            <Icon name="ph:phone" size={20} aria-hidden="true" />
            Sună-mă
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
    margin-top: 2rem;
  }

  .info {
    padding: 2rem;
  }

  .info dl > div + div {
    margin-top: 1.5rem;
  }

  .info dt {
    color: var(--color-on-surface-variant);
  }

  .info dd {
    margin-top: 0.25rem;
  }

  .big {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30;
    font-size: 1.25rem;
    line-height: 1.75rem;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  a.big:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .info__note {
    max-width: 30ch;
    margin-top: 0.25rem;
    font-weight: 400;
    color: var(--color-on-surface-variant);
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .hours li + li {
    border-top: 1px solid var(--color-outline-variant);
  }

  .hours b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .contact__lead {
    margin-top: 1.5rem;
  }

  .contact__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 760px) {
    .info {
      padding: 1.5rem 1.25rem;
    }

    .contact__btns {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
