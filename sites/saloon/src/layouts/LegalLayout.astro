---
import Base from "./Base.astro";
import { Icon } from "astro-icon/components";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { withBase } from "@sites/kit";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description = `${title} · ${site.name}`, updated = site.legal.documentsUpdated } = Astro.props;
---

<Base title={`${title} · ${site.name}`} description={description}>
  <header class="legal-header">
    <div class="container-page legal-header__bar">
      <a href={withBase("/")} class="wordmark legal-header__mark">
        Unghii by Ana
      </a>
      <a href={withBase("/")} class="legal-header__back">
        <Icon name="ph:arrow-left" size={18} aria-hidden="true" />
        Înapoi la site
      </a>
    </div>
  </header>

  <main class="container-page legal-main">
    <h1 class="heading-lg">{title}</h1>
    <span class="gold-divider"></span>
    <p class="label-md legal-updated">Ultima actualizare: {updated}</p>

    <article class="card legal-prose">
      <slot />
    </article>
  </main>

  <Footer />
</Base>

<style>
  .legal-header {
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .legal-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .legal-header__mark {
    font-size: 1.5rem;
    line-height: 1.875rem;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .legal-header__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-on-surface-variant);
    text-decoration: none;
  }

  .legal-header__back:hover {
    color: var(--color-on-surface);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .legal-main {
    max-width: 52rem;
    padding-block: 3rem 5rem;
  }

  .legal-updated {
    font-weight: 400;
    color: var(--color-on-surface-variant);
  }

  .legal-prose {
    margin-top: 2rem;
    padding: 1rem 2.5rem 2rem;
  }

  @media (max-width: 760px) {
    .legal-main {
      padding-block: 2rem 3rem;
    }

    .legal-prose {
      padding: 0.5rem 1.25rem 1.5rem;
    }
  }
</style>

<style is:global>
  .legal-prose {
    color: var(--color-on-surface-variant);
    line-height: 1.7;
  }
  .legal-prose h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    color: var(--color-on-surface);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  .legal-prose h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-on-surface);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose p {
    margin-bottom: 1rem;
  }
  .legal-prose ul,
  .legal-prose ol {
    margin: 0.5rem 0 1.25rem;
    padding-left: 1.5rem;
    list-style: disc;
  }
  .legal-prose ol {
    list-style: decimal;
  }
  .legal-prose li {
    margin-bottom: 0.5rem;
  }
  .legal-prose a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose a:hover {
    color: var(--color-on-surface);
  }
  .legal-prose strong {
    color: var(--color-on-surface);
    font-weight: 600;
  }
  .legal-prose hr {
    border: none;
    border-top: 1px solid var(--color-outline-variant);
    margin: 2rem 0;
  }
  .legal-prose .note {
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .legal-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.95rem;
  }
  .legal-prose th,
  .legal-prose td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-outline-variant);
    vertical-align: top;
  }
  .legal-prose th {
    color: var(--color-on-surface);
    font-weight: 600;
    font-family: var(--font-body);
  }
</style>
