---
import Document from "../../layouts/Document.astro";
import { site } from "../../content/site";
import { withBase } from "@sites/kit";
import type { Style } from "../../content/styles";
import { meta } from "./meta";

import "@fontsource-variable/eb-garamond/wght.css";
import "./theme.css";

interface Props {
  style: Style;
  title: string;
  description?: string;
  postSlug?: string;
}

const { style, title, description, postSlug } = Astro.props;

// The wordmark is this page's <h1> on a feed; on a post the article
// title takes that role and the wordmark steps down to a <p>.
const MarkTag = postSlug ? "p" : "h1";
---

<Document
  slug={style.slug}
  title={title}
  description={description}
  postSlug={postSlug}
  themeColor={meta.themeColor}
  scheme={meta.scheme}
>
  <div class="ds-page">
    <div class="bo-wrap">
      <header class="bo-head">
        <MarkTag class="bo-head__mark"><a href={withBase("/bohemian/")}>{site.name}</a></MarkTag>
        <p class="bo-head__rule">{style.name}</p>
        <p class="bo-head__links"><a href={withBase("/")}>return to the index</a></p>
      </header>

      <main>
        <slot />
      </main>

      <footer class="bo-foot">
        <p>Made slowly, and by hand. {site.name} &mdash; {style.era}.</p>
      </footer>
    </div>
  </div>
</Document>
