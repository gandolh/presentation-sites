---
import Document from "../../layouts/Document.astro";
import { site } from "../../content/site";
import { withBase } from "@sites/kit";
import type { Style } from "../../content/styles";
import { meta } from "./meta";

import "@fontsource-variable/inter/wght.css";
import "./theme.css";

interface Props {
  style: Style;
  title: string;
  description?: string;
  postSlug?: string;
}

const { style, title, description, postSlug } = Astro.props;

// The wordmark is this page's <h1> on a feed; on a post the article
// title takes that role and the wordmark steps down to a <p>.
const MarkTag = postSlug ? "p" : "h1";
---

<Document
  slug={style.slug}
  title={title}
  description={description}
  postSlug={postSlug}
  themeColor={meta.themeColor}
  scheme={meta.scheme}
>
  <div class="ds-page">
    <header class="min-head">
      <MarkTag class="min-head__mark"><a href={withBase("/minimalism/")}>{site.name}</a></MarkTag>
      <p class="min-head__style">{style.name}</p>
    </header>

    <main class="min-wrap">
      <slot />
    </main>

    <footer class="min-foot">
      <a href={withBase("/")}>Index</a>
    </footer>
  </div>
</Document>
