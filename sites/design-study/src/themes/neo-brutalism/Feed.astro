---
import { withBase } from "@sites/kit";
import { POSTS_PER_PAGE, type Post } from "../../content/posts";
import PostCarousel from "../../components/PostCarousel.astro";
import Pager from "../../components/Pager.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
});
---

<ol class="nb-feed" data-ds-feed data-per-page={POSTS_PER_PAGE}>
  {
    posts.map((post) => (
      <li class="ds-feed__item">
        <div class="nb-card__figure">
          <PostCarousel post={post} />
        </div>
        <h2 class="nb-card__title">
          <a href={withBase(`/neo-brutalism/${post.slug}/`)}>{post.title}</a>
        </h2>
        <p class="nb-card__dek">{post.dek}</p>
        <p class="nb-card__meta">
          {dateFormat.format(new Date(post.date))} / {post.author} / {post.images.length} pics
        </p>
      </li>
    ))
  }
</ol>

<Pager />
