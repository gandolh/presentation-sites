---
import type { Post } from "../../content/posts";
import PostCarousel from "../../components/PostCarousel.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class="nb-article">
  <div class="nb-article__figure">
    <PostCarousel post={post} />
  </div>

  <header class="nb-article__head nb-block">
    <p class="nb-badge">{post.tags.join(" + ")}</p>
    <h1 class="nb-article__title">{post.title}</h1>
    <p class="nb-article__dek">{post.dek}</p>
    <p class="nb-article__meta">
      {post.author} &mdash;{" "}
      <time datetime={post.date}>{dateFormat.format(new Date(post.date))}</time>
    </p>
  </header>

  <div class="nb-article__body nb-block">
    {
      post.body.map((block) => {
        switch (block.type) {
          case "h2":
            return <h2>{block.text}</h2>;
          case "quote":
            return (
              <blockquote>
                <p>{block.text}</p>
                {block.cite && <footer>{block.cite}</footer>}
              </blockquote>
            );
          case "list":
            return (
              <ul>
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            );
          case "aside":
            return <p class="nb-aside">{block.text}</p>;
          default:
            return <p>{block.text}</p>;
        }
      })
    }
  </div>
</article>
