---
import Document from "../../layouts/Document.astro";
import { site } from "../../content/site";
import { withBase } from "@sites/kit";
import type { Style } from "../../content/styles";
import { meta } from "./meta";

import "@fontsource-variable/open-sans/wght.css";
import "./theme.css";

interface Props {
  style: Style;
  title: string;
  description?: string;
  postSlug?: string;
}

const { style, title, description, postSlug } = Astro.props;

// The wordmark is this page's <h1> on a feed; on a post the article
// title takes that role and the wordmark steps down to a <p>.
const MarkTag = postSlug ? "p" : "h1";
---

<Document
  slug={style.slug}
  title={title}
  description={description}
  postSlug={postSlug}
  themeColor={meta.themeColor}
  scheme={meta.scheme}
>
  <div class="ds-page">
    <div class="sk-wrap">
      <header class="sk-head">
        <MarkTag class="sk-head__mark"><a href={withBase("/skeuomorphism/")}>{site.name}</a></MarkTag>
        <p class="sk-head__style">{style.name} &middot; {style.era}</p>
        <p class="sk-head__links"><a class="sk-btn" href={withBase("/")}>All Styles</a></p>
      </header>

      <main>
        <slot />
      </main>

      <footer class="sk-foot sk-raised">
        <p>{site.name} &mdash; every surface lit from the top left, without exception.</p>
      </footer>
    </div>
  </div>
</Document>
