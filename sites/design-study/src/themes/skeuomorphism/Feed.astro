---
import { withBase } from "@sites/kit";
import { POSTS_PER_PAGE, type Post } from "../../content/posts";
import PostCarousel from "../../components/PostCarousel.astro";
import Pager from "../../components/Pager.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<ol class="sk-feed" data-ds-feed data-per-page={POSTS_PER_PAGE}>
  {
    posts.map((post) => (
      <li class="ds-feed__item sk-raised">
        <div class="sk-card__figure">
          <PostCarousel post={post} />
        </div>
        <h2 class="sk-card__title">
          <a href={withBase(`/skeuomorphism/${post.slug}/`)}>{post.title}</a>
        </h2>
        <p class="sk-card__dek">{post.dek}</p>
        <p class="sk-card__meta">
          {post.author} &middot; {dateFormat.format(new Date(post.date))}
        </p>
      </li>
    ))
  }
</ol>

<Pager />
