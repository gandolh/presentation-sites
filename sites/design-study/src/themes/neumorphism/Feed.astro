---
import { withBase } from "@sites/kit";
import { POSTS_PER_PAGE, type Post } from "../../content/posts";
import PostCarousel from "../../components/PostCarousel.astro";
import Pager from "../../components/Pager.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  month: "short",
  year: "numeric",
});
---

<ol class="nu-feed" data-ds-feed data-per-page={POSTS_PER_PAGE}>
  {
    posts.map((post) => (
      <li class="ds-feed__item">
        <div class="nu-card__figure">
          <PostCarousel post={post} />
        </div>
        <h2 class="nu-card__title">
          <a href={withBase(`/neumorphism/${post.slug}/`)}>{post.title}</a>
        </h2>
        <p class="nu-card__dek">{post.dek}</p>
        <p class="nu-card__meta">{dateFormat.format(new Date(post.date))}</p>
      </li>
    ))
  }
</ol>

<Pager />
