---
// A single post, rendered in neumorphism.
import type { Post } from "../../content/posts";
import Shell from "../../themes/neumorphism/Shell.astro";
import PostView from "../../themes/neumorphism/Post.astro";
import { postPaths, postPage } from "../../lib/routes";

export const getStaticPaths = postPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { style, title, description } = postPage("neumorphism", post);
---

<Shell style={style} title={title} description={description} postSlug={post.slug}>
  <PostView post={post} />
</Shell>
