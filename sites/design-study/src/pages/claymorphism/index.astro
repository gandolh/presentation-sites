---
// The claymorphism feed. One theme imported statically — see src/lib/routes.ts for
// why these 28 route files are deliberately repetitive.
import Shell from "../../themes/claymorphism/Shell.astro";
import Feed from "../../themes/claymorphism/Feed.astro";
import { feedPage } from "../../lib/routes";

const { style, posts, title, description } = feedPage("claymorphism");
---

<Shell style={style} title={title} description={description}>
  <Feed posts={posts} />
</Shell>
