---
// The swiss feed. One theme imported statically — see src/lib/routes.ts for
// why these 28 route files are deliberately repetitive.
import Shell from "../../themes/swiss/Shell.astro";
import Feed from "../../themes/swiss/Feed.astro";
import { feedPage } from "../../lib/routes";

const { style, posts, title, description } = feedPage("swiss");
---

<Shell style={style} title={title} description={description}>
  <Feed posts={posts} />
</Shell>
