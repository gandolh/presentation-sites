---
// The gallery. Neutral by design — it wears the same dark system chrome as the
// switcher, so nothing here competes with the fourteen specimens it indexes.
import { withBase } from "@sites/kit";
import { styles } from "../content/styles";
import { posts } from "../content/posts";
import { site } from "../content/site";
import { allThemeMeta } from "../themes/registry";
import "../styles/base.css";

const metas = await allThemeMeta();
const swatchFor = (slug: string) =>
  metas.find((m) => m.slug === slug)?.swatch ?? {
    bg: "#2c2c2e",
    fg: "#f2f2f7",
    accent: "#8e8e93",
  };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141416" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{site.studyName} — one blog, fourteen design languages</title>
    <meta name="description" content={site.studyDescription} />
    <meta name="robots" content="noindex, follow" />
  </head>

  <body class="gallery">
    <header class="gallery__head">
      <p class="gallery__eyebrow">A UI/UX study</p>
      <h1 class="gallery__title">{site.studyName}</h1>
      <p class="gallery__lede">
        One blog — {posts.length} posts, the same words, the same photographs — rendered
        in {styles.length} design languages. The content is the control variable. Everything
        you see change is the design.
      </p>
      <p class="gallery__hint">
        Inside any style, press <kbd>&#8592;</kbd> <kbd>&#8594;</kbd> to step between
        them and <kbd>G</kbd> for the full list. Your position is kept, so you can
        compare the same post across all {styles.length}.
      </p>
    </header>

    <ol class="gallery__grid">
      {
        styles.map((style, i) => {
          const swatch = swatchFor(style.slug);
          return (
            <li>
              <a class="card" href={withBase(`/${style.slug}/`)}>
                <span
                  class="card__swatch"
                  style={`--bg:${swatch.bg};--fg:${swatch.fg};--accent:${swatch.accent}`}
                  aria-hidden="true"
                >
                  <i class="card__swatch-rule" />
                  <i class="card__swatch-mark" />
                </span>
                <span class="card__no">{String(i + 1).padStart(2, "0")}</span>
                <span class="card__name">{style.name}</span>
                <span class="card__era">{style.era}</span>
                <span class="card__blurb">{style.blurb}</span>
              </a>
            </li>
          );
        })
      }
    </ol>

    <footer class="gallery__foot">
      <p>
        {site.name} is fictional. The written analysis of each style lives in this
        site's <code>docs/styles/</code>.
      </p>
    </footer>

    <style>
      .gallery {
        margin: 0;
        padding: 0 clamp(1.25rem, 5vw, 4rem) 5rem;
        background: #141416;
        color: #f2f2f7;
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        line-height: 1.5;
      }

      .gallery__head {
        max-inline-size: 46rem;
        padding-block: clamp(3rem, 10vw, 6rem) 3rem;
      }

      .gallery__eyebrow {
        margin: 0 0 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #8e8e93;
      }

      .gallery__title {
        margin: 0 0 1.25rem;
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.035em;
      }

      .gallery__lede {
        margin: 0 0 1.25rem;
        font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
        color: #d1d1d6;
        text-wrap: pretty;
      }

      .gallery__hint {
        margin: 0;
        font-size: 0.875rem;
        color: #8e8e93;
      }

      kbd {
        font: inherit;
        border: 1px solid #48484a;
        border-radius: 4px;
        padding: 0 0.35em;
      }

      .gallery__grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: 1px;
        background: #2c2c2e;
        border: 1px solid #2c2c2e;
      }

      .card {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto auto;
        column-gap: 1rem;
        row-gap: 0.25rem;
        padding: 1.25rem;
        background: #1c1c1e;
        color: inherit;
        text-decoration: none;
        block-size: 100%;
      }

      .card:hover,
      .card:focus-visible {
        background: #2c2c2e;
      }

      /* A flat three-value reduction of the style, not a live preview — the
         index must not start looking like the thing it indexes. */
      .card__swatch {
        grid-row: 1 / span 3;
        inline-size: 3.25rem;
        block-size: 4rem;
        background: var(--bg);
        position: relative;
        overflow: hidden;
        border: 1px solid #3a3a3c;
      }

      .card__swatch-rule {
        position: absolute;
        inset-inline: 18%;
        inset-block-start: 26%;
        block-size: 3px;
        background: var(--fg);
      }

      .card__swatch-mark {
        position: absolute;
        inset-inline-start: 18%;
        inset-block-end: 20%;
        inline-size: 1.25rem;
        block-size: 1.25rem;
        background: var(--accent);
      }

      .card__no {
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        color: #8e8e93;
      }

      .card__name {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .card__era {
        font-size: 0.75rem;
        color: #8e8e93;
      }

      .card__blurb {
        grid-column: 2;
        margin-block-start: 0.5rem;
        font-size: 0.8125rem;
        line-height: 1.45;
        color: #aeaeb2;
      }

      .gallery__foot {
        padding-block-start: 2.5rem;
        font-size: 0.8125rem;
        color: #8e8e93;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: #d1d1d6;
      }
    </style>
  </body>
</html>
