---
// Self-hosted fonts (no Google Fonts CDN: GDPR, it avoids transmitting visitor
// IPs to Google; see docs/LEGAL.md). Encode Sans is imported on its `wdth` axis
// file, which carries wght too: the wordmark is set at width 125. The file
// bundles the latin and latin-ext subsets (latin-ext carries ă â î ș ț) as
// separate @font-face blocks gated by unicode-range.
import "@fontsource-variable/encode-sans/wdth.css";
import "../styles/global.css";
import { openingHoursSpecification, site } from "../content/site";
import { absoluteUrl, pagePath, withBase } from "@sites/kit";

interface Props {
  title?: string;
  description?: string;
  // Root-relative path of this page (e.g. "/servicii/"). Used to build the
  // per-page canonical + og:url. Defaults to the page being rendered.
  path?: string;
}

const {
  title = `${site.name} · Service BMW în ${site.city}`,
  description = site.description,
  path = pagePath(Astro.url.pathname),
} = Astro.props;

// Absolute on the configured `site` origin: scrapers and X need full URLs.
const canonical = absoluteUrl(path);

// Social platforms refuse SVG for og:image, so the card ships as a PNG built
// from scripts/og-card.html with the site's real self-hosted faces. The SVG
// beside it is the vector source, not the shared asset.
const ogImage = absoluteUrl("/images/og-image.png");

// The hours come from the single source in site.ts (`openingHoursSpecification`
// is derived there, with the table and the readouts) — nothing is retyped here.
const openingHours = openingHoursSpecification;

// The same hours for the open-now script, as plain days and times.
const openDays = site.hours.flatMap((h) => (h.closed ? [] : [{ days: h.days, opens: h.opens, closes: h.closes }]));
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161310" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted via @fontsource (imported in the frontmatter) -->

    <!-- JSON-LD: LocalBusiness / AutoRepair -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "AutoRepair",
        name: site.name,
        description: site.description,
        image: ogImage,
        url: absoluteUrl("/"),
        telephone: `+${site.phoneE164}`,
        priceRange: "$$",
        address: {
          "@type": "PostalAddress",
          streetAddress: site.address,
          addressLocality: site.city,
          addressRegion: site.county,
          postalCode: site.postalCode,
          addressCountry: "RO",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: site.geo.lat,
          longitude: site.geo.lng,
        },
        openingHoursSpecification: openingHours,
        sameAs: [site.social.facebook, site.social.instagram],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[300] focus:bg-[var(--color-on-surface)] focus:text-[var(--color-background)] focus:px-4 focus:py-2 focus:rounded-[var(--radius-md)] focus:font-semibold"
    >
      Sari la conținut
    </a>
    <slot />

    <!--
      Two small scripts, and the page reads fine without either.

      Open now: the readout window and the contact header show the green dot and "Deschis acum" only inside the
      opening hours, read in the workshop's time zone from the hours in site.ts. With scripts off the window keeps the
      town.

      Call bar: the phone's sticky call bar shows once the card's call has left the view, and hides while a page's own
      call (the contact block) is in view. With scripts off it stays visible, as it always did.
    -->
    <script is:inline define:vars={{ hours: openDays }}>
      (() => {
        const parts = new Intl.DateTimeFormat("en-GB", {
          timeZone: "Europe/Bucharest",
          weekday: "long",
          hour: "2-digit",
          minute: "2-digit",
          hourCycle: "h23",
        }).formatToParts(new Date());
        const get = (type) => parts.find((p) => p.type === type)?.value;
        const now = `${get("hour")}:${get("minute")}`;
        const day = get("weekday");
        const open = hours.some((h) => h.days.includes(day) && now >= h.opens && now < h.closes);
        if (open) document.documentElement.setAttribute("data-open", "");
      })();
    </script>
    <script is:inline>
      (() => {
        const bar = document.querySelector("[data-call-bar]");
        if (!bar || typeof IntersectionObserver === "undefined") return;
        const seen = new Set();
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) seen.add(e.target);
            else seen.delete(e.target);
          }
          if (seen.size === 0) bar.setAttribute("data-show", "");
          else bar.removeAttribute("data-show");
        });
        document.querySelectorAll("[data-call-card], [data-call-own]").forEach((el) => io.observe(el));
        document.documentElement.classList.add("bar-js");
      })();
    </script>
  </body>
</html>
