---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { withBase } from "@sites/kit";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description = `${title} · ${site.name}`, updated = site.legal.documentsUpdated } = Astro.props;
---

<Base title={`${title} · ${site.name}`} description={description}>
  <div class="stripe" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
  </div>
  <header class="hdr">
    <div class="hdr-in">
      <a href={withBase("/")} class="mark" aria-label={`${site.name} — acasă`}>
        {site.name}
      </a>
      <a href={withBase("/")} class="back">
        ← Înapoi la site
      </a>
    </div>
  </header>

  <!-- The legal text reads on the job card, the page's one light material. -->
  <main id="main" class="legal-page">
    <h1>{title}</h1>
    <p class="updated">Ultima actualizare: {updated}</p>

    <article class="card legal-prose">
      <slot />
    </article>
  </main>

  <Footer />
</Base>

<style is:global>
  .legal-page {
    max-width: 840px;
    margin: 0 auto;
    padding: 56px 20px 0;
  }
  .legal-page h1 {
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    margin: 0;
  }
  .legal-page .updated {
    margin: 12px 0 32px;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }
  .hdr .back {
    margin-left: auto;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }
  .hdr .back:hover {
    color: var(--color-on-surface);
  }
  /* The card is pinned on the home page; here it is the reading surface. */
  .legal-page .legal-prose {
    position: static;
    display: block;
    padding: 24px 20px;
    color: var(--color-inverse-on-surface-variant);
    line-height: 1.7;
  }
  @media (min-width: 768px) {
    .legal-page {
      padding-inline: 36px;
    }
    .legal-page .legal-prose {
      padding: 40px 44px;
    }
  }
  .legal-prose h2 {
    font-weight: 800;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    color: var(--color-inverse-on-surface);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .legal-prose h2:first-child {
    margin-top: 0;
  }
  .legal-prose h3 {
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-inverse-on-surface);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose p {
    margin-bottom: 1rem;
  }
  .legal-prose ul,
  .legal-prose ol {
    margin: 0.5rem 0 1.25rem;
    padding-left: 1.5rem;
    list-style: disc;
  }
  .legal-prose ol {
    list-style: decimal;
  }
  .legal-prose li {
    margin-bottom: 0.5rem;
  }
  .legal-prose a {
    color: var(--color-inverse-on-surface);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .legal-prose a:hover {
    background-color: var(--color-inverse-surface-container);
  }
  .legal-prose strong {
    color: var(--color-inverse-on-surface);
    font-weight: 700;
  }
  .legal-prose hr {
    border: none;
    border-top: 1px solid var(--color-inverse-outline-variant);
    margin: 2rem 0;
  }
  .legal-prose .note {
    background-color: var(--color-inverse-surface-container);
    border: 1px solid var(--color-inverse-outline-variant);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    color: var(--color-inverse-on-surface-variant);
  }
  .legal-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.95rem;
  }
  .legal-prose th,
  .legal-prose td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-inverse-outline-variant);
    vertical-align: top;
  }
  .legal-prose th {
    color: var(--color-inverse-on-surface);
    font-weight: 700;
  }
</style>
