---
import Icon from "./Icon.astro";
import MapConsent from "./MapConsent.tsx";
import { hoursTable, site, telLink, waLink } from "../content/site";

/*
  The conversion moment, on the ground: the call in red, WhatsApp beside it,
  the details on a panel and the consent-gated map placeholder beside them.
  No form: for a three-person workshop the call, and WhatsApp where the owner
  can ask for a photo of the warning light, are the honest immediate paths. No
  form means no silently lost lead and no inbox to babysit.
*/
interface Props {
  /** Leave out the heading and lede, for a page whose header already says them. */
  bare?: boolean;
}
const { bare = false } = Astro.props;
---

<section class="sec ct" aria-labelledby={bare ? undefined : "ct-title"} aria-label={bare ? "Contact" : undefined}>
  {!bare && (
    <>
      <h2 id="ct-title">Hai cu mașina la noi</h2>
      <p class="slede">
        Cel mai rapid e un telefon. Dacă preferi să scrii, trimite-ne un mesaj pe WhatsApp, poți atașa și o poză cu
        martorul aprins sau cu piesa.
      </p>
    </>
  )}
  <div class="ctg">
    <div class="cta">
      <div class="acts">
        <a class="call" href={telLink()} data-call-own data-cta="contact-call">
          <Icon name="phone" size={24} class="ic" />
          <span>
            <span class="l">Sună acum</span>
            <span class="n">{site.phone}</span>
          </span>
        </a>
        <a class="btn ol big" href={waLink()} target="_blank" rel="noopener" data-cta="contact-whatsapp">
          <Icon name="whatsapp" size={24} class="ic" />
          WhatsApp
        </a>
      </div>
      <dl class="panel facts">
        <div>
          <dt>Adresă</dt>
          <dd>
            {site.address}
            <br />
            {site.city}, jud. {site.county}
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
        <div>
          <dt>Program</dt>
          <dd>
            <ul class="hl">
              {hoursTable.map((h) => (
                <li>
                  <span>{h.day}</span>
                  <span>{h.value}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
    <MapConsent client:visible lat={site.geo.lat} lng={site.geo.lng} label={site.name} />
  </div>
</section>
