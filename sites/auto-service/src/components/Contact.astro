---
import Icon from "./Icon.astro";
import MapConsent from "./MapConsent.tsx";
import { site, telLink, waLink } from "../content/site";

/*
  The conversion moment, set on the one light material in this world: the
  brushed-aluminium console trim (THE TRIM RULE). No form — for a three-person
  workshop the call, and WhatsApp where the owner can ask for a photo of the
  warning light, are the honest immediate paths. No form means no silently lost
  lead and no inbox to babysit.
*/
interface Props {
  bare?: boolean;
  heading?: "h1" | "h2";
}
const { bare = false, heading = "h2" } = Astro.props;
const Heading = heading;
---

<section id="contact" class="section trim ct">
  <div class="container-page">
    {!bare && (
      <div class="reveal ct__head">
        <Heading class="heading-lg">Hai cu mașina la noi</Heading>
        <p class="ct__lede">
          Cel mai rapid e un telefon. Dacă preferi să scrii, trimite-ne un mesaj
          pe WhatsApp — poți atașa și o poză cu martorul aprins sau cu piesa.
        </p>
      </div>
    )}

    <div class:list={["ct__grid", !bare && "ct__grid--spaced"]}>
      <div class="reveal">
        <div class="ct__actions">
          <a href={telLink()} class="btn btn-primary btn-lg ct__btn" data-cta="contact-call">
            <Icon name="phone" size={18} />
            <span class="reading ct__num">{site.phone}</span>
          </a>
          <a href={waLink()} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg ct__btn" data-cta="contact-whatsapp">
            <Icon name="whatsapp" size={18} />
            <span>WhatsApp</span>
          </a>
        </div>

        <dl class="ct__facts">
          <div class="ct__fact">
            <dt class="legend">Adresă</dt>
            <dd>{site.address}<br />{site.city}, jud. {site.county}</dd>
          </div>
          <div class="ct__fact">
            <dt class="legend">Email</dt>
            <dd><a href={`mailto:${site.email}`} class="ct__mail">{site.email}</a></dd>
          </div>
          <div class="ct__fact ct__fact--wide">
            <dt class="legend">Program</dt>
            <dd>
              <ul class="ct__hours">
                {site.hours.map((h) => (
                  <li>
                    <span>{h.day}</span>
                    <span class="reading">{h.value}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </div>

      <div class="reveal ct__mapwrap">
        <div class="ct__map">
          <MapConsent client:visible lat={site.geo.lat} lng={site.geo.lng} label={site.name} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ct__head { max-width: 52ch; }
  .ct__lede {
    margin-top: 1.1rem;
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--color-inverse-on-surface-variant);
  }

  .ct__grid { display: grid; gap: 2.25rem; }
  .ct__grid--spaced { margin-top: 2.75rem; }
  @media (min-width: 1024px) { .ct__grid { grid-template-columns: 1fr 1fr; gap: 3rem; } }

  .ct__actions { display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 520px) { .ct__actions { flex-direction: row; } }
  .ct__btn { flex: 1; }
  .ct__num { font-size: 0.95rem; letter-spacing: 0.11em; font-weight: 700; }

  .ct__facts {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid oklch(0% 0 0 / 0.16);
  }
  @media (min-width: 560px) { .ct__facts { grid-template-columns: repeat(2, 1fr); } }
  .ct__fact--wide { grid-column: 1 / -1; }
  .ct__fact dd { margin-top: 0.5rem; line-height: 1.6; }

  .ct__mail {
    font-weight: 600;
    color: oklch(42% 0.14 45);
    text-decoration: underline;
    text-decoration-color: oklch(42% 0.14 45 / 0.4);
  }
  .ct__mail:hover { text-decoration-color: currentColor; }

  .ct__hours { list-style: none; margin: 0.35rem 0 0; padding: 0; }
  .ct__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
    border-top: 1px solid oklch(0% 0 0 / 0.12);
  }
  .ct__hours li:first-child { border-top: 0; }
  .ct__hours li span:last-child { font-weight: 600; }

  .ct__mapwrap { min-height: 18rem; }
  .ct__map {
    height: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid oklch(0% 0 0 / 0.18);
  }
  @media (min-width: 1024px) { .ct__map { aspect-ratio: auto; } }
</style>
