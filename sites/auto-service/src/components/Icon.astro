if (!d) throw new Error(`Icon: "${name}" is not in the set — draw it into Icon.astro rather than importing one.`);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? "currentColor" : "none"}
  stroke={isBrand ? "none" : "currentColor"}
  stroke-width={isBrand ? undefined : stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><path d={d} /></svg>
