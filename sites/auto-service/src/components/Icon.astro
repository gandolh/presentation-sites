---
/*
  THE ONE-SET RULE (see global.css).

  This is the site's only iconography: one closed set, every glyph drawn on the
  same 24x24 box at the same 1.75 stroke, round caps and joins, no fills. A
  service that needs a symbol gets one drawn in here — never an emoji, never a
  second library. Brand marks (WhatsApp, Facebook, Instagram) are the sole
  filled exceptions, because a brand mark is a signature, not a pictogram.
*/
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  stroke?: number;
}
const { name, size = 22, class: className = "", stroke = 1.75 } = Astro.props;

