---
/*
  AUTHORED ASSET: the bay, drawn.

  There is no photography for this workshop and none is coming, so the "look
  inside" moment is drawn rather than faked with stock. This is a side
  elevation of a two-post lift with a car raised on it, in ink and line.
  Nothing here claims anything: it is a picture of the work, not a photo of a
  place.
*/
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

