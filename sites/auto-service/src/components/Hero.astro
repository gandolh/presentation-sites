---
import Gauge from "./Gauge.astro";
import Icon from "./Icon.astro";
import { site, telLink, waLink } from "../content/site";

// The three symptoms a worried owner actually arrives with. Each is a real
// entry point: it opens WhatsApp with the symptom already written, so the
// visitor never has to compose the awkward first message.
const symptoms = [
  {
    icon: "warning",
    label: "Mi-a apărut un martor",
    msg: "Bună ziua! Mi-a apărut un martor pe bord. Model și an: ___. Ce scrie / cum arată martorul: ___.",
  },
  {
    icon: "wrench",
    label: "Revizie depășită",
    msg: "Bună ziua! Am revizia depășită și aș vrea o programare. Model și an: ___. Km actuali: ___.",
  },
  {
    icon: "noise",
    label: "Face un zgomot",
    msg: "Bună ziua! Mașina face un zgomot. Model și an: ___. Când apare zgomotul: ___.",
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wrap container-page">
    <div class="hero__intro">
      <ul class="hero__symptoms" aria-label="Spune-ne ce are mașina">
        {symptoms.map((s) => (
          <li>
            <a class="symptom" href={waLink(s.msg)} target="_blank" rel="noopener noreferrer">
              <Icon name={s.icon} size={17} class="symptom__ico" />
              <span>{s.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <h1 id="hero-title" class="heading-xl hero__title">
        BMW-ul tău,<br />pe mâini care<br /><span class="lit">îl citesc.</span>
      </h1>

      <p class="hero__lede">
        Trei oameni, o singură marcă. Citim toate modulele, îți spunem exact ce
        are și cât costă — și abia apoi punem mâna pe mașină.
      </p>
    </div>

    <div class="hero__act">
      <div class="hero__actions">
        <a class="btn btn-primary hero__call" href={telLink()}>
          <Icon name="phone" size={19} />
          <span class="hero__call-stack">
            <span class="hero__call-label">SUNĂ ACUM</span>
            <span class="hero__call-num reading">{site.phone}</span>
          </span>
        </a>
        <a class="btn btn-outline" href={waLink()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} />
          Trimite o poză pe WhatsApp
        </a>
      </div>

      <div class="hero__status">
        <span class="hero__live" aria-hidden="true"></span>
        <span class="hero__status-item">Deschis acum</span>
        <span class="hero__sep" aria-hidden="true"></span>
        <span class="hero__status-item hero__status-item--dim">L–V 08:00–18:00 · Sâ 09:00–14:00</span>
        <span class="hero__sep" aria-hidden="true"></span>
        <span class="hero__status-item hero__status-item--dim">{site.city} · {site.county}</span>
      </div>
    </div>

    <div class="hero__instrument" aria-hidden="true">
      <span class="hero__bloom"></span>
      <span class="hero__dial">
        <Gauge
          id="tach"
          size={470}
          max={8}
          value={0.82}
          redline={6.5}
          obc={["ULEI 3.400 km", `${site.city.toUpperCase()} · ${site.county.toUpperCase()}`]}
          label="Turometru"
        />
      </span>
      <span class="hero__shoulder">
        <Gauge id="shoulder" size={196} max={8} value={6.9} compact label="DEVIZ" />
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-image:
      radial-gradient(1100px 620px at 76% 50%, oklch(72% 0.17 58 / 0.085), transparent 62%),
      radial-gradient(900px 700px at 8% 6%, oklch(68% 0.15 242 / 0.035), transparent 60%);
  }

  .hero__wrap {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-block: calc(var(--nav-h, 4.15rem) + clamp(1.25rem, 3vw, 2.35rem))
      clamp(2.25rem, 4.5vw, 2.6rem);
  }

  .hero__intro { grid-row: 1; }
  .hero__instrument { grid-row: 2; }
  .hero__act { grid-row: 3; }

  @media (min-width: 1024px) {
    .hero__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: 2rem;
      row-gap: 0;
    }
    .hero__intro { grid-column: 1; grid-row: 1; align-self: end; }
    .hero__act { grid-column: 1; grid-row: 2; align-self: start; padding-top: 1.9rem; }
    .hero__instrument { grid-column: 2; grid-row: 1 / 3; }
  }

  /* ---- symptom entry points ---- */
  .hero__symptoms {
    display: flex;
    gap: 0.55rem;
    list-style: none;
    margin: 0 0 1.3rem;
    padding: 0;
  }
  /* Three chips, one row. On a narrow phone the row scrolls inside itself
     rather than stacking and eating the fold; the page never scrolls sideways. */
  @media (max-width: 599.98px) {
    .hero__symptoms {
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      scroll-snap-type: x proximity;
    }
    .hero__symptoms::-webkit-scrollbar { display: none; }
    .hero__symptoms > li { scroll-snap-align: start; }
  }
  @media (min-width: 600px) { .hero__symptoms { flex-wrap: wrap; } }
  .symptom {
    display: inline-flex;
    flex: none;
    white-space: nowrap;
    align-items: center;
    gap: 0.55rem;
    padding: 0.58rem 0.85rem 0.58rem 0.72rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius);
    background-image: linear-gradient(180deg, oklch(20% 0.012 256), oklch(16% 0.010 255));
    font-size: 0.795rem;
    font-weight: 600;
    letter-spacing: 0.012em;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition:
      border-color 180ms var(--ease-out),
      color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }
  .symptom__ico {
    color: var(--color-primary);
    filter: drop-shadow(0 0 5px oklch(72% 0.17 58 / 0.7));
    flex: none;
  }
  .symptom:hover {
    color: var(--color-on-surface);
    border-color: var(--color-primary-edge);
    box-shadow: 0 0 18px -6px oklch(72% 0.17 58 / 0.45);
  }

  .hero__title { margin-bottom: 1.1rem; }

  .hero__lede {
    max-width: 30ch;
    font-size: 1.03rem;
    line-height: 1.62;
    color: var(--color-on-surface-variant);
    margin-bottom: 1.6rem;
  }
  @media (min-width: 640px) { .hero__lede { max-width: 46ch; } }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__call { padding-block: 0.8rem; }
  .hero__call-stack { display: flex; flex-direction: column; gap: 0.24rem; text-align: left; }
  .hero__call-label {
    font-family: var(--font-display);
    font-variation-settings: "wdth" 112, "wght" 800;
    font-size: 0.94rem;
    letter-spacing: 0.085em;
    line-height: 1;
  }
  .hero__call-num { font-size: 0.68rem; letter-spacing: 0.15em; opacity: 0.82; line-height: 1; }

  /* ---- status rail ---- */
  .hero__status {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.7rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-outline-variant);
  }
  .hero__status-item {
    font-family: var(--font-mono);
    font-size: 0.655rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-on-surface);
  }
  .hero__status-item--dim { color: var(--color-on-surface-variant); }
  .hero__sep { width: 1px; height: 12px; background: var(--color-outline-variant); }
  @media (max-width: 559.98px) {
    .hero__status { display: grid; grid-template-columns: auto 1fr; column-gap: 0.6rem; row-gap: 0.45rem; }
    .hero__sep { display: none; }
    .hero__status-item:not(:first-of-type) { grid-column: 2; }
  }
  /* "Deschis acum" is a live state, so it is the one thing besides the call
     that carries illumination. */
  .hero__live {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 9px oklch(72% 0.17 58 / 0.9), 0 0 20px oklch(72% 0.17 58 / 0.32);
    flex: none;
  }

  /* ---- the instrument ----
     Mobile is the primary surface for this business, so the instrument ships
     there too — cropped to its upper arc, the way the cluster sits over the
     wheel rim from the driver's seat. It gets its own band rather than hiding
     behind the copy, so nothing competes with the headline. */
  .hero__instrument {
    position: relative;
    width: 100%;
    height: clamp(140px, 38vw, 176px);
    overflow: hidden;
    margin-block: 0.25rem 0.5rem;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 14% 80%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 14% 80%, transparent 100%);
  }

  .hero__bloom {
    position: absolute;
    inset: -22% 8% -40% -8%;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(72% 0.17 58 / 0.13), transparent 62%);
    pointer-events: none;
  }
  .hero__scrim { display: none; }

  .hero__dial { position: absolute; display: block; left: 50%; top: 0; width: 118%; transform: translate(-50%, -34%); }
  .hero__shoulder { display: none; }

  @media (min-width: 640px) {
    .hero__instrument { height: clamp(200px, 30vw, 260px); }
    .hero__dial { width: 66%; transform: translate(-50%, -30%); }
  }

  @media (min-width: 1024px) {
    .hero__instrument {
      justify-self: end;
      align-self: center;
      max-width: 660px;
      height: auto;
      aspect-ratio: 600 / 512;
      overflow: visible;
      margin-block: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__bloom { inset: -8% 6% 4% -4%; }
    .hero__dial { left: -9.5%; top: 0; width: 83%; transform: none; }
    /* Cropped by the viewport edge, the way the second dial sits in a binnacle. */
    .hero__shoulder { display: block; position: absolute; right: -12%; top: 33%; width: 39%; }
  }

</style>

<script>
  // THE IGNITION SWEEP — the one authored motion moment on this site.
  // Key to position II: the needles sweep the full scale and settle back, the
  // backlight comes up, and the dot-matrix window lights last. Everything is
  // already drawn and legible before this runs; the sweep only moves what a
  // real cluster moves, once, on arrival.
  import { animate, createTimeline, utils } from "animejs";

  const reduced =
    typeof matchMedia === "function" &&
    matchMedia("(prefers-reduced-motion: reduce)").matches;

  const gauges = Array.from(
    document.querySelectorAll<SVGSVGElement>("[data-gauge]"),
  );

  if (!reduced && gauges.length) {
    const tl = createTimeline({ defaults: { ease: "outQuart" } });

    gauges.forEach((svg, i) => {
      const needle = svg.querySelector<SVGGElement>("[data-needle]");
      if (!needle) return;

      const rest = Number(svg.dataset.rest ?? 0);
      const start = Number(svg.dataset.start ?? -125);
      const end = Number(svg.dataset.end ?? 125);

      utils.set(needle, { rotate: start });

      tl.add(
        needle,
        { rotate: end, duration: 780, ease: "inOutQuad" },
        i * 90,
      ).add(
        needle,
        { rotate: rest, duration: 1150, ease: "outElastic(1, 0.72)" },
        i * 90 + 820,
      );
    });

    // The backlight ring and the matrix window come up with the sweep.
    animate(".hero__bloom", {
      opacity: [0, 1],
      scale: [0.94, 1],
      duration: 1200,
      ease: "outQuart",
    });
  }
</script>
