---
import Icon from "./Icon.astro";
import { hoursTable, site, telLink, waLink } from "../content/site";
import { withBase } from "@sites/kit";

const year = new Date().getFullYear();
const links = [
  { href: "/", label: "Acasă" },
  { href: "/servicii/", label: "Servicii" },
  { href: "/despre/", label: "Atelier" },
  { href: "/contact/", label: "Contact" },
];
const legalLinks = [
  { href: "/confidentialitate/", label: "Politică de confidențialitate" },
  { href: "/termeni/", label: "Termeni și condiții" },
  { href: "/cookie-uri/", label: "Politică de cookie-uri" },
];
const ident = [
  site.legal.legalName,
  `CUI: ${site.legal.cui}`,
  `Reg. Com.: ${site.legal.regNumber}`,
  ...(site.legal.form === "SRL" && site.legal.shareCapital ? [`Capital social: ${site.legal.shareCapital}`] : []),
  ...(site.legal.rarAuth ? [site.legal.rarAuth] : []),
  `${site.address}, ${site.city}, jud. ${site.county}`,
];
---

<footer class="ft">
  <div class="stripe" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
  </div>

  <div class="ft-in">
    <div class="ftg">
      <div>
        <a href={withBase("/")} class="mark" aria-label={`${site.name} — acasă`}>
          {site.name}
        </a>
        <p class="tag">{site.tagline}</p>
        <div class="soc">
          <a href={site.social.facebook} aria-label="Facebook" target="_blank" rel="noopener">
            <Icon name="facebook" size={24} class="ic" />
          </a>
          <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">
            <Icon name="instagram" size={24} class="ic" />
          </a>
          <a href={waLink()} aria-label="WhatsApp" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={24} class="ic" />
          </a>
        </div>
      </div>

      <nav aria-label="Navigare subsol">
        <p class="ftl">Navigare</p>
        {links.map((l) => (
          <a href={withBase(l.href)}>{l.label}</a>
        ))}
      </nav>

      <nav aria-label="Pagini legale">
        <p class="ftl">Legal</p>
        {legalLinks.map((l) => (
          <a href={withBase(l.href)}>{l.label}</a>
        ))}
      </nav>

      <div>
        <p class="ftl">Contact</p>
        <a href={telLink()}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p class="addr">
          {site.address}, {site.city}
        </p>
        <dl class="fth">
          {hoursTable.map((h) => (
            <div>
              <dt>{h.day}</dt>
              <dd>{h.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <!-- Business identification (Legea 365/2002 art. 5) + ANPC SAL + RAR + BMW disclaimer -->
    <div class="legal">
      <ul class="ident">
        {ident.map((i) => (
          <li>{i}</li>
        ))}
      </ul>
      <p class="disc">{site.independence}</p>
      <div class="btm">
        <p>
          © {year} {site.name}. Toate drepturile rezervate.
        </p>
        <a
          href="https://reclamatiisal.anpc.ro/"
          target="_blank"
          rel="noopener"
          aria-label="ANPC: Soluționarea Alternativă a Litigiilor"
          class="anpc"
        >
          <span class="am">ANPC</span>
          <span>Soluționarea Alternativă a Litigiilor (SAL)</span>
        </a>
      </div>
    </div>
  </div>
</footer>
