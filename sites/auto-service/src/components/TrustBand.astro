---
/*
  The four things a worried owner needs to believe, as a bordered table above
  the fold: a label, the claim, the note. No note is shortened.
*/
const items = [
  { label: "Autorizare", title: "Autorizat RAR", note: "Lucrări conforme, cu factură" },
  { label: "Înainte de lucrare", title: "Deviz scris, în avans", note: "Niciun cost neaprobat de tine" },
  { label: "După lucrare", title: "Garanție 12 luni", note: "Piese și manoperă, în scris" },
  { label: "Specializare", title: "Doar BMW, zi de zi", note: "Diagnoză dedicată, nu generalistă" },
] as const;
---

<div class="trustwrap">
  <div class="panel">
    <table class="trust" aria-label="De ce ne poți lăsa mașina">
      <tbody class="tbody">
        {items.map((it) => (
          <tr>
            <th scope="row">{it.label}</th>
            <td>{it.title}</td>
            <td>{it.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
