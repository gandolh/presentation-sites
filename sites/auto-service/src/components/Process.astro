---
// The five steps of the work, in the order the customer meets them. The
// sequence is the information, so the numbers stay, with a node on each step's
// rule and a hairline over its short result.
const steps = [
  {
    title: "Ne suni sau ne scrii",
    body: "Spune-ne modelul, anul și ce simptome are mașina. Stabilim când o aduci.",
    read: "0 lei",
  },
  {
    title: "Diagnoză",
    body: "Verificăm mașina cu diagnoza dedicată BMW și găsim cauza, nu doar simptomul.",
    read: "cauza",
  },
  {
    title: "Primești devizul",
    body: "Îți spunem clar ce e de făcut, ce piese și cât costă, totul înainte de lucrare.",
    read: "în scris",
  },
  {
    title: "Aprobi și reparăm",
    body: "Lucrăm doar ce ai aprobat. Dacă apare ceva pe parcurs, te sunăm întâi.",
    read: "aprobat",
  },
  { title: "Ridici mașina", body: "Cu factură și certificat de garanție pentru piese și manoperă.", read: "12 luni" },
];
---

<section class="sec" aria-labelledby="proc-title">
  <h2 id="proc-title">Cum lucrăm, de la telefon la cheie</h2>
  <p class="slede">Fără bătăi de cap și fără costuri care apar din senin. Știi tot timpul la ce pas ești.</p>
  <div class="panel">
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <span class="read">{s.read}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
