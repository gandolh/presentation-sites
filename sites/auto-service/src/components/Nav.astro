---
import MobileMenu from "./MobileMenu.tsx";
import Icon from "./Icon.astro";
import { site, telLink } from "../content/site";
import { withBase } from "@sites/kit";

interface Props {
  current?: string;
}
const { current = "/" } = Astro.props;

const links = [
  { href: "/", label: "Acasă" },
  { href: "/servicii/", label: "Servicii" },
  { href: "/despre/", label: "Atelier" },
  { href: "/contact/", label: "Contact" },
];
---

<header id="site-nav" class="hdr">
  <div class="hdr-in">
    <a href={withBase("/")} class="mark" aria-label={`${site.name} — acasă`}>
      {site.name}
    </a>

    <nav class="nav" aria-label="Navigare principală">
      {links.map((link) => (
        <a href={withBase(link.href)} aria-current={current === link.href ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <a href={telLink()} class="hphone" data-cta="nav-call">
      <Icon name="phone" size={24} class="ic" />
      <span>{site.phone}</span>
    </a>
    <MobileMenu client:load current={current} />
  </div>
</header>
