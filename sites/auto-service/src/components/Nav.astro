---
import MobileMenu from "./MobileMenu.tsx";
import Icon from "./Icon.astro";
import { site, telLink } from "../content/site";
import { withBase } from "@sites/kit";

interface Props {
  current?: string;
  /** Subpages render the bar as a solid binnacle edge from the top. */
  solid?: boolean;
}
const { current = "/", solid = false } = Astro.props;

const links = [
  { href: "/", label: "Acasă" },
  { href: "/servicii/", label: "Servicii" },
  { href: "/despre/", label: "Atelier" },
  { href: "/contact/", label: "Contact" },
];
const isActive = (href: string) => current === href;

const [wordA, wordB] = site.name.split(" ");
---

<header
  id="site-nav"
  class="nav"
  data-scrolled={solid ? "true" : "false"}
  data-solid={solid ? "true" : "false"}
  data-overlay={solid ? undefined : "true"}
>
  <div class="container-page nav__bar">
    <a href={withBase("/")} class="nav__wm" aria-label={`${site.name} — acasă`}>
      <span class="nav__pilot" aria-hidden="true"></span>
      <span class="wordmark nav__name">
        {wordA}<span class="nav__dot" aria-hidden="true">·</span>{wordB ?? ""}
      </span>
    </a>

    <nav class="nav__links" aria-label="Navigare principală">
      {links.map((link) => (
        <a
          href={withBase(link.href)}
          class="nav__link"
          aria-current={isActive(link.href) ? "page" : undefined}
          data-active={isActive(link.href) ? "true" : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href={telLink()} class="nav__tel reading" data-cta="nav-call">
        <Icon name="phone" size={15} />
        <span>{site.phone}</span>
      </a>
      <MobileMenu client:load current={current} />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-nav");
    if (!nav) return;
    if (nav.dataset.overlay === "true") {
      var setH = function () {
        nav.style.setProperty("--nav-h", nav.offsetHeight + "px");
      };
      setH();
      window.addEventListener("resize", setH, { passive: true });
    }
    if (nav.dataset.solid === "true") return;
    function update() {
      nav.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
    }
    update();
    window.addEventListener("scroll", update, { passive: true });
  })();
</script>

<style>
  /* The top edge of the binnacle. */
  .nav {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    transition:
      background-color 280ms var(--ease-out),
      border-color 280ms var(--ease-out),
      backdrop-filter 280ms var(--ease-out);
  }
  .nav[data-overlay] { margin-bottom: calc(-1 * var(--nav-h, 4.5rem)); }

  .nav__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.15rem;
  }

  .nav__wm {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-right: auto;
    text-decoration: none;
    color: var(--color-on-surface);
  }
  .nav__pilot {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 10px oklch(72% 0.17 58 / 0.9), 0 0 22px oklch(72% 0.17 58 / 0.45);
    flex: none;
  }
  .nav__name { font-size: 1.12rem; text-transform: uppercase; }
  @media (min-width: 768px) { .nav__name { font-size: 1.22rem; } }
  .nav__dot { color: var(--color-primary); padding-inline: 0.12em; }

  .nav__links { display: none; align-items: center; gap: 2.1rem; }
  @media (min-width: 1024px) { .nav__links { display: flex; } }

  .nav__link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    padding-block: 0.4rem;
    transition: color 180ms var(--ease-out);
  }
  .nav__link:hover { color: var(--color-on-surface); }
  .nav__link[data-active] { color: var(--color-on-surface); }
  .nav__link[data-active]::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-m-blue) 0 33.33%,
      var(--color-m-indigo) 33.33% 66.66%,
      var(--color-m-red) 66.66% 100%
    );
  }

  .nav__actions { display: flex; align-items: center; gap: 0.6rem; }

  /* The phone lives in the bar as a readout, not a second shouting button —
     the lit control belongs to the hero and the mobile bar. */
  .nav__tel {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius);
    color: var(--color-on-surface);
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    background-color: oklch(17% 0.010 255);
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
  }
  @media (min-width: 640px) { .nav__tel { display: inline-flex; } }
  .nav__tel:hover {
    color: var(--color-primary-bright);
    border-color: oklch(46% 0.06 58);
    box-shadow: 0 0 18px -8px oklch(72% 0.17 58 / 0.7);
  }

  .nav[data-scrolled="true"] {
    background-color: oklch(11% 0.008 255 / 0.78);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .nav[data-solid="true"] {
    background-image: linear-gradient(180deg, oklch(20% 0.012 256), oklch(15% 0.009 255));
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.055), 0 1px 0 oklch(0% 0 0 / 0.6);
  }

  :global(.nav-burger) { color: var(--color-on-surface); }
</style>
