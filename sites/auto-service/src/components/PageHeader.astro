---
/*
  Subpage header: the heading, a lede and a readout of short facts, one span
  each. `openNow` adds the green dot and "Deschis acum", which a script in
  Base.astro shows only inside the opening hours.
*/
interface Props {
  title: string;
  lead?: string;
  readout?: readonly string[];
  openNow?: boolean;
}
const { title, lead, readout = [], openNow = false } = Astro.props;
---

<div class="head ph">
  <h1>{title}</h1>
  {lead && <p class="lede">{lead}</p>}
  {(readout.length > 0 || openNow) && (
    <p class="readout">
      {openNow && (
        <span class="rd" data-open-only>
          <span class="dot lg" aria-hidden="true" />
          Deschis acum
        </span>
      )}
      {readout.map((r) => (
        <span>{r}</span>
      ))}
    </p>
  )}
</div>
