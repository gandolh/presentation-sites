---
// The phone call is the conversion, so on a phone it is a bar at the bottom of
// the screen. WhatsApp sits beside it as a steel button. A script in Base.astro
// shows the bar only once the card's call has left the view; without it the bar
// stays visible.
import Icon from "./Icon.astro";
import { site, telLink, waLink } from "../content/site";
---

<div class="bar" data-call-bar>
  <a href={telLink()} class="call" data-cta="bar-call">
    <Icon name="phone" size={24} class="ic" />
    <span class="n2">Sună: {site.phone}</span>
  </a>
  <a href={waLink()} target="_blank" rel="noopener" class="wbtn" aria-label="Scrie pe WhatsApp" data-cta="bar-whatsapp">
    <Icon name="whatsapp" size={24} class="ic" />
  </a>
</div>
