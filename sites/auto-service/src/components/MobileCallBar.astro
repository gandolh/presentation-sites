---
// The phone call is the conversion, so on mobile it is a permanently lit
// control at the bottom of the screen. WhatsApp sits beside it, unlit.
import Icon from "./Icon.astro";
import { site, telLink, waLink } from "../content/site";
---

<div class="callbar">
  <div class="callbar__inner">
    <a href={telLink()} class="btn btn-primary callbar__call" data-cta="bar-call">
      <Icon name="phone" size={17} />
      <span>Sună: {site.phone}</span>
    </a>
    <a
      href={waLink()}
      target="_blank"
      rel="noopener"
      class="btn btn-outline callbar__wa"
      aria-label="Scrie pe WhatsApp"
      data-cta="bar-whatsapp"
    >
      <Icon name="whatsapp" size={20} />
    </a>
  </div>
</div>

<style>
  .callbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-mobile-bar);
    border-top: 1px solid var(--color-outline-variant);
    background-color: oklch(11% 0.008 255 / 0.93);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (min-width: 1024px) { .callbar { display: none; } }

  .callbar__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
  }
  .callbar__wa { padding-inline: 1.15rem; color: var(--color-whatsapp); }
  .callbar__wa:hover { color: var(--color-whatsapp-hover); }
</style>
