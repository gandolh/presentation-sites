---
import Icon from "./Icon.astro";

// Four reasons, each pinned to a symbol from the closed set, as a lead
// statement against a hairline column of claims. Not a card grid.
const reasons = [
  {
    icon: "diagnose",
    title: "Doar BMW, zi de zi",
    body: "Aceleași motoare și aceeași electronică în fiecare zi. Cunoaștem bolile de model (lanț N47, VANOS, răcire) și știm unde ne uităm întâi.",
  },
  {
    icon: "phone",
    title: "Vorbești cu omul care repară",
    body: "Fără call-center, fără consilier care pasează mai departe. Discuți direct cu mecanicul care îți ia mașina în primire.",
  },
  {
    icon: "estimate",
    title: "Deviz înainte, fără surprize",
    body: "Întâi diagnoza, apoi devizul. Nicio lucrare neaprobată de tine, și îți explicăm pe înțeles ce și de ce.",
  },
  {
    icon: "key",
    title: "Scule și diagnoză potrivite",
    body: "Tester dedicat pentru erori, codări și adaptări, plus sculele specifice pe care le cer lucrările pe marca asta.",
  },
];
---

<section class="sec" aria-labelledby="why-title">
  <div class="why">
    <div>
      <h2 id="why-title">De ce să ne lași tocmai nouă mașina</h2>
      <p class="slede" style="margin-bottom:0">
        Un atelier de familie nu poate concura cu un dealer la dimensiune. Poate, în schimb, să te trateze ca pe un{" "}
        <strong>vecin</strong>, nu ca pe un număr de bon.
      </p>
    </div>
    <div class="panel">
      <ul class="rows">
        {reasons.map((r) => (
          <li>
            <span class="well" aria-hidden="true">
              <Icon name={r.icon} size={24} class="ic" />
            </span>
            <div>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
