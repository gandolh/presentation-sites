---
import { services } from "../content/services";
import { telLink } from "../content/site";

// `bare` drops the section's own heading block — used when the page already
// carries the title in its PageHeader, so the h1/h2 don't echo each other.
interface Props {
  bare?: boolean;
}
const { bare = false } = Astro.props;

// Distinct line-art icon per service id, drawn inline so there's no icon-font
// dependency. Stroke inherits currentColor (the brand blue).
const icons: Record<string, string> = {
  diagnoza: `<path d="M3 12h3l2-5 4 10 2-5h7"/><circle cx="19" cy="6" r="2"/>`,
  revizii: `<path d="M14 4.5 18 8m-9.5 9.5a3 3 0 1 0 4.24-4.24"/><path d="M16.5 6.5 8 15"/><path d="M5 21l3-3"/><path d="M19 3l2 2-3 3-2-2z"/>`,
  distributie: `<circle cx="8" cy="8" r="4"/><circle cx="16" cy="16" r="4"/><path d="M8 4v1M8 11v1M4 8h1M11 8h1"/><path d="M11 11l2 2"/>`,
  franare: `<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 4v3M12 17v3M4 12h3M17 12h3"/>`,
  suspensie: `<path d="M6 3v4M6 17v4M6 7c2 0 2 2 0 2s-2 2 0 2 2 2 0 2 2 2 0 2"/><path d="M18 3v18"/><path d="M14 3h8M14 21h8"/>`,
  "racire-vanos": `<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/><circle cx="12" cy="12" r="3"/>`,
  electrica: `<path d="M13 2 4 14h6l-1 8 9-12h-6z"/>`,
  climatizare: `<path d="M4 7a4 4 0 0 1 8 0 4 4 0 0 1 8 0"/><path d="M4 13a4 4 0 0 1 8 0 4 4 0 0 1 8 0"/><path d="M4 19a4 4 0 0 1 8 0 4 4 0 0 1 8 0"/>`,
  "pre-itp": `<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>`,
};
---

<!-- Services = a spec sheet bolted to the pit wall. The default page floor; the
     menu itself is a single bordered panel whose rows are split by hairlines,
     not nine identical glowing cards. -->
<section id="servicii" class="section bg-[var(--color-background)]">
  <div class="container-page">
    {
      !bare && (
        <div class="reveal grid items-start gap-x-10 gap-y-5 lg:grid-cols-[auto_minmax(0,1fr)]">
          <span class="m-stripe--v hidden lg:block" aria-hidden="true" />
          <div class="max-w-2xl">
            <span class="m-stripe lg:hidden" aria-hidden="true" />
            <h2 class="heading-lg mt-4 lg:mt-0">Ce facem pe BMW</h2>
            <p class="mt-4 text-lg text-[var(--color-on-surface-variant)]">
              De la revizia de rutină la lucrările pe care nu le face oricine. Dacă
              nu găsești aici ce ai nevoie, sună-ne, probabil o rezolvăm.
            </p>
          </div>
        </div>
      )
    }

    <!-- The menu sheet. One framed panel; each service is a row divided by a
         hairline. Reads top-to-bottom like a printed service list, and on wider
         viewports doubles into two columns so it never sprawls. -->
    <ul
      class:list={[
        "services-sheet overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-outline-variant)] bg-[var(--color-surface-container-lowest)] md:grid md:grid-cols-2",
        bare ? "mt-0" : "mt-12",
      ]}
    >
      {
        services.map((s, i) => (
          <li
            class:list={[
              "services-row reveal group relative flex items-start gap-4 px-5 py-5 transition-colors duration-200 hover:bg-[var(--color-surface-container)] sm:px-6 sm:py-6",
              "border-b border-[var(--color-outline-variant)] last:border-b-0",
              // On the 2-up grid, drop the bottom rule for the last row of each column.
              i % 2 === 0 ? "md:border-r" : "",
              i >= services.length - (services.length % 2 === 0 ? 2 : 1)
                ? "md:border-b-0"
                : "",
            ]}
          >
            {/* Steel tile holding the line-art icon; the M-tab ticks blue on hover. */}
            <span
              class="services-tile mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-outline-variant)] bg-[var(--color-surface-container-high)] text-[var(--color-primary-bright)]"
              aria-hidden="true"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[s.id] ?? ""}
              />
            </span>

            <div class="min-w-0">
              <h3 class="heading-md !text-[1.15rem] text-[var(--color-on-surface)]">
                {s.title}
              </h3>
              <p class="services-label mt-1 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-[var(--color-primary-bright)]">
                {s.subtitle}
              </p>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--color-on-surface-variant)]">
                {s.description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-8 flex flex-wrap items-baseline gap-x-2 text-[var(--color-on-surface-variant)]">
      <span>Nu găsești aici ce ai nevoie?</span>
      <a
        href={telLink()}
        class="font-semibold text-[var(--color-primary-bright)] underline decoration-[var(--color-outline)] underline-offset-4 transition-colors hover:text-[var(--color-on-surface)] hover:decoration-[var(--color-primary-bright)]"
        >Sună-ne</a
      >
      <span>și îți spunem din vorbă, fără obligații.</span>
    </p>
  </div>

  <style>
    /* The icon tile lights up like a lit indicator on hover — steel to blue. */
    .services-tile {
      transition:
        border-color 200ms var(--ease-out),
        background-color 200ms var(--ease-out),
        box-shadow 200ms var(--ease-out);
    }
    .services-row:hover .services-tile {
      border-color: var(--color-primary-bright);
      box-shadow: 0 0 0 1px var(--color-primary-bright),
        0 0 16px -6px oklch(78% 0.12 244 / 0.6);
    }

    @media (prefers-reduced-motion: reduce) {
      .services-tile {
        transition: none;
      }
    }
  </style>
</section>
