---
import Icon from "./Icon.astro";
import { services } from "../content/services";
import { telLink } from "../content/site";

interface Props {
  /** Section heading. Omit the section wrapper when the page supplies one. */
  title?: string;
  lede?: string;
  id?: string;
}
const {
  title = "Ce citim din mașina ta",
  lede = "De la revizia de rutină la lucrările pe care nu le face oricine. Dacă nu găsești aici ce-ți trebuie, sună-ne — probabil o rezolvăm.",
  id = "servicii",
} = Astro.props;

// Every service maps to a symbol in the closed set (see Icon.astro).
const SYMBOL: Record<string, string> = {
  diagnoza: "diagnose",
  revizii: "oil",
  distributie: "chain",
  franare: "brake",
  suspensie: "suspension",
  "racire-vanos": "coolant",
  electrica: "electrics",
  climatizare: "climate",
  "pre-itp": "inspection",
};
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container-page">
    <div class="svc__head reveal">
      <h2 id={`${id}-title`} class="heading-lg">{title}</h2>
      <p class="svc__lede">{lede}</p>
    </div>

    <!-- A check-control legend sheet, not a card grid: hairlines and lamps. -->
    <ul class="svc__board reveal">
      {services.map((s, i) => (
        <li class="svc__row" style={`--i:${i}`}>
          <span class="svc__lamp" aria-hidden="true">
            <Icon name={SYMBOL[s.id] ?? "diagnose"} size={22} />
          </span>
          <div class="svc__text">
            <h3 class="heading-md svc__title">{s.title}</h3>
            <p class="legend svc__sub">{s.subtitle}</p>
            <p class="svc__desc">{s.description}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="svc__foot reveal">
      Nu găsești aici ce ai nevoie?
      <a class="svc__link" href={telLink()}>Sună-ne</a> și îți spunem din vorbă, fără obligații.
    </p>
  </div>
</section>

<style>
  .svc__head {
    max-width: 58ch;
    margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
  }
  .svc__lede {
    margin-top: 1.1rem;
    color: var(--color-on-surface-variant);
    font-size: 1.02rem;
    max-width: 60ch;
  }

  .svc__board {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-outline-variant);
  }
  @media (min-width: 900px) {
    .svc__board { grid-template-columns: repeat(2, 1fr); column-gap: 3.25rem; }
  }

  .svc__row {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.25rem 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .svc__lamp {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    color: var(--color-on-surface-variant);
    background-color: oklch(17% 0.010 255);
    box-shadow: inset 0 0 0 1px oklch(26% 0.013 256);
    border-radius: var(--radius);
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }

  .svc__row:hover .svc__lamp,
  .svc__row:focus-within .svc__lamp {
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    box-shadow:
      inset 0 0 0 1px oklch(86% 0.10 68 / 0.7),
      0 0 20px -4px oklch(72% 0.17 58 / 0.65);
  }

  .svc__title { margin-bottom: 0.28rem; }
  .svc__sub { color: var(--color-primary-bright); margin-bottom: 0.6rem; }
  .svc__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 46ch;
  }

  .svc__foot {
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--color-on-surface-variant);
  }
  .svc__link {
    color: var(--color-primary-bright);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: oklch(82% 0.125 65 / 0.45);
  }
  .svc__link:hover { text-decoration-color: currentColor; }
</style>
