---
import Icon from "./Icon.astro";
import { services } from "../content/services";
import { telLink } from "../content/site";

interface Props {
  title?: string;
  lede?: string;
  id?: string;
}
const {
  title = "Ce citim din mașina ta",
  lede = "De la revizia de rutină la lucrările pe care nu le face oricine. Dacă nu găsești aici ce-ți trebuie, sună-ne, probabil o rezolvăm.",
  id = "servicii",
} = Astro.props;

// Every service maps to a symbol in the closed set (see Icon.astro).
const SYMBOL: Record<string, string> = {
  diagnoza: "diagnose",
  revizii: "oil",
  distributie: "chain",
  franare: "brake",
  suspensie: "suspension",
  "racire-vanos": "coolant",
  electrica: "electrics",
  climatizare: "climate",
  "pre-itp": "inspection",
};
---

<section id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <p class="slede">{lede}</p>
  <!-- An index of hairline rows, not a card grid. -->
  <div class="svcwrap">
    <div class="panel">
      <ul class="idx">
        {services.map((s) => (
          <li>
            <div class="who">
              <span class="well" aria-hidden="true">
                <Icon name={SYMBOL[s.id] ?? "diagnose"} size={24} class="ic" />
              </span>
              <div>
                <h3>{s.title}</h3>
                <p class="st">{s.subtitle}</p>
              </div>
            </div>
            <p class="d">{s.description}</p>
          </li>
        ))}
      </ul>
      <p class="foot">
        Nu găsești aici ce ai nevoie? <a href={telLink()}>Sună-ne</a> și îți spunem din vorbă, fără obligații.
      </p>
    </div>
  </div>
</section>
