---
import Icon from "./Icon.astro";
import { faq } from "../content/faq";

// FAQPage JSON-LD for SEO, built from the same source as the on-page list.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section class="sec" aria-labelledby="faq-title">
  <div class="faq">
    <div>
      <h2 id="faq-title">Întrebări frecvente</h2>
      <p class="slede" style="margin-bottom:0">
        Dacă nu găsești răspunsul aici, sună-ne, îți răspundem cu drag.
      </p>
    </div>
    <div class="panel fl">
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="pl" aria-hidden="true">
              <span class="p">
                <Icon name="plus" size={24} class="ic" />
              </span>
              <span class="m">
                <Icon name="minus" size={24} class="ic" />
              </span>
            </span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
