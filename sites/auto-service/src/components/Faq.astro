---
import Icon from "./Icon.astro";
import { faq } from "../content/faq";

// FAQPage JSON-LD for SEO — built from the same source as the on-page list.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="intrebari" class="section faq" aria-labelledby="faq-title">
  <div class="container-page faq__grid">
    <div class="reveal">
      <h2 id="faq-title" class="heading-lg">Întrebări frecvente</h2>
      <p class="faq__lede">
        Dacă nu găsești răspunsul aici, sună-ne — îți răspundem cu drag.
      </p>
    </div>

    <div class="reveal faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span class="heading-md faq__qt">{f.q}</span>
            <span class="faq__mark" aria-hidden="true"><Icon name="plus" size={20} /></span>
          </summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />
</section>

<style>
  .faq { border-top: 1px solid var(--color-outline-variant); }
  .faq__grid { display: grid; gap: 2rem; }
  @media (min-width: 1024px) { .faq__grid { grid-template-columns: 0.68fr 1.32fr; gap: 4rem; } }

  .faq__lede { margin-top: 1.1rem; color: var(--color-on-surface-variant); max-width: 34ch; }

  .faq__list { border-top: 1px solid var(--color-outline-variant); }

  .faq__item {
    border-bottom: 1px solid var(--color-outline-variant);
    /* box-shadow only: animating padding would relayout the whole list. */
    transition: box-shadow 220ms var(--ease-out);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__qt {
    font-size: 1.03rem;
    transition: color 200ms var(--ease-out);
  }
  .faq__mark {
    flex: none;
    color: var(--color-on-surface-variant);
    transition: transform 300ms var(--ease-out), color 200ms var(--ease-out);
  }
  .faq__item:hover .faq__qt,
  .faq__item[open] .faq__qt { color: var(--color-primary-bright); }
  .faq__item:hover .faq__mark { color: var(--color-primary-bright); }
  .faq__item[open] .faq__mark { transform: rotate(45deg); color: var(--color-primary); }

  /* An open row is the live one: a lit edge, per THE LIVE-AMBER RULE. */
  .faq__item[open] {
    box-shadow: inset 2px 0 0 0 var(--color-primary);
    padding-left: 1rem;
    margin-left: -1rem;
  }

  .faq__a {
    padding: 0 3rem 1.35rem 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-on-surface-variant);
    max-width: 68ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a { animation: faq-open 300ms var(--ease-out) both; }
  }
  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
