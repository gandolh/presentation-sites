---
// Thin top banner for the soft-launch phase: tells visitors the site is still
// being finished and points them at the phone / WhatsApp (the real conversion
// path). Sits at the very top, above the sticky header, under the M stripe.
// Toggle via site.wip.show (set false in site.local.ts once real content is
// live). RO-only.
import { site, telLink, waLink } from "../content/site";
---

{site.wip.show && (
  <>
    <div class="stripe" aria-hidden="true">
      <i />
      <i />
      <i />
    </div>
    <p class="banner">
      {site.wip.text} <a href={telLink()}>{site.phone}</a>{" "}
      <a href={waLink()} target="_blank" rel="noopener">
        WhatsApp
      </a>
    </p>
  </>
)}
