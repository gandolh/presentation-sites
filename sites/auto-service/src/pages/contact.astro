---
import Base from "../layouts/Base.astro";
import WipBanner from "../components/WipBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
---

<Base
  title="Contact · BavAuto Gorj"
  description="Sună sau scrie pe WhatsApp — atelier independent BMW în Târgu-Jiu, jud. Gorj. Program, adresă și hartă."
  path="/contact/"
>
  <WipBanner />
  <Nav current="/contact/" solid />
  <main id="main">
    <PageHeader
      title="Hai cu mașina la noi"
      lead="Cel mai rapid e un telefon. Dacă preferi să scrii, trimite-ne un mesaj pe WhatsApp — poți atașa și o poză cu martorul aprins sau cu piesa."
      readout="Deschis L–V 08:00–18:00 · Sâ 09:00–14:00"
    />
    <Contact bare />
    <Faq />
  </main>
  <Footer />
  <MobileCallBar />
</Base>
