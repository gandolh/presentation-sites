---
import Base from "../layouts/Base.astro";
import WipBanner from "../components/WipBanner.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import About from "../components/About.astro";
import WhyUs from "../components/WhyUs.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
import { site } from "../content/site";
---

<Base
  title="Atelierul · BavAuto Gorj"
  description="Atelier independent BMW, afacere de familie în Târgu-Jiu. Cine suntem, cum lucrăm și de ce ne poți lăsa mașina."
  path="/despre/"
>
  <WipBanner />
  <Nav current="/despre/" solid />
  <main id="main">
    <PageHeader
      title="Atelierul"
      lead="Suntem câțiva oameni dintr-o familie care repară BMW-uri pentru că asta le place cu adevărat. Atât."
      readout={`${site.stats.family} oameni · ${site.stats.years} ani · numai BMW`}
    />
    <About />
    <WhyUs />
    <Contact />
  </main>
  <Footer />
  <MobileCallBar />
</Base>
