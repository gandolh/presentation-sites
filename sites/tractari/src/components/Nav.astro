---
import MobileMenu from "./MobileMenu.tsx";
import PhoneIcon from "./PhoneIcon.astro";
import { site, primaryPhone, telLink } from "../content/site";
import { withBase } from "@sites/kit";

// The header: the wordmark, four places in page order, the call. The call is an
// outline while the dispatcher's plate is on screen and fills once it leaves
// (the observer in Contact.astro sets `data-plate` on the page). On a phone the
// call is the bottom dock's job, so the header keeps only the burger.
const links = [
  { href: "#servicii", label: "Servicii" },
  { href: "#acoperire", label: "Acoperire" },
  { href: "#cum-functioneaza", label: "Cum funcționează" },
  { href: "#contact", label: "Contact" },
];
---

<header id="site-nav" class="site-nav" style="top: var(--banner-h, 0px);">
  <div class="container-page site-nav__row">
    <a href={withBase("/")} class="mark" aria-label={`${site.name}, acasă`}>
      <i aria-hidden="true"></i>
      {site.name}
    </a>

    <nav class="site-nav__links" aria-label="Navigare principală">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a href={telLink(primaryPhone.e164)} class="btn btn-outline btn--sm site-nav__call" data-call="nav">
      <PhoneIcon class="icon" />
      <span class="tnum">{primaryPhone.display}</span>
    </a>
    <div class="site-nav__menu">
      <MobileMenu client:load links={links} />
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset-inline: 0;
    z-index: var(--z-nav);
    background: var(--color-surface-container);
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .site-nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1.75rem;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-on-surface);
  }
  .mark i {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-primary) 22%, transparent);
  }
  .site-nav__links {
    display: flex;
    gap: 0.5rem;
  }
  .site-nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-on-surface-variant);
  }
  .site-nav__links a:hover {
    color: var(--color-on-surface);
  }
  .site-nav__call :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }
  /* The fill: the plate has left the viewport. */
  :global(html[data-plate="out"]) .site-nav__call {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  :global(html[data-plate="out"]) .site-nav__call :global(.icon) {
    color: var(--color-on-accent);
  }
  :global(html[data-plate="out"]) .site-nav__call:hover {
    background: var(--color-accent-hover);
  }
  .site-nav__menu {
    display: none;
  }

  @media (max-width: 1000px) {
    .site-nav__links {
      display: none;
    }
    .site-nav__call {
      margin-left: auto;
    }
    .site-nav__menu {
      display: flex;
      align-items: center;
    }
  }
  @media (max-width: 760px) {
    .site-nav__row {
      height: 3.5rem;
    }
    .mark {
      font-size: 1.5rem;
      line-height: 1.5rem;
    }
    .site-nav__call {
      display: none;
    }
  }
</style>
