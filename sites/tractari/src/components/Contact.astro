---
import PhoneIcon from "./PhoneIcon.astro";
import { phones, site, telLink } from "../content/site";

// The board: the only raised object on the page. Three named lines; the
// dispatcher's number is set large on the orange plate and the other two sit
// beside it. It is the Contact section (`#contact`) and sits in the hero.
const [primary, ...others] = phones;
---

<section id="contact" class="board" aria-labelledby="contact-h">
  <div class="board__head">
    <h2 id="contact-h" class="heading-lg">
      Sună. <br />
      Răspundem.
    </h2>
    <p class="board__copy">
      Oricând, în toată {site.region}. Alege linia potrivită. Sau sună la dispecerat și te direcționăm noi.
    </p>
  </div>
  <div class="lines">
    {primary && (
      <a href={telLink(primary.e164)} class="line line--main">
        <span class="disc">
          <PhoneIcon class="icon" />
        </span>
        <span class="who">
          <span class="tag">
            <span>{primary.label}</span>
            <span>sună acum</span>
          </span>
          <span class="num">{primary.display}</span>
        </span>
      </a>
    )}
    {others.map((p, i) => (
      <a href={telLink(p.e164)} class={`line ${i === 0 ? "line--a" : "line--b"}`}>
        <span class="nm">{p.label}</span>
        <span class="g">
          <PhoneIcon class="icon" />
        </span>
        <span class="n2">{p.display}</span>
      </a>
    ))}
  </div>
</section>
<p class="mail">
  Preferi scris? <a href={`mailto:${site.email}`}>{site.email}</a>. Pentru urgențe, telefonul rămâne cel mai rapid.
</p>

<script is:inline>
  // One observer on the dispatcher's plate drives both the header call and the
  // phone dock: while the plate is in view the header call is an outline and
  // the dock is hidden; once it leaves, the header call fills and the dock
  // shows. Without script the dock stays visible and the header call stays an
  // outline.
  (function () {
    const plate = document.querySelector(".line--main");
    if (!plate || typeof IntersectionObserver === "undefined") return;
    const nav = document.getElementById("site-nav");
    const top = nav ? Math.round(nav.getBoundingClientRect().bottom) : 0;
    const root = document.documentElement;
    new IntersectionObserver(
      function (entries) {
        root.dataset.plate = entries[entries.length - 1].isIntersecting ? "in" : "out";
      },
      { rootMargin: "-" + top + "px 0px 0px 0px" },
    ).observe(plate);
  })();
</script>

<style>
  .board {
    position: relative;
    margin-top: 1.25rem;
    padding: 2rem;
    background: var(--color-surface-container);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-board);
  }
  .board__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  .board__copy {
    margin: 0;
    max-width: 52ch;
    color: var(--color-on-surface-variant);
  }
  .lines {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .line {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 6rem;
    padding: 0 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
  }
  .line:active {
    transform: translateY(1px);
  }
  .line :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* The dispatcher's plate: the one filled orange call on the first screen. */
  .line--main {
    grid-column: 1 / span 6;
    flex-direction: row;
    align-items: center;
    gap: 1.25rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .line--main:hover {
    background: var(--color-accent-hover);
  }
  .disc {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    background: var(--color-on-accent);
    color: var(--color-accent);
  }
  .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .tag {
    display: flex;
    gap: 0.75rem;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
  }
  .tag span:last-child {
    font-weight: 400;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h2);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The two backup lines. */
  .line--a,
  .line--b {
    display: grid;
    grid-template-areas: "nm nm" "g n2";
    grid-template-columns: 1.25rem 1fr;
    gap: 0.125rem 0.5rem;
    align-content: center;
    background: var(--color-surface-container-high);
  }
  .line--a {
    grid-column: 7 / span 3;
  }
  .line--b {
    grid-column: 10 / span 3;
  }
  .line--a:hover,
  .line--b:hover {
    background: var(--color-outline-variant);
  }
  .nm {
    grid-area: nm;
    color: var(--color-on-surface-variant);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
  }
  .g {
    grid-area: g;
    align-self: center;
    color: var(--color-accent);
  }
  .g :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .n2 {
    grid-area: n2;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h3);
    line-height: 1.0715;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mail {
    margin: 1rem 0 0;
    color: var(--color-on-surface-variant);
  }
  .mail a {
    color: var(--color-on-surface);
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .line--main {
      grid-column: 1 / -1;
    }
    .line--a {
      grid-column: 1 / span 6;
    }
    .line--b {
      grid-column: 7 / span 6;
    }
  }

  @media (max-width: 760px) {
    .board {
      margin-top: 0.75rem;
      padding: 1rem;
    }
    .board__head {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .board__head :global(br) {
      display: none;
    }
    .board__copy {
      font-size: 0.9375rem;
      line-height: 1.375rem;
    }
    .lines {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    .line--main,
    .line--a,
    .line--b {
      grid-column: 1;
    }
    .line--main {
      min-height: 4.5rem;
      padding: 0 1rem;
      gap: 1rem;
    }
    .disc {
      width: 2.5rem;
      height: 2.5rem;
    }
    .disc :global(.icon) {
      width: 1.25rem;
      height: 1.25rem;
    }
    .num {
      font-size: 2rem;
      line-height: 2.125rem;
    }
    .line--a,
    .line--b {
      min-height: 3.5rem;
      grid-template-areas: "g nm n2";
      grid-template-columns: 1.25rem 1fr auto;
      align-items: center;
      gap: 0 0.75rem;
      padding: 0 1rem;
    }
    .n2 {
      font-size: 1.5rem;
      line-height: 1.625rem;
    }
  }
</style>
