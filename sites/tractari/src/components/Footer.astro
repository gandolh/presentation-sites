---
import { site, phones, telLink } from "../content/site";

const year = 2026; // demo site; static year avoids build-time nondeterminism
---

<footer class="foot">
  <div class="container-page">
    <div class="foot__grid">
      <div>
        <span class="mark">
          <i aria-hidden="true"></i>
          {site.name}
        </span>
        <p class="foot__tagline">{site.tagline}</p>
        <p class="foot__status">Non-stop 24/7</p>
      </div>

      <div>
        <h2 class="foot__head">Telefon</h2>
        <ul class="foot__phones">
          {phones.map((p) => (
            <li>
              <a href={telLink(p.e164)}>
                <span>{p.label}</span>
                <span>{p.display}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="foot__head">Acoperire</h2>
        <p class="foot__counties">{site.counties.join(", ")}</p>
        <p>Toată regiunea {site.region}, deplasări și în afara județului.</p>
      </div>
    </div>

    <div class="foot__legal">
      <span>
        © {year} {site.legal.legalName}, site demonstrativ. Date fictive.
      </span>
      <span>{site.legal.cui}</span>
      <span>{site.legal.regNumber}</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 7rem;
    padding: 3.5rem 0 2.5rem;
    border-top: 1px solid var(--color-outline-variant);
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 2.5rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1.75rem;
    text-transform: uppercase;
    color: var(--color-on-surface);
  }
  .mark i {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-primary) 22%, transparent);
  }
  .foot__grid p {
    margin: 0.75rem 0 0;
    color: var(--color-on-surface-variant);
  }
  .foot__tagline {
    max-width: 34ch;
  }
  .foot__grid p.foot__status {
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    color: var(--color-on-surface);
  }
  .foot__head {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-on-surface-variant);
  }
  .foot__phones {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot__phones a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    border-top: 1px solid var(--color-outline-variant);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .foot__phones a span:first-child {
    color: var(--color-on-surface-variant);
  }
  .foot__grid p.foot__counties {
    margin-top: 0;
    color: var(--color-on-surface);
  }
  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-outline-variant);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }

  @media (max-width: 1000px) {
    .foot__grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot__grid > :first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .foot {
      margin-top: 4.5rem;
      padding-top: 2.5rem;
    }
    .foot__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .mark {
      font-size: 1.5rem;
      line-height: 1.5rem;
    }
  }
</style>
