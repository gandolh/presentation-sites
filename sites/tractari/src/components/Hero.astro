---
import Contact from "./Contact.astro";
import { site } from "../content/site";

// The opening screen is type on the ground: a plain status line, the headline,
// the lede, a lit lane, then the board of three named phone lines (Contact).
// The 3D scene lives in "Cum funcționează"; nothing here waits on it, so the
// number is on screen and one tap away from the first paint.
const counties = site.counties;
---

<div class="container-page hero">
  <div role="region" aria-label="AXA Tractări, tractări auto pe platformă, non-stop în Oltenia">
    <p class="hero__status">Non-stop 24/7, {site.region}</p>
    <h1 class="heading-xl hero__title">Tractări auto pe platformă.</h1>
    <p class="hero__lede">
      Ai rămas pe drum în {counties.slice(0, -1).join(", ")} sau {counties.at(-1)}? Venim cu platforma și ducem mașina
      în siguranță acolo unde ai nevoie. La orice oră.{" "}
      <a href="#servicii" class="hero__more">
        Ce facem
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 5v14" />
          <path d="m19 12-7 7-7-7" />
        </svg>
      </a>
    </p>
    <svg class="hero__lane" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="lane-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100%" y2="0">
          <stop offset="0" stop-color="var(--color-primary)"></stop>
          <stop offset="1" stop-color="var(--color-accent)"></stop>
        </linearGradient>
      </defs>
      <circle cx="5" cy="5" r="5" fill="var(--color-primary)"></circle>
      <line x1="20" y1="5" x2="100%" y2="5" stroke="url(#lane-grad)" stroke-width="3" stroke-dasharray="12 10"></line>
    </svg>
  </div>
  <Contact />
</div>

<style>
  .hero {
    padding-top: 1.75rem;
  }
  .hero__status {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.625rem;
    font-weight: 600;
    color: var(--color-on-surface);
  }
  .hero__title {
    margin-top: 0.25rem;
  }
  .hero__lede {
    margin: 0.75rem 0 0;
    max-width: 62ch;
    font-size: var(--text-lede);
    line-height: var(--text-lede--line-height);
    color: var(--color-on-surface-variant);
    text-wrap: pretty;
  }
  /* A text link under the paragraph; inline at the end of the lede on a phone. */
  .hero__more {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--color-on-surface);
    text-decoration: underline;
    text-decoration-color: var(--color-outline);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .hero__more:hover {
    text-decoration-color: var(--color-accent);
  }
  .hero__more svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
  }
  .hero__lane {
    display: block;
    width: 100%;
    height: 10px;
    margin-top: 0.75rem;
    overflow: visible;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 1rem;
    }
    .hero__status {
      font-size: 0.9375rem;
      line-height: 1.375rem;
    }
    .hero__title {
      margin-top: 0.125rem;
      text-wrap: balance;
    }
    .hero__lede {
      margin-top: 0.5rem;
    }
    .hero__more {
      display: inline-flex;
      margin: 0 0 0 0.25rem;
      vertical-align: middle;
    }
    .hero__lane {
      margin-top: 0.5rem;
    }
  }
</style>
