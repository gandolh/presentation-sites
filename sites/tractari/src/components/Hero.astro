---
import HeroCanvas from "./hero/HeroCanvas.tsx";
import PhoneIcon from "./PhoneIcon.astro";
import { site, primaryPhone, telLink } from "../content/site";

// FULL-BLEED CINEMATIC HERO. The redesign promotes the 3D chase-cam tow-truck
// scene from a boxed right-hand panel to the FULL background of the opening
// viewport — a film frame. Copy is overlaid lower-left (film-title framing),
// a dark scrim keeps it legible, and the road spine runs in from the bottom.
// All copy is real HTML (the no-JS / reduced-motion / SEO source of truth);
// the WebGL scene degrades to the CSS night-road backdrop.
---
<section
  id="hero"
  class="hero-root relative isolate overflow-hidden"
  aria-label="AXA Tractări — tractări auto pe platformă, non-stop în Oltenia"
>
  <!-- The scene fills the whole hero, behind everything. -->
  <div class="hero-stage" aria-hidden="true">
    <div class="hero-stage__backdrop"></div>
    <HeroCanvas client:only="react" />
  </div>
  <!-- Cinematic scrims: darken the bottom-left for the copy, vignette the edges. -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container-page relative z-[3] flex min-h-[100svh] flex-col justify-end pb-[clamp(4.5rem,11vh,8rem)]">
    <div class="hero-copy max-w-[44rem]">
      <p class="hero-kicker reveal">
        <span class="hero-beacon" aria-hidden="true"></span>
        Non-stop 24/7 · {site.region}
      </p>

      <h1 class="hero-title reveal">
        <span class="block text-[var(--color-on-surface)]">Tractări auto</span>
        <span class="block glow-word">pe platformă.</span>
      </h1>

      <p class="hero-lede reveal">
        Ai rămas pe drum în {site.counties.slice(0, -1).join(", ")} sau
        {site.counties.at(-1)}? Venim cu platforma și ducem mașina în
        siguranță acolo unde ai nevoie. La orice oră.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal">
        <a href={telLink(primaryPhone.e164)} class="btn btn-call text-[1.05rem] !py-4 !px-7">
          <PhoneIcon class="w-5 h-5" />
          Sună acum · <span class="tnum">{primaryPhone.display}</span>
        </a>
        <a href="#servicii" class="btn btn-outline text-[1.05rem] !py-4 !px-7">
          Ce facem
        </a>
      </div>
    </div>
  </div>

  <!-- scroll cue, bottom-right so it doesn't fight the copy -->
  <div class="hero-cue absolute bottom-6 right-6 z-[3] hidden lg:flex flex-col items-center gap-2 text-[var(--color-on-surface-variant)]">
    <span class="text-[0.68rem] uppercase tracking-[0.24em]">Derulează</span>
    <span class="scroll-cue" aria-hidden="true"></span>
  </div>
</section>

<style>
  .hero-root {
    min-height: 100svh;
    background:
      radial-gradient(60% 50% at 50% 20%, oklch(68% 0.2 45 / 0.06) 0%, oklch(68% 0.2 45 / 0) 55%),
      linear-gradient(180deg, oklch(13% 0.012 250) 0%, oklch(16% 0.013 250) 100%);
  }

  /* The 3D stage now fills the entire hero as the background plate. */
  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  :global(.hero-canvas) { position: absolute; inset: 0; z-index: 1; }
  :global(.hero-canvas canvas) { width: 100%; height: 100%; display: block; }

  .hero-stage__backdrop {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(60% 38% at 50% 16%, oklch(80% 0.16 80 / 0.2) 0%, oklch(80% 0.16 80 / 0) 60%),
      radial-gradient(46% 32% at 50% 8%, oklch(95% 0.03 230 / 0.12) 0%, oklch(95% 0.03 230 / 0) 55%),
      linear-gradient(180deg, oklch(10% 0.012 255) 0%, oklch(15% 0.013 250) 55%, oklch(9% 0.012 255) 100%);
  }
  .hero-stage__backdrop::after {
    content: "";
    position: absolute; inset: 0;
    background: conic-gradient(from 90deg at 50% 118%, transparent 0deg, oklch(45% 0.014 250 / 0.3) 10deg, transparent 20deg);
    opacity: 0.8;
  }

  /* Legibility scrim — heavier toward the bottom-left where the copy lives,
     plus a gentle full-frame vignette so the scene reads as a photographed
     plate and the type never floats on a bright patch. */
  .hero-scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(to top, oklch(11% 0.012 255 / 0.92) 0%, oklch(13% 0.012 255 / 0.55) 28%, oklch(13% 0.012 255 / 0) 58%),
      linear-gradient(to right, oklch(11% 0.012 255 / 0.7) 0%, oklch(11% 0.012 255 / 0) 55%),
      radial-gradient(120% 80% at 50% 30%, oklch(11% 0.012 255 / 0) 55%, oklch(8% 0.012 255 / 0.6) 100%);
  }

  .hero-kicker {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: 700; font-size: 0.82rem;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-primary);
  }
  .hero-beacon {
    width: 0.55rem; height: 0.55rem; border-radius: var(--radius-full);
    background: var(--color-primary);
    box-shadow: 0 0 0 0 oklch(80% 0.16 80 / 0.7);
    animation: beacon-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @media (prefers-reduced-motion: reduce) { .hero-beacon { animation: none; } }

  .hero-title {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 0.88;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    text-shadow: 0 2px 30px oklch(0% 0 0 / 0.5);
  }
  .hero-lede {
    margin-top: 1.4rem;
    max-width: 42ch;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-on-surface);
    text-shadow: 0 1px 16px oklch(0% 0 0 / 0.6);
  }

  .scroll-cue {
    width: 1px; height: 40px;
    background: linear-gradient(var(--color-primary), transparent);
    position: relative; overflow: hidden;
  }
  .scroll-cue::after {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 11px;
    background: var(--color-primary);
    animation: scroll-cue 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes scroll-cue {
    0% { transform: translateY(-12px); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: translateY(42px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .scroll-cue::after { animation: none; } }
</style>
