---
import { site } from "../content/site";

// Acoperire: one raised panel, the copy and the counties on the left and a
// stylized (not geographically exact) map on the right, with no frame. The
// counties are nodes radiating from the Târgu-Jiu hub. Pure SVG, no WebGL.
// Node positions are hand-placed to roughly echo the real layout:
//   Mehedinți (SW) · Gorj/hub (NW-center) · Vâlcea (NE) · Dolj (S) · Olt (SE)
const hub = { x: 230, y: 150 };
const nodes = [
  { name: "Gorj", x: 230, y: 150, hub: true, label: -26 },
  { name: "Vâlcea", x: 360, y: 110, label: -22 },
  { name: "Mehedinți", x: 110, y: 215, label: -23 },
  { name: "Dolj", x: 250, y: 280, label: 30 },
  { name: "Olt", x: 400, y: 245, label: 30 },
];
const spokes = nodes.filter((n) => !n.hub);
---

<section id="acoperire" class="band container-page" aria-labelledby="acoperire-h">
  <div class="panel">
    <div>
      <h2 id="acoperire-h" class="heading-lg">
        Toată Oltenia, <span class="nowrap">dintr-un</span> singur apel.
      </h2>
      <p>
        Cu baza în {site.city}, ajungem rapid în {site.counties.length} județe. Pe autostradă, pe drum național sau pe o
        uliță de țară, venim la tine.
      </p>
      <ul class="counties">
        {nodes.map((n) => (
          <li class={n.hub ? "hub" : undefined}>
            <i aria-hidden="true"></i>
            {n.name}
          </li>
        ))}
      </ul>
    </div>

    <svg viewBox="0 0 480 360" class="map" role="img" aria-label={`Hartă de acoperire: ${site.counties.join(", ")}`}>
      <defs>
        <radialGradient id="hub-glow">
          <stop offset="0" stop-color="var(--color-primary)" stop-opacity="0.45"></stop>
          <stop offset="1" stop-color="var(--color-primary)" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <g stroke="var(--color-outline-variant)" stroke-width="1" opacity="0.7">
        {Array.from({ length: 7 }).map((_, i) => (
          <line x1={(i + 1) * 60} y1="0" x2={(i + 1) * 60} y2="360" />
        ))}
        {Array.from({ length: 5 }).map((_, i) => (
          <line x1="0" y1={(i + 1) * 60} x2="480" y2={(i + 1) * 60} />
        ))}
      </g>

      <g stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" fill="none">
        {spokes.map((n) => (
          <path d={`M${hub.x} ${hub.y} L${n.x} ${n.y}`} />
        ))}
      </g>

      <circle cx={hub.x} cy={hub.y} r="46" fill="url(#hub-glow)"></circle>

      <g fill="var(--color-accent)" stroke="var(--color-surface-container)" stroke-width="2">
        {spokes.map((n) => (
          <circle cx={n.x} cy={n.y} r="8" />
        ))}
      </g>
      <circle
        cx={hub.x}
        cy={hub.y}
        r="10"
        fill="var(--color-primary)"
        stroke="var(--color-surface-container)"
        stroke-width="2"
      ></circle>

      <g text-anchor="middle">
        {nodes.map((n) => (
          <text x={n.x} y={n.y + n.label}>
            {n.name}
          </text>
        ))}
      </g>
    </svg>
  </div>
</section>

<style>
  .band {
    padding-top: 7rem;
  }
  .panel {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem;
    background: var(--color-surface-container);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-xl);
  }
  .panel p {
    margin: 1rem 0 0;
    color: var(--color-on-surface-variant);
  }
  .nowrap {
    white-space: nowrap;
  }
  .counties {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }
  .counties li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    border-top: 1px solid var(--color-outline-variant);
    font-weight: 600;
  }
  .counties i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }
  .counties .hub i {
    background: var(--color-primary);
  }
  .map {
    display: block;
    width: 100%;
    height: auto;
  }
  .map text {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    fill: var(--color-on-surface);
    paint-order: stroke;
    stroke: var(--color-surface-container);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  @media (max-width: 1000px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 2rem;
    }
  }
  @media (max-width: 760px) {
    .band {
      padding-top: 4.5rem;
    }
    .panel {
      padding: 1.25rem;
      gap: 1.5rem;
    }
    .map text {
      font-size: 22px;
      stroke-width: 5px;
    }
  }
</style>
