{
  "name": "presentation-sites",
  "private": true,
  "description": "Monorepo of presentation/marketing sites. Each site under sites/ is its own npm workspace; shared helpers live in packages/. churchix/ is a separate project with its own workspaces and is not part of this one.",
  "scripts": {
    "saloon": "npm run --workspace ana-saloon",
    "saloon:dev": "npm run dev -w ana-saloon",
    "saloon:build": "npm run build -w ana-saloon",
    "saloon:preview": "npm run preview -w ana-saloon",
    "auto-service": "npm run --workspace bavauto-gorj",
    "auto-service:dev": "npm run dev -w bavauto-gorj",
    "auto-service:build": "npm run build -w bavauto-gorj",
    "auto-service:preview": "npm run preview -w bavauto-gorj",
    "subcort": "npm run --workspace subcort",
    "subcort:dev": "npm run dev -w subcort",
    "subcort:build": "npm run build -w subcort",
    "subcort:preview": "npm run preview -w subcort",
    "tractari": "npm run --workspace tractari",
    "tractari:dev": "npm run dev -w tractari",
    "tractari:build": "npm run build -w tractari",
    "tractari:preview": "npm run preview -w tractari",
    "design-study": "npm run --workspace design-study",
    "design-study:dev": "npm run dev -w design-study",
    "design-study:build": "npm run build -w design-study",
    "design-study:preview": "npm run preview -w design-study",
    "saloon:docs": "npm run docs -w @sites/saloon-docs",
    "auto-service:docs": "npm run docs -w @sites/auto-service-docs",
    "subcort:docs": "npm run docs -w @sites/subcort-docs",
    "tractari:docs": "npm run docs -w @sites/tractari-docs",
    "design-study:docs": "npm run docs -w @sites/design-study-docs",
    "saloon:build:mock": "npm run build:mock -w ana-saloon",
    "auto-service:build:mock": "npm run build:mock -w bavauto-gorj",
    "saloon:placeholders": "npm run placeholders -w ana-saloon",
    "auto-service:placeholders": "npm run placeholders -w bavauto-gorj",
    "design-study:placeholders": "npm run placeholders -w design-study",
    "subcort:og": "npm run og -w subcort",
    "saloon:bots": "npm --prefix sites/saloon/marketing/bots run check",
    "build": "npm run build --workspaces --if-present",
    "churchix": "npm --prefix churchix run",
    "churchix:install": "npm --prefix churchix install",
    "churchix:build": "npm --prefix churchix run build"
  },
  "workspaces": [
    "sites/*",
    "sites/*/docs-site",
    "packages/*"
  ]
}
