---
import { site, telLink, waLink } from "../content/site";
import { img } from "../content/images";

const heroImg = img("hero");
---

<section
  id="acasa"
  class="hero relative overflow-hidden bg-[var(--color-background)] text-[var(--color-on-surface)]"
>
  <!-- Workshop photo bleeds in from the right and dissolves into the floor.
       On the dark rebrand the photo isn't dimmed flat — a steel gradient masks
       it into the page so it reads as the bay seen from the doorway. -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src={heroImg}
      alt=""
      class="hero-photo h-full w-full object-cover"
      width="1600"
      height="2400"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-veil absolute inset-0"></div>
    <!-- A single blue "lift light" wash in the corner, like a worklamp. -->
    <div class="hero-glow absolute inset-0"></div>
  </div>

  <div class="container-page relative">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_auto] items-end gap-y-10">
      <div class="max-w-2xl pt-32 pb-14 md:pt-40 md:pb-24">
        <div class="reveal flex items-stretch gap-4">
          <span class="m-stripe--v" aria-hidden="true"></span>
          <div class="flex flex-col justify-center">
            <span class="kicker">Specialiști BMW &middot; Atelier de familie</span>
            <span class="mt-1 text-sm font-semibold text-[var(--color-on-surface-variant)]"
              >{site.city}, jud. {site.county}</span
            >
          </div>
        </div>

        <h1 class="reveal heading-xl mt-7">
          BMW-ul tău, în mâinile<br class="hidden sm:block" />
          <span class="hero-accent">unei familii de pasionați.</span>
        </h1>

        <p
          class="reveal mt-6 text-lg leading-relaxed text-[var(--color-on-surface-variant)] max-w-xl"
        >
          Diagnoză dedicată, lucrări făcute ca la carte și un deviz clar înainte
          să punem mâna pe mașină. Nu suntem dealer — suntem oamenii care chiar
          se pricep, în {site.city}.
        </p>

        <div class="reveal mt-9 flex flex-col sm:flex-row gap-3">
          <a href={telLink()} class="btn btn-primary btn-lg" data-cta="hero-call">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Sună: {site.phone}</span>
          </a>
          <a href={waLink()} target="_blank" rel="noopener" class="btn btn-outline btn-lg" data-cta="hero-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.24.68-1.42 1.32-1.95 1.36-.5.05-1.13.26-3.8-.8-3.2-1.26-5.26-4.5-5.42-4.71-.16-.21-1.3-1.73-1.3-3.3 0-1.57.82-2.34 1.11-2.66.29-.32.64-.4.85-.4.21 0 .43 0 .61.01.2.01.46-.07.72.55.27.64.92 2.2 1 2.36.08.16.13.35.03.56-.1.21-.16.34-.31.53-.16.18-.33.41-.47.55-.16.16-.32.33-.14.64.18.32.8 1.32 1.72 2.14 1.18 1.05 2.18 1.38 2.49 1.54.31.16.49.13.67-.08.18-.21.77-.9.98-1.21.21-.32.42-.26.71-.16.29.11 1.84.87 2.16 1.03.31.16.52.24.6.37.08.13.08.74-.16 1.42z"/>
            </svg>
            <span>Scrie pe WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- "Pit board" — the one honest measured number + the family framing,
           set as a small instrument panel on the right rail (stacks under the
           copy on mobile). We deliberately do NOT show a cars-repaired count. -->
      <aside class="reveal hero-board pb-14 md:pb-24" aria-label="Despre atelier">
        <dl class="grid grid-cols-2 lg:grid-cols-1 gap-px bg-[var(--color-outline-variant)] rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-outline-variant)]">
          <div class="hero-board__cell">
            <dt class="text-4xl font-display font-extrabold tabular-nums leading-none">{site.stats.years}</dt>
            <dd class="mt-1.5 text-sm text-[var(--color-on-surface-variant)]">ani, numai pe BMW</dd>
          </div>
          <div class="hero-board__cell">
            <dt class="flex items-center gap-2 text-xl font-display font-extrabold leading-none">
              <span class="hero-board__dot" aria-hidden="true"></span>
              Familie
            </dt>
            <dd class="mt-1.5 text-sm text-[var(--color-on-surface-variant)]">vorbești cu cine repară</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>

  <span class="m-stripe m-stripe--full absolute bottom-0 inset-x-0" aria-hidden="true"></span>

  <style>
    /* Floor at native height; the photo fills behind. Min-height keeps the
       composition tall enough to feel like an entrance, not a banner. */
    .hero { min-height: clamp(34rem, 88vh, 50rem); display: flex; align-items: stretch; }
    .hero > .container-page { width: 100%; align-self: center; }

    .hero-photo {
      opacity: 0.5;
      object-position: 70% center;
      filter: grayscale(0.15) contrast(1.02);
    }

    /* Steel gradient: opaque floor on the left where the headline sits, opening
       to a window onto the photo on the right. */
    .hero-veil {
      background:
        linear-gradient(
          100deg,
          var(--color-background) 0%,
          oklch(20% 0.022 256 / 0.92) 42%,
          oklch(20% 0.022 256 / 0.45) 78%,
          oklch(20% 0.022 256 / 0.2) 100%
        ),
        linear-gradient(
          to top,
          var(--color-background) 0%,
          oklch(20% 0.022 256 / 0) 28%
        );
    }
    /* A single corner worklamp glow — the brand blue as a lit lamp on the bay. */
    .hero-glow {
      background: radial-gradient(
        80% 60% at 88% 8%,
        oklch(58% 0.17 250 / 0.22) 0%,
        oklch(58% 0.17 250 / 0) 60%
      );
    }

    /* M-red on the second clause: the sanctioned enthusiast accent, carrying
       the "pasionați" energy. Stays a single solid colour (never gradient text). */
    .hero-accent { color: var(--color-m-red); }

    .hero-board__cell {
      background-color: var(--color-surface-container-lowest);
      padding: 1.1rem 1.25rem;
    }
    @media (min-width: 1024px) {
      .hero-board { width: 14.5rem; }
      .hero-board__cell { padding: 1.25rem 1.4rem; }
    }
    .hero-board__dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: var(--radius-full);
      background-color: var(--color-m-red);
      box-shadow: 0 0 8px 0 oklch(60% 0.22 27 / 0.7);
      flex: none;
    }
  </style>
</section>
