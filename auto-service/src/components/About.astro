---
import { site } from "../content/site";
import { img } from "../content/images";

// Until a real BavAuto team photo exists, we do NOT show a stock photo of
// strangers under an "our family" claim — that would break the trust the section
// is built on. We lead instead with the verified BMW engine shot (real marque,
// real work) and keep the alt honest. Swap to a true BavAuto team photo when one
// is shot, then restore a team-framed alt.
const portrait = img("gallery-03");

// `bare` drops the in-section <h2> + intro paragraphs' duplicate framing when
// the page's PageHeader already carries the title. The body copy stays; only
// the heading is suppressed so h1/h2 don't echo.
interface Props {
  bare?: boolean;
}
const { bare = false } = Astro.props;
---

<section id="despre" class="section bg-[var(--color-surface-container-lowest)] border-y border-[var(--color-outline-variant)]">
  <div class="container-page grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div class="reveal order-2 lg:order-1">
      {
        !bare && (
          <>
            <h2 class="heading-lg">O familie, o pasiune: BMW</h2>
            <span class="m-stripe mt-5" aria-hidden="true" />
          </>
        )
      }
      <div class:list={["space-y-4 text-[1.02rem] leading-relaxed text-[var(--color-on-surface-variant)]", bare ? "mt-0" : "mt-7"]}>
        <p>
          {site.name} e un atelier mic, de familie, din {site.city}. Suntem
          câțiva oameni care reparăm BMW-uri de ani buni, pentru că asta ne place
          cu adevărat să facem, nu pentru că „a ieșit așa”.
        </p>
        <p>
          Tocmai pentru că suntem puțini, fiecare mașină trece prin mâini pe care
          le cunoști. Îți explicăm pe înțeles ce are, îți dăm un deviz corect și
          îți spunem sincer când o lucrare nu merită banii.
        </p>
        <p>
          Suntem un atelier <strong class="text-[var(--color-on-surface)] font-semibold">independent</strong>:
          nu suntem dealer și nu avem nicio legătură cu BMW AG. Suntem doar niște
          pasionați care îți tratează mașina ca pe a noastră.
        </p>
      </div>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-5">
        <div>
          <dt class="font-display text-3xl font-extrabold text-[var(--color-primary)]">{site.stats.years} ani</dt>
          <dd class="text-sm text-[var(--color-on-surface-variant)] mt-1">de experiență, numai pe BMW</dd>
        </div>
        <div>
          <dt class="font-display text-3xl font-extrabold text-[var(--color-primary)]">{site.stats.family} oameni</dt>
          <dd class="text-sm text-[var(--color-on-surface-variant)] mt-1">aceeași familie, aceleași mâini</dd>
        </div>
      </dl>
    </div>

    <div class="reveal order-1 lg:order-2">
      <figure class="about-photo relative">
        <img
          src={portrait}
          alt="Motor BMW M deschis în atelierul BavAuto Gorj"
          class="w-full rounded-xl object-cover aspect-[4/3]"
          loading="lazy"
          decoding="async"
        />
        <span class="m-stripe m-stripe--full absolute bottom-0 left-0 rounded-b-xl" aria-hidden="true"></span>
      </figure>
    </div>
  </div>

  <style>
    /* The image reads as a lit panel on the dark floor: a hairline frame plus a
       soft drop so it sits above the graphite, not flush with it. */
    .about-photo {
      border-radius: var(--radius-xl);
      box-shadow:
        0 0 0 1px var(--color-outline-variant),
        0 24px 60px -28px oklch(8% 0.02 257 / 0.9);
    }
    .about-photo img { display: block; }
  </style>
</section>
