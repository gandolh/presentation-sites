---
// Self-hosted fonts (no Google Fonts CDN). Two mono faces on a contrast axis:
// VT323 (bitmap CRT display) for the handle/headers, Fragment Mono (clean
// humanist mono) for all readable body/log/tile text.
import "@fontsource/vt323/400.css";
import "@fontsource/fragment-mono/400.css";
import "../styles/global.css";
import { withBase } from "../content/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "gandolh — i build what i think it's fun. I'm a hobyist",
  description =
    "A gallery of personal projects",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="crt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1c22" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />

    <script is:inline>
      // One-time boot reveal: print the .boot lines in sequence. The default
      // (no-JS / reduced-motion) state is fully visible, so this only ever
      // ENHANCES — it never gates content behind a class that might not fire.
      (function () {
        var reduced =
          typeof matchMedia === "function" &&
          matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) return;

        var root = document.documentElement;
        root.classList.add("booting");

        var lines = Array.prototype.slice.call(
          document.querySelectorAll(".boot"),
        );
        if (!lines.length) {
          root.classList.remove("booting");
          return;
        }

        var i = 0;
        function light() {
          if (i < lines.length) {
            lines[i].classList.add("lit");
            i++;
            // Faster cadence once we reach the project rows so the gallery
            // doesn't feel slow to "take its time" on every single tile.
            var delay = i < 4 ? 220 : 90;
            window.setTimeout(light, delay);
          } else {
            root.classList.remove("booting");
          }
        }
        // Kick off after first paint so the hidden state is applied first.
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(light);
        });

        // Safety net: if anything stalls, reveal everything after 4s.
        window.setTimeout(function () {
          lines.forEach(function (el) { el.classList.add("lit"); });
          root.classList.remove("booting");
        }, 4000);
      })();
    </script>
  </body>
</html>
