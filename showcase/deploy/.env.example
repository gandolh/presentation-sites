SSH_HOST=<alias>
BASE_PATH=/showcase

# Origin of the sibling live sites on this same VPS, baked into the tile links
# at build time (e.g. http://203.0.113.5). Optional — if omitted, the tiles use
# same-origin relative links (/saloon, /tractari, ...), which resolve correctly
# when the showcase is viewed on the VPS itself.
PUBLIC_SITES_HOST=<http://HOST>

# Absolute dir on the server that Caddy serves for this project.
REMOTE_DIR=<REMOTE_DIR>

# Public URL shown on success (informational only).
PUBLIC_URL=<PUBLIC_URL>

REMOTE_CADDYFILE=<Caddy_dir>

# Sudo handling on the server for the pre-deploy/deploy steps:
#   SUDO_NOPASSWD=true  → run sudo directly (passwordless sudo configured).
#   SUDO_ASKPASS=true   → prompt for the sudo password and pipe it to `sudo -S`.
#   both false          → print the sudo command for you to run by hand.
SUDO_NOPASSWD=false
SUDO_ASKPASS=false
