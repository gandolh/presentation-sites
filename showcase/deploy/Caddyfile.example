# Caddyfile template for the shared side-projects VPS.
#
# The real `Caddyfile` is git-ignored (server-specific). Copy this to
# `deploy/Caddyfile` and adjust, then let `npm run deploy:pre` upload + validate
# it, or install manually at /etc/caddy/Caddyfile and:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# This VPS already hosts `saloon` (/saloon), `auto-service` (/auto-service),
# `subcort` (/subcort) and `tractari` (/tractari). ADD the showcase block to the
# SAME `:80 { ... }` server block on the server — don't ship a second server
# block that would conflict. The block below is the piece to add.
#
# handle_path STRIPS the matched prefix before serving, so files live at the
# root of the project's dir (e.g. /var/www/showcase/index.html), matching the
# PUBLIC_BASE=/showcase build.

:80 {
	# --- Ana Saloon -> http://<ip>/saloon (existing) ----------------------
	handle_path /saloon/* {
		root * /var/www/saloon
		try_files {path} {path}/ {path}.html
		file_server
	}

	# --- BavAuto Gorj -> http://<ip>/auto-service (existing) --------------
	handle_path /auto-service/* {
		root * /var/www/auto-service
		try_files {path} {path}/ {path}.html
		file_server
	}

	# --- Subcort -> http://<ip>/subcort (existing) ------------------------
	handle_path /subcort/* {
		root * /var/www/subcort
		try_files {path} {path}/ {path}.html
		file_server
	}

	# --- AXA Tractări -> http://<ip>/tractari (existing) ------------------
	redir /tractari /tractari/ 308
	handle_path /tractari/* {
		root * /var/www/tractari
		try_files {path} {path}/ {path}.html
		file_server
	}

	# --- showcase -> http://<ip>/showcase --------------------------------
	# Bare "/showcase" (no trailing slash) doesn't match the /showcase/*
	# matcher below, so redirect it to the canonical trailing-slash URL.
	redir /showcase /showcase/ 308
	handle_path /showcase/* {
		root * /var/www/showcase
		# Static site: serve the file, then dir index, then the pretty-URL
		# .html, else 404. Matches Astro's default output.
		try_files {path} {path}/ {path}.html
		file_server
	}

	# Anything not matched above (e.g. bare "/") → simple landing/404.
	handle {
		respond "Nothing here. Try /saloon, /auto-service, /subcort, /tractari or /showcase" 404
	}
}
