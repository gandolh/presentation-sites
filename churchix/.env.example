# Deploy configuration for scripts/deploy.ts — copy to .env and fill in.
# Loaded via Node's native --env-file (no dependencies). All values are strings.

# --- target server ---
# SSH host. Either an alias from ~/.ssh/config or user@host. `ssh "$SSH_HOST"` must work.
SSH_HOST=your-server

# Absolute path on the server where static sites are published, one dir per app.
WEBROOT=/var/www

# Absolute path to the Caddyfile on the server (used by `pre-deploy` to add a route).
CADDYFILE=/etc/caddy/Caddyfile

# Server user:group that should own the published files (web server user).
WEB_OWNER=caddy:caddy

# --- app ---
# Workspace under apps/ to build and deploy.
APP_SLUG=your-app

# URL sub-path the app is served under (http://<server>/<URL_PATH>/).
# Leave equal to APP_SLUG unless you serve it elsewhere; set to "" to serve at root.
URL_PATH=your-app
