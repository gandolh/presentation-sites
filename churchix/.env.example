# Deploy configuration for scripts/deploy.ts — copy to .env and fill in.
# Loaded via Node's native --env-file (no dependencies). All values are strings.
# Shared schema with the other sites in this monorepo (see any sibling deploy/.env).

# SSH host. Either an alias from ~/.ssh/config or user@host. `ssh "$SSH_HOST"` must work.
SSH_HOST=<alias>
# Optional explicit identity file (e.g. ~/.ssh/hetzner_vps).
SSH_KEY=

# URL sub-path the app is served under (http://<server>/<BASE_PATH>/). "/" = root.
BASE_PATH=/churchix

# Absolute dir on the server that Caddy serves for this project.
REMOTE_DIR=<REMOTE_DIR>

# Public URL shown on success (informational only).
PUBLIC_URL=<PUBLIC_URL>

REMOTE_CADDYFILE=/etc/caddy/Caddyfile

# Sudo handling on the server for the pre-deploy/deploy steps:
#   SUDO_NOPASSWD=true  → run sudo directly (passwordless sudo configured).
#   SUDO_ASKPASS=true   → prompt for the sudo password and pipe it to `sudo -S`.
#   both false          → print the sudo command for you to run by hand.
SUDO_NOPASSWD=false
SUDO_ASKPASS=false

# --- churchix-specific ---
# Workspace under apps/ to build and deploy.
APP_SLUG=<app-slug>
# Server user:group that should own the published files (web server user).
WEB_OWNER=caddy:caddy
