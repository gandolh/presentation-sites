{
  "name": "churchix",
  "version": "0.0.0",
  "private": true,
  "description": "White-label, multi-church presentation-website + giving platform (Astro + React frontend, Fastify API).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "docs-site"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "echo \"Run a specific workspace, e.g. npm run dev -w apps/<church>\" && exit 1",
    "dev:bac": "npm run dev -w apps/parohia-harlesti-bacau",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
