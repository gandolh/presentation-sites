---
import { getCollection } from "astro:content";
import BaseLayout from "@churchix/ui/layouts/BaseLayout.astro";
import PageShell from "@churchix/ui/components/PageShell.astro";
import GivingChannels from "@churchix/ui/components/GivingChannels.astro";
import { getSite } from "../lib/site.ts";

const site = await getSite();

// Pick the featured project for the right column: first active campaign by `order`.
const campaigns = (await getCollection("campaigns")).map((e) => e.data).sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const featured = campaigns.find((c) => c.status === "active") ?? campaigns[0];
const showCampaign = site.features.campaigns && Boolean(featured);
---

<BaseLayout site={site} title="Donează" path="/donatii">
  <PageShell
    title="Sprijină parohia"
    lede="Orice dar, mic sau mare, ne ajută în lucrarea liturgică și social-filantropică."
  >
    <GivingChannels giving={site.giving} campaign={featured} showCampaign={showCampaign} />
  </PageShell>
</BaseLayout>
