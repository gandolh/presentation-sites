---
import { getCollection } from "astro:content";
import BaseLayout from "@churchix/ui/layouts/BaseLayout.astro";
import Hero from "@churchix/ui/components/Hero.astro";
import EmptyState from "@churchix/ui/components/EmptyState.astro";
import Card from "@churchix/ui/components/Card.astro";
import Badge from "@churchix/ui/components/Badge.astro";
import Icon from "@churchix/ui/components/Icon.astro";
import { withBase } from "@churchix/ui/lib/base.ts";
import { getSite } from "../lib/site.ts";

const site = await getSite();

// ── Schedule → compact "this week" timeline rows for the hero ─────────────────
const schedule = (await getCollection("schedule")).map((e) => e.data);

const WEEKDAY_ABBR_RO: Record<string, string> = {
  mon: "Lun",
  tue: "Mar",
  wed: "Mie",
  thu: "Joi",
  fri: "Vin",
  sat: "Sâm",
  sun: "Dum",
};
const WEEK_ORDER = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] as const;

// Weekly services, ordered Mon→Sun then by time, for the hero timeline.
const weekly = schedule
  .filter((s) => s.weekday)
  .sort((a, b) => {
    const d =
      WEEK_ORDER.indexOf(a.weekday as (typeof WEEK_ORDER)[number]) -
      WEEK_ORDER.indexOf(b.weekday as (typeof WEEK_ORDER)[number]);
    return d !== 0 ? d : a.time.localeCompare(b.time);
  });

const weekRows = weekly.map((s) => ({
  day: WEEKDAY_ABBR_RO[s.weekday as string] ?? "",
  time: s.time,
  label: s.label,
  highlight: s.weekday === "sun",
}));

// ── Hero "next service": soonest weekly service from today onward ─────────────
const NOW_WEEKDAY = WEEK_ORDER[(new Date().getDay() + 6) % 7] ?? "mon";
const WEEKDAY_RO: Record<string, string> = {
  mon: "Luni",
  tue: "Marți",
  wed: "Miercuri",
  thu: "Joi",
  fri: "Vineri",
  sat: "Sâmbătă",
  sun: "Duminică",
};
const nextSvc =
  weekly.find((s) => WEEK_ORDER.indexOf(s.weekday as (typeof WEEK_ORDER)[number]) >= WEEK_ORDER.indexOf(NOW_WEEKDAY)) ??
  weekly[0];
const next = nextSvc
  ? { label: nextSvc.label, day: WEEKDAY_RO[nextSvc.weekday as string] ?? "", time: nextSvc.time }
  : undefined;

// ── Announcements → asymmetric lead + stacked ─────────────────────────────────
const fmtDate = new Intl.DateTimeFormat("ro-RO", { day: "numeric", month: "short", year: "numeric" });
const anunturi = (await getCollection("announcements"))
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => {
    if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
    return b.date.getTime() - a.date.getTime();
  })
  .slice(0, 4);
const lead = anunturi[0];
const rest = anunturi.slice(1, 4);
const account = site.giving?.ibans?.[0];
---

<BaseLayout site={site} description={site.tagline} path="/">
  <Hero
    title={site.name}
    subtitle="Biserica Ortodoxă Română"
    image={site.brand.ogImage}
    next={next}
    week={weekRows}
    weekHref="/program"
    giving={site.features.giving}
    account={account}
    ctaLabel="Sprijinește parohia"
    ctaHref="/donatii"
  />

  <!-- ── Anunțuri: the news tray, white cards, the pinned lead first ─────────── -->
  <section class="mt-10 bg-surface-container py-10 min-[960px]:mt-14 min-[960px]:py-14">
    <div class="mx-auto w-full max-w-container-max px-4 min-[960px]:px-6">
      <div class="mb-7 flex items-end justify-between gap-4">
        <div>
          <h2 class="m-0 font-headline-lg text-headline-lg-mobile text-primary min-[960px]:text-headline-lg">
            Anunțuri
          </h2>
          <p class="m-0 mt-1 font-body-md text-body-md text-on-surface-variant">Din viața parohiei</p>
        </div>
        <a
          href={withBase("/anunturi")}
          class="inline-flex min-h-11 shrink-0 items-center rounded font-body-md text-body-md font-semibold text-primary underline decoration-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container"
        >
          Vezi toate
        </a>
      </div>

      {anunturi.length > 0 ? (
        <div class="grid grid-cols-1 items-start gap-4 min-[960px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] min-[960px]:gap-6">
          {lead && (
            <Card
              as="article"
              radius="lg"
              padding="none"
              elevation="sm"
              featured={!!lead.pinned}
              class="p-5 min-[960px]:p-7"
            >
              {!lead.pinned && (
                <p class="m-0 mb-2 flex items-center gap-2 font-label-md text-label-md font-normal text-on-surface-variant">
                  <Icon name="event" size={16} />
                  {fmtDate.format(lead.date)}
                </p>
              )}
              <h3 class="mb-2 text-balance font-headline-md text-[22px] font-bold leading-7 text-on-surface min-[960px]:text-headline-md min-[960px]:leading-8">
                {lead.title}
              </h3>
              {lead.summary && (
                <p class="m-0 mb-1 line-clamp-3 font-body-md text-body-md text-on-surface-variant">{lead.summary}</p>
              )}
              <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
                <a
                  href={withBase(`/anunturi/${lead.slug}`)}
                  class="inline-flex min-h-11 items-center rounded font-body-md text-body-md font-semibold text-primary underline decoration-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
                >
                  Citește
                </a>
                {lead.pinned && (
                  <Badge tone="secondary" icon="push_pin">
                    Fixat
                  </Badge>
                )}
              </div>
            </Card>
          )}

          {rest.length > 0 && (
            <div class="flex flex-col gap-4 min-[960px]:gap-6">
              {rest.map((a) => (
                <Card
                  as="article"
                  href={withBase(`/anunturi/${a.slug}`)}
                  radius="lg"
                  padding="none"
                  elevation="sm"
                  class="group p-5 min-[960px]:p-7"
                >
                  <span class="m-0 flex items-center gap-2 font-label-md text-label-md font-normal text-on-surface-variant">
                    <Icon name="event" size={16} />
                    {fmtDate.format(a.date)}
                  </span>
                  <h3 class="mt-2 text-balance font-headline-md text-[22px] font-bold leading-7 text-on-surface min-[960px]:text-headline-md min-[960px]:leading-8">
                    {a.title}
                  </h3>
                </Card>
              ))}
            </div>
          )}
        </div>
      ) : (
        <EmptyState
          as="h3"
          icon="campaign"
          title="Niciun anunț momentan"
          message="Reveniți curând pentru noutățile parohiei."
        />
      )}
    </div>
  </section>

  <!-- ── Despre: plain text beside a facts card ──────────────────────────────── -->
  <section class="py-12 min-[960px]:py-16">
    <div class="mx-auto w-full max-w-container-max px-4 min-[960px]:px-6">
      <h2 class="m-0 mb-7 font-headline-lg text-headline-lg-mobile text-primary min-[960px]:text-headline-lg">
        Despre parohia noastră
      </h2>
      <div class="grid grid-cols-1 items-start gap-5 min-[960px]:grid-cols-2 min-[960px]:gap-12">
        <div>
          <h3 class="m-0 font-headline-md text-headline-md text-primary">Un spațiu al păcii și al regăsirii</h3>
          <p class="mt-3 max-w-[46ch] font-body-md text-body-md text-on-surface-variant">
            {site.tagline ?? "Vă invităm să luați parte la sfintele slujbe și la viața comunității noastre parohiale."}
          </p>
          <a
            href={withBase("/despre")}
            class="mt-2 inline-flex min-h-11 items-center rounded font-body-md text-body-md font-semibold text-primary underline decoration-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          >
            Citește istoricul
          </a>
        </div>

        <Card padding="none" radius="lg" class="px-6 pb-2 pt-4">
          <ul class="m-0 list-none p-0">
            <li class="flex items-start gap-4 py-4">
              <Icon name="church" fill size={22} class="mt-0.5 text-secondary-strong" />
              <div>
                <p class="m-0 font-label-md text-label-md text-on-surface-variant">Hram</p>
                <p class="m-0 font-body-md text-body-md text-on-surface">
                  <span class="block">Sfinții Trei Ierarhi</span>
                  <span class="block">30 ianuarie</span>
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4 border-t border-outline-variant py-4">
              <Icon name="account_balance" size={22} class="mt-0.5 text-secondary-strong" />
              <div>
                <p class="m-0 font-label-md text-label-md text-on-surface-variant">Eparhie</p>
                <p class="m-0 font-body-md text-body-md text-on-surface">Arhiepiscopia Romanului și Bacăului</p>
              </div>
            </li>
            <li class="flex items-start gap-4 border-t border-outline-variant py-4">
              <Icon name="schedule" size={22} class="mt-0.5 text-secondary-strong" />
              <div>
                <p class="m-0 font-label-md text-label-md text-on-surface-variant">Sfânta Liturghie</p>
                <p class="m-0 font-body-md text-body-md text-on-surface">Duminica, ora 09:30</p>
              </div>
            </li>
          </ul>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
