---
import { getCollection } from "astro:content";
import BaseLayout from "@churchix/ui/layouts/BaseLayout.astro";
import PageShell from "@churchix/ui/components/PageShell.astro";
import Card from "@churchix/ui/components/Card.astro";
import Icon from "@churchix/ui/components/Icon.astro";
import { getSite } from "../lib/site.ts";

const site = await getSite();

// Leadership, ordered by `staff.order`. Optional collection — empty/absent is fine.
const staff = (await getCollection("staff")).map((e) => e.data).sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

<BaseLayout site={site} title="Despre parohie" path="/despre">
  <PageShell
    title="Despre parohia noastră"
    lede="Biserica „Sfinții Trei Ierarhi” din Hârlești — o scurtă istorie a comunității."
  >
    <Card padding="none" radius="lg" elevation="board" class="px-5 py-6 min-[960px]:px-8 min-[960px]:py-8">
      <article class="cx-prose max-w-[46rem] font-body-lg text-body-lg text-on-surface">
        <p>
          Biserica „Sfinții Trei Ierarhi” din satul Hârlești, comuna Filipești, județul Bacău, a fost ridicată în anul
          1846. Parohia a primit statut de sine stătător în anul 2002, fiind anterior filie a unei parohii învecinate.
        </p>
        <p>
          În urma lucrărilor de restaurare, biserica a fost resfințită în anul 2012. Parohia aparține de Arhiepiscopia
          Romanului și Bacăului, Protopopiatul Bacău.
        </p>
        <h2>Hramul</h2>
        <p>Sfinții Trei Ierarhi: Vasile cel Mare, Grigorie Teologul și Ioan Gură de Aur — prăznuiți pe 30 ianuarie.</p>
      </article>
    </Card>
    {staff.length > 0 && (
      <div class="mt-10 min-[960px]:mt-12">
        <h2 class="m-0 font-headline-md text-[28px] font-bold leading-9 text-primary">Conducerea parohiei</h2>
        <p class="m-0 mt-1 font-body-md text-body-md text-on-surface-variant">Slujitorii parohiei</p>
        <ul class="m-0 mt-5 grid list-none grid-cols-1 gap-4 p-0 min-[960px]:grid-cols-2 min-[960px]:gap-6">
          {staff.map((p) => (
            <Card as="li" padding="none" radius="lg" class="flex flex-col gap-4 p-5 min-[960px]:p-7">
              <div class="flex items-start gap-4">
                <span
                  class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-surface-container text-primary"
                  aria-hidden="true"
                >
                  <Icon name="person" size={24} />
                </span>
                <div class="min-w-0">
                  <p class="m-0 font-headline-md text-headline-md font-bold text-on-surface">{p.name}</p>
                  <p class="m-0 mt-1 font-label-md text-label-md text-on-surface-variant">{p.role}</p>
                </div>
              </div>
              {p.bio && <p class="m-0 font-body-md text-body-md text-on-surface-variant">{p.bio}</p>}
            </Card>
          ))}
        </ul>
      </div>
    )}
  </PageShell>
</BaseLayout>
<style>
  /* Readable, diacritic-safe prose — mirrors the announcement detail prose so the
     two long-form pages feel identical. Generous line-height keeps stacked
     diacritics (ă â î ș ț) legible; color comes from M3 tokens (re-skins per church). */
  .cx-prose {
    line-height: 1.75;
  }
  .cx-prose :global(p) {
    margin: 0 0 1rem;
  }
  .cx-prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .cx-prose :global(h2) {
    font-family: var(--font-headline-md);
    font-size: var(--text-headline-md);
    color: var(--primary);
    line-height: 1.3;
    margin: 1.75rem 0 0.75rem;
  }
</style>
