---
import BaseLayout from "@churchix/ui/layouts/BaseLayout.astro";
import PageShell from "@churchix/ui/components/PageShell.astro";
import Card from "@churchix/ui/components/Card.astro";
import Field from "@churchix/ui/components/Field.astro";
import Button from "@churchix/ui/components/Button.astro";
import Icon from "@churchix/ui/components/Icon.astro";
import { getSite } from "../lib/site.ts";

const site = await getSite();
const c = site.contact;

// Static, server-light prayer-request form. With no backend, we fall back to a
// `mailto:` submit so the page works on a pure SSG host (PCI/independence-safe).
// The church email seeds the recipient; if absent the form is omitted gracefully.
const prayerMailto = c.email ? `mailto:${c.email}?subject=${encodeURIComponent("Cerere de rugăciune")}` : undefined;
---

<BaseLayout site={site} title="Contact" path="/contact">
  <PageShell title="Contact" lede="Vă așteptăm la biserică și vă stăm la dispoziție pentru orice întrebare.">
    <div class="grid grid-cols-1 items-stretch gap-4 min-[960px]:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] min-[960px]:gap-6">
      <!-- Coordonate parohie -->
      <Card padding="none" radius="lg" elevation="board" class="p-5 min-[960px]:px-8 min-[960px]:py-7">
        <h2 class="m-0 mb-5 font-headline-md text-headline-md text-primary">Datele parohiei</h2>
        <dl class="m-0 flex flex-col gap-5 font-body-md text-body-md text-on-surface">
          <div class="flex items-start gap-4">
            <Icon name="church" size={22} class="mt-0.5 shrink-0 text-secondary-strong" />
            <div>
              <dt class="font-label-md text-label-md text-on-surface-variant">Adresă</dt>
              <dd class="m-0">
                {c.address}
                <br />
                {c.city}, {c.country}
              </dd>
            </div>
          </div>
          {c.phone && (
            <div class="flex items-start gap-4">
              <Icon name="sms" size={22} class="mt-0.5 shrink-0 text-secondary-strong" />
              <div>
                <dt class="font-label-md text-label-md text-on-surface-variant">Telefon</dt>
                <dd class="m-0">
                  <a
                    class="inline-flex min-h-11 items-center rounded font-semibold text-primary underline decoration-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
                    href={`tel:${c.phone.replace(/\s+/g, "")}`}
                  >
                    {c.phone}
                  </a>
                </dd>
              </div>
            </div>
          )}
          {c.email && (
            <div class="flex items-start gap-4">
              <Icon name="send" size={22} class="mt-0.5 shrink-0 text-secondary-strong" />
              <div>
                <dt class="font-label-md text-label-md text-on-surface-variant">Email</dt>
                <dd class="m-0">
                  <a
                    class="inline-flex min-h-11 items-center break-all rounded font-semibold text-primary underline decoration-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
                    href={`mailto:${c.email}`}
                  >
                    {c.email}
                  </a>
                </dd>
              </div>
            </div>
          )}
        </dl>
      </Card>

      <!-- Hartă -->
      {c.mapEmbedUrl && (
        <Card padding="none" radius="lg" elevation="board" class="min-h-[320px]">
          <iframe
            class="block h-[320px] min-h-[320px] w-full border-0 min-[960px]:h-full"
            src={c.mapEmbedUrl}
            title={`Hartă — ${site.name}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </Card>
      )}
    </div>

    <!-- Cerere de rugăciune -->
    <div class="mt-10 max-w-2xl min-[960px]:mt-12">
      <h2 class="m-0 mb-2 flex items-center gap-3 font-headline-md text-[28px] font-bold leading-9 text-primary">
        <Icon name="candle" class="text-secondary-strong" size={26} />
        Cerere de rugăciune
      </h2>
      <p class="m-0 mb-5 font-body-md text-body-md text-on-surface-variant">
        Ne puteți trimite o cerere de rugăciune sau un mesaj. Vom reveni cu un răspuns cât mai curând.
      </p>
      <Card padding="none" radius="lg" elevation="board" class="p-5 min-[960px]:p-8">
        {prayerMailto && (
          <p class="m-0 mb-5 font-body-md text-body-md text-on-surface-variant">
            Apăsând „Trimite mesajul" se va deschide aplicația dvs. de email cu mesajul completat, gata de trimis.
          </p>
        )}
        <form
          id="cx-contact-form"
          class="flex flex-col gap-4"
          action={prayerMailto}
          method={prayerMailto ? undefined : "post"}
        >
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Field label="Nume" name="nume" autocomplete="name" required />
            <Field label="Email" name="email" type="email" autocomplete="email" />
          </div>
          <Field
            as="textarea"
            label="Mesajul dvs."
            name="mesaj"
            rows={5}
            required
            hint="Vă rugăm să nu includeți date sensibile (CNP, date bancare)."
          />
          <div>
            <Button type="submit" variant="primary" shape="rounded" trailingIcon="send">
              Trimite mesajul
            </Button>
          </div>
        </form>
        <div
          id="cx-contact-sent"
          tabindex="-1"
          class="mt-5 hidden rounded bg-secondary-container p-4 font-body-md text-body-md text-on-secondary-container"
          role="status"
          aria-live="polite"
        >
          Aplicația dvs. de email s-a deschis cu mesajul completat. Verificați și apăsați „Trimite" în email pentru a
          finaliza trimiterea. Mulțumim!
        </div>
      </Card>
      {prayerMailto && <script is:inline>
        (function () {
          const form = document.getElementById("cx-contact-form");
          const confirmation = document.getElementById("cx-contact-sent");
          if (!form || !confirmation) return;
          form.addEventListener("submit", function () {
            // mailto: opens the mail client; after a brief delay show the confirmation
            // so the user knows what happened (especially important for older users).
            setTimeout(function () {
              confirmation.classList.remove("hidden");
              form.setAttribute("aria-hidden", "true");
              confirmation.focus();
            }, 500);
          });
        })();
      </script>}
    </div>
  </PageShell>
</BaseLayout>
