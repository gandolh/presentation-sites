---
import { getCollection, render } from "astro:content";
import BaseLayout from "@churchix/ui/layouts/BaseLayout.astro";
import PageShell from "@churchix/ui/components/PageShell.astro";
import Card from "@churchix/ui/components/Card.astro";
import Badge from "@churchix/ui/components/Badge.astro";
import Icon from "@churchix/ui/components/Icon.astro";
import { withBase } from "@churchix/ui/lib/base.ts";
import { getSite } from "../../lib/site.ts";

export async function getStaticPaths() {
  const items = await getCollection("announcements");
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const site = await getSite();
const locale = `${site.defaultLocale ?? "ro"}-RO`;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout site={site} title={entry.data.title} path={`/anunturi/${entry.id}`}>
  <PageShell title={entry.data.title}>
    <Card as="article" padding="none" radius="lg" elevation="board" class="px-5 py-6 min-[960px]:px-8 min-[960px]:py-8">
      <div class="max-w-[46rem]">
        <div class="mb-5 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 font-label-md text-label-md font-normal text-on-surface-variant">
            <Icon name="event" size={16} />
            <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
          </span>
          {entry.data.pinned && (
            <Badge tone="secondary" icon="push_pin">
              Fixat
            </Badge>
          )}
        </div>
        <div class="cx-prose font-body-lg text-body-lg text-on-surface">
          <Content />
        </div>
        <a
          href={withBase("/anunturi")}
          class="mt-6 inline-flex min-h-11 items-center gap-2 rounded font-body-md text-body-md font-semibold text-primary underline decoration-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
        >
          <Icon name="arrow_forward" size={18} class="rotate-180" />
          Înapoi la anunțuri
        </a>
      </div>
    </Card>
  </PageShell>
</BaseLayout>
<style>
  /* Readable, diacritic-safe prose using body tokens. Generous line-height keeps
     stacked diacritics (ă â î ș ț) legible; spacing comes from the rhythm tokens. */
  .cx-prose {
    line-height: 1.75;
  }
  .cx-prose :global(p) {
    margin: 0 0 1rem;
  }
  .cx-prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .cx-prose :global(h2),
  .cx-prose :global(h3) {
    font-family: var(--font-headline-md);
    color: var(--primary);
    line-height: 1.3;
    margin: 1.75rem 0 0.75rem;
  }
  .cx-prose :global(h2) {
    font-size: var(--text-headline-md);
  }
  .cx-prose :global(h3) {
    font-size: 1.25rem;
  }
  .cx-prose :global(ul),
  .cx-prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .cx-prose :global(li) {
    margin: 0.35rem 0;
  }
  .cx-prose :global(a) {
    color: var(--primary);
    text-underline-offset: 2px;
  }
  .cx-prose :global(blockquote) {
    position: relative;
    margin: 1.25rem 0;
    padding-left: 1.75rem;
    border-left: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
    font-style: italic;
  }
  /* Decorative gold opening-quote glyph — the brand glint, not a colored side-stripe. */
  .cx-prose :global(blockquote)::before {
    content: "\201C";
    position: absolute;
    left: 0.25rem;
    top: -0.15em;
    font-family: var(--font-heading);
    font-size: 1.6em;
    line-height: 1;
    color: var(--secondary-strong);
  }
  .cx-prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
</style>
