---
import BaseLayout from "@churchix/ui/layouts/BaseLayout.astro";
import PageShell from "@churchix/ui/components/PageShell.astro";
import EmptyState from "@churchix/ui/components/EmptyState.astro";
import Button from "@churchix/ui/components/Button.astro";
import PomelnicForm from "@churchix/ui/islands/PomelnicForm.tsx";
import { withBase } from "@churchix/ui/lib/base.ts";
import { getSite } from "../lib/site.ts";

const site = await getSite();
const endpoint = site.giving?.pomelniceEndpoint || undefined;
const currency = site.giving?.currency ?? "RON";
const enabled = site.features.pomelnice;
---

<BaseLayout site={site} title="Pomelnice" path="/pomelnice">
  {enabled ? (
    <PageShell
      title="Trimite un pomelnic"
      lede="Numele pentru cei vii și pentru cei adormiți vor fi pomenite la Sfânta Liturghie."
    >
      <PomelnicForm client:visible endpoint={endpoint} currency={currency} />
    </PageShell>
  ) : (
    <PageShell title="Pomelnice">
      <EmptyState
        as="h2"
        icon="candle"
        title="Pomelnice indisponibile"
        message="Trimiterea pomelnicelor online nu este activată pentru această parohie."
        class="shadow-board"
      >
        <Button slot="cta" href={withBase("/contact")} variant="secondary" shape="rounded">
          Contactați parohia
        </Button>
      </EmptyState>
    </PageShell>
  )}
</BaseLayout>
