    "./islands/*": "./src/islands/*",
    "./lib/*": "./src/lib/*"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@churchix/schemas": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/cardo": "^5.3.0"
  }
}
