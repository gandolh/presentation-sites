{
  "name": "@churchix/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Astro + React components, layouts, islands and design tokens for Churchix church sites. No per-church values.",
  "type": "module",
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./styles/*": "./src/styles/*",
    "./layouts/*": "./src/layouts/*",
