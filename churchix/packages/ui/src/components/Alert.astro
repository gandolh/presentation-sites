---
/**
 * `<Alert>` — inline status message (Ecclesia Digitalis).
 *
 * Tonal surface + leading icon + message. `error` uses the M3 error roles;
 * `info`/`success` use tonal primary/tertiary surfaces with AA-safe text.
 * Re-skins via tokens.
 *
 * @prop {'info'|'success'|'error'} [tone='info']
 *        info    = `primary-container`-tint surface + `on-primary-container` text.
 *        success = `secondary-container`-tint surface + dark `on-secondary-container` text.
 *        error   = `error-container` surface + `on-error-container` text.
 * @prop {string} [title]   Optional bold heading line (`text-label-md`).
 * @prop {IconName} [icon]  Override the default per-tone icon.
 * @prop {string} [role]    ARIA role — defaults to `alert` for error, `status` otherwise.
 * @prop {string} [class]   Extra classes appended last.
 *
 * @slot default — the message body.
 *
 * @example
 *   ---
 *   import Alert from '@churchix/ui/components/Alert.astro';
 *   ---
 *   <Alert tone="success" title="Pomelnic trimis">Vă mulțumim.</Alert>
 *   <Alert tone="error">Câmpul este obligatoriu.</Alert>
 */
import Icon from './Icon.astro';
import type { IconName } from './icons.ts';

interface Props {
  tone?: 'info' | 'success' | 'error';
  title?: string;
  icon?: IconName;
  role?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  tone = 'info',
  title,
  icon,
  role,
  class: className,
  ...rest
} = Astro.props;

const tones = {
  info: {
    surface: 'bg-primary-container/30 text-on-primary-container border border-primary/20',
    icon: 'description' as IconName,
  },
  success: {
    surface: 'bg-secondary-container/30 text-on-secondary-container border border-secondary/30',
    icon: 'diversity_1' as IconName,
  },
  error: {
    surface: 'bg-error-container text-on-error-container border border-error/30',
    icon: 'campaign' as IconName,
  },
} as const;

const conf = tones[tone];
const resolvedIcon = icon ?? conf.icon;
const resolvedRole = role ?? (tone === 'error' ? 'alert' : 'status');

const classes = [
  'flex items-start gap-sm p-md rounded-lg font-body-md text-body-md',
  conf.surface,
  className,
];
---

<div class:list={classes} role={resolvedRole} {...rest}>
  <Icon name={resolvedIcon} size={20} class="mt-0.5" />
  <div class="min-w-0">
    {title && <p class="font-label-md text-label-md font-semibold">{title}</p>}
    <div class="min-w-0"><slot /></div>
  </div>
</div>
