---
/**
 * `<CampaignCard>` — a fundraising campaign (the porch notice, approved 2026-11-13).
 *
 * A white card with a full-strength edge. The `project` variant opens on a 144 px head: the cover picture, or a
 * `surface-container` panel with the church glyph and the "Proiect parohial" label, and the category badge laid
 * over its top-left corner. The body holds the title, the summary, the progress meter and, while the campaign is
 * active and has a hosted card link, an outlined button to it. The meter fills in `primary`, never gold.
 *
 * Money is integer minor units with an explicit currency. Progress is the last known value at build time: text and
 * bar both carry it, never color alone.
 *
 * @prop {Campaign} campaign   A campaigns entry's `.data`.
 * @prop {'card'|'project'} [variant='card']  `project` is the featured one, with the head.
 * @prop {string} [class]
 */
import type { campaignSchema } from "@churchix/schemas";
import type { z } from "zod";
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

type Campaign = z.infer<typeof campaignSchema>;

interface Props {
  campaign: Campaign;
  variant?: "card" | "project";
  class?: string;
  [key: string]: unknown;
}

const { campaign, variant = "card", class: className, ...rest } = Astro.props;

// Money: integer minor units + EXPLICIT currency, always. No floats retained.
const money = (minor: number) =>
  new Intl.NumberFormat("ro-RO", {
    style: "currency",
    currency: campaign.currency || "RON",
    maximumFractionDigits: 0,
  }).format(minor / 100);

const pct =
  campaign.goalAmountMinor > 0
    ? Math.min(100, Math.round((campaign.raisedAmountMinor / campaign.goalAmountMinor) * 100))
    : 0;

const deadlineFmt = campaign.deadline
  ? new Intl.DateTimeFormat("ro-RO", { day: "numeric", month: "long", year: "numeric" }).format(campaign.deadline)
  : null;

const isProject = variant === "project";
const isActive = campaign.status === "active";
const isCompleted = campaign.status === "completed";
const ctaLabel = isProject ? "Susține Proiectul" : "Contribuie";
const categoryLabel = isProject ? "Proiect Special" : "Campanie";
---

<Card
  as="article"
  radius="lg"
  padding="none"
  elevation={isProject ? "board" : "none"}
  class:list={["cx-campaign-card flex flex-col", className]}
  {...rest}
>
  {isProject && campaign.cover && (
    <div class="relative">
      <img
        src={campaign.cover}
        alt={campaign.title}
        class="h-36 w-full bg-surface-container object-cover"
        loading="lazy"
        decoding="async"
      />
      <Badge tone="secondary" class="absolute left-5 top-4">
        {categoryLabel}
      </Badge>
    </div>
  )}
  {isProject && !campaign.cover && (
    <div
      class="relative grid h-36 w-full content-center justify-items-center gap-2 bg-surface-container text-on-surface-variant"
      aria-hidden="true"
    >
      <Badge tone="secondary" class="absolute left-5 top-4">
        {categoryLabel}
      </Badge>
      <Icon name="church" size={32} class="text-primary" />
      <span class="font-label-md text-label-md text-on-surface-variant">Proiect parohial</span>
    </div>
  )}
  <div class="flex flex-1 flex-col p-5 min-[960px]:px-7 min-[960px]:pb-7 min-[960px]:pt-6">
    {!isProject && (
      <div class="mb-2">
        <Badge tone="neutral">{categoryLabel}</Badge>
      </div>
    )}
    <h3 class="mb-2 text-balance font-headline-md text-headline-md text-on-surface">{campaign.title}</h3>
    {campaign.summary && <p class="m-0 font-body-md text-body-md text-on-surface-variant">{campaign.summary}</p>}

    <div class="mt-5">
      <div class="flex justify-between font-body-md text-body-md font-semibold text-on-surface">
        <span>Stadiu</span>
        <span>{pct}%</span>
      </div>
      <div
        class="mt-2 h-2 w-full overflow-hidden rounded-full bg-surface-container-high"
        role="progressbar"
        aria-valuenow={pct}
        aria-valuemin={0}
        aria-valuemax={100}
        aria-label={`Progres: ${pct}% din obiectiv`}
      >
        <div class="h-full rounded-full bg-primary" style={`width:${pct}%`}></div>
      </div>
      <p class="m-0 mt-2 flex flex-wrap justify-between gap-x-3 font-label-md text-label-md font-normal tabular-nums text-on-surface-variant">
        <span>
          <strong class="font-semibold text-on-surface">{money(campaign.raisedAmountMinor)}</strong> strâns
        </span>
        <span>Obiectiv: {money(campaign.goalAmountMinor)}</span>
      </p>
    </div>
    {deadlineFmt && (
      <p class="m-0 mt-2 font-label-md text-label-md font-normal text-on-surface-variant">Termen: {deadlineFmt}</p>
    )}

    {(isActive && campaign.cardUrl) || isCompleted ? (
      <div class="mt-auto pt-4">
        {isActive && campaign.cardUrl && (
          <Button href={campaign.cardUrl} variant="secondary" shape="rounded" block rel="noopener" target="_blank">
            {ctaLabel}
          </Button>
        )}
        {isCompleted && (
          <p class="m-0 flex items-center gap-2 font-body-md text-body-md font-semibold text-primary">
            <Icon name="payments" size={20} />
            Obiectiv atins — mulțumim!
          </p>
        )}
      </div>
    ) : null}
  </div>
</Card>
