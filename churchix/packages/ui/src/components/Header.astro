---
/**
 * `<Header>` — sticky white-label site chrome (the porch notice, approved 2026-11-13).
 *
 * A solid white band (`surface-container-lowest`) with a full-strength 1 px edge, 72 px tall from 960 px and
 * 56 px below it. Wordmark in the display serif; from 960 px the six places in sentence case with the current
 * one marked in `primary` and underlined in `secondary-strong`, a language switcher (rendered only when the
 * church ships more than one locale), and the one filled pill, **Donează** (gated on `site.features.giving`).
 * Below 960 px the header holds only the wordmark: the places are the `BottomBar`, with the Drawer behind `Meniu`.
 *
 * Everything is token-driven — no church name, color, or hex is hardcoded, so
 * the header re-skins per church by token swap alone.
 */
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { withBase, stripBase } from "../lib/base.ts";
import type { SiteConfig } from "@churchix/schemas";

interface Props {
  site: SiteConfig;
  path?: string;
}

const { site, path = "/" } = Astro.props;
const nav = site.nav ?? [];
const wordmark = site.shortName ?? site.name;

// `path` arrives with the Astro base prefix (e.g. /parish/despre); nav hrefs are
// authored root-relative (/despre). Compare them on the same, base-stripped axis.
const relPath = stripBase(path);
const isActive = (href: string) =>
  href === "/" ? relPath === "/" : relPath === href || relPath.startsWith(href + "/");

// Language switcher only when the church actually ships more than one locale.
const locales = site.locales ?? [];
const defaultLocale = site.defaultLocale ?? locales[0] ?? "ro";
const showLangSwitcher = locales.length > 1;
const localeNames: Record<string, string> = {
  ro: "Română",
  en: "English",
  it: "Italiano",
  es: "Español",
  de: "Deutsch",
};

const showGiving = site.features.giving;

const navLinkBase =
  "flex h-[72px] items-center whitespace-nowrap border-b-2 pt-0.5 font-body-md text-body-md no-underline transition-colors " +
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset";
const navLinkActive = "border-secondary-strong font-semibold text-primary";
const navLinkIdle = "border-transparent font-normal text-on-surface-variant hover:text-primary";
---

<header class="sticky top-0 z-50 w-full border-b border-outline-variant bg-surface-container-lowest">
  <div class="mx-auto flex h-14 w-full max-w-container-max items-center gap-4 px-4 min-[960px]:h-[72px] min-[960px]:gap-6 min-[960px]:px-6">
    <a
      class="flex min-h-11 min-w-0 items-center gap-3 rounded font-wordmark text-wordmark-mobile text-primary no-underline min-[960px]:shrink-0 min-[960px]:text-wordmark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
      href={withBase("/")}
    >
      {site.brand.logo && (
        <img
          src={withBase(site.brand.logo)}
          alt=""
          width="36"
          height="36"
          decoding="async"
          class="h-9 w-9 shrink-0 object-contain"
        />
      )}
      <span class="min-w-0 break-words">{wordmark}</span>
    </a>

    <nav class="mx-auto hidden min-w-0 flex-nowrap items-center gap-6 min-[960px]:flex" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[navLinkBase, isActive(item.href) ? navLinkActive : navLinkIdle]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-4 min-[960px]:ml-0">
      {showLangSwitcher && (
        <div class="relative hidden cx-lang min-[960px]:block">
          <button
            type="button"
            class="flex h-11 w-11 items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Schimbă limba"
            data-cx-lang-toggle
          >
            <Icon name="language" size={22} />
          </button>
          <ul
            class="absolute right-0 top-[calc(100%+0.5rem)] z-50 hidden min-w-[10rem] flex-col rounded-lg border border-outline-variant bg-surface-container-lowest p-1 shadow-board"
            role="menu"
            data-cx-lang-menu
          >
            {locales.map((loc) => (
              <li role="none">
                <a
                  role="menuitem"
                  hreflang={loc}
                  href={loc === defaultLocale ? withBase("/") : withBase(`/${loc}/`)}
                  aria-current={loc === defaultLocale ? "true" : undefined}
                  class:list={[
                    "flex min-h-11 items-center rounded px-3 font-body-md text-body-md no-underline transition-colors hover:bg-surface-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset",
                    loc === defaultLocale
                      ? "bg-surface-highlight font-semibold text-primary"
                      : "text-on-surface hover:text-primary",
                  ]}
                >
                  {localeNames[loc] ?? loc.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {showGiving && (
        <Button variant="primary" shape="pill" size="sm" href={withBase("/donatii")} class="max-[959px]:hidden">
          Donează
        </Button>
      )}
    </div>
  </div>
</header>

{showLangSwitcher && <script is:inline>
  (() => {
    const root = document.querySelector(".cx-lang");
    if (!root) return;
    const toggle = root.querySelector("[data-cx-lang-toggle]");
    const menu = root.querySelector("[data-cx-lang-menu]");
    if (!toggle || !menu) return;
    const open = () => {
      menu.classList.remove("hidden");
      menu.classList.add("flex");
      toggle.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      toggle.setAttribute("aria-expanded", "false");
    };
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isOpen()) close();
      else open();
    });
    document.addEventListener("click", (e) => {
      if (isOpen() && !root.contains(e.target)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        close();
        toggle.focus();
      }
    });
  })();
</script>}
