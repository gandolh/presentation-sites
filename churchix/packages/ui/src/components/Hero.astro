---
/**
 * `<Hero>` — the asymmetric home banner (redesign: "the liturgical spine").
 *
 * NOT a centered stack on a dark scrim. The hero is an asymmetric split anchored
 * by the liturgical rail:
 *
 *   LEFT column  — the church identity + the single most-wanted fact:
 *                  overline → church name (display-xl) → the live "Următoarea
 *                  Slujbă" as a large, prominent line → CTAs. The eye enters here.
 *   RIGHT column — a FRAMED image (icon-in-its-frame, not full-bleed) above a quiet
 *                  "this week" timeline rendered from the schedule. The timeline is
 *                  the structural subject; it makes the schedule the hero.
 *
 * Graceful degradation:
 *   - no image  → the frame holds a tonal burgundy panel with a church glyph.
 *   - no schedule → the right column collapses to just the framed image, full height.
 *   - no next-service → the left column drops that line (CTAs move up).
 *
 * White-label: every color flows through M3 tokens; per-church inputs arrive as
 * props only. Feature flags gate the giving / livestream CTAs.
 *
 * @prop {string}  title              Church name → `<h1>` (`font-display-xl`).
 * @prop {string}  [eyebrow]          Overline label above the name.
 * @prop {string}  [subtitle]         Optional lead paragraph under the name.
 * @prop {string}  [image]            Framed image URL (under `public/`). Optional.
 * @prop {string}  [imageAlt]         Alt text (decorative if omitted).
 * @prop {string}  [nextService]      "Următoarea Slujbă" text. Block hidden when absent.
 * @prop {string}  [nextServiceLabel='Următoarea slujbă']
 * @prop {Array<{day: string; time: string; label: string; highlight?: boolean}>} [week=[]]
 *        Compact week rows for the timeline (already formatted/sorted by the caller).
 * @prop {string}  [weekLabel='Săptămâna aceasta']
 * @prop {string}  [weekHref]         "Vezi tot programul" link target (e.g. /program).
 * @prop {string}  [weekHrefLabel='Programul complet']
 * @prop {boolean} [giving=true]      Honors `features.giving`. Gates the primary CTA.
 * @prop {string}  [ctaLabel='Donează']  @prop {string} [ctaHref]
 * @prop {boolean} [sermons=false]    Honors `features.sermons`. Gates the livestream CTA.
 * @prop {string}  [livestreamHref]   @prop {string} [livestreamLabel='Urmărește live']
 * @prop {string}  [secondaryLabel]   @prop {string} [secondaryHref]  Extra outline CTA.
 * @prop {string}  [class]
 */
import Icon from './Icon.astro';
import Rail from './Rail.astro';
import { withBase } from '../lib/base.ts';

interface WeekRow {
  day: string;
  time: string;
  label: string;
  highlight?: boolean;
}

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  nextService?: string;
  nextServiceLabel?: string;
  week?: WeekRow[];
  weekLabel?: string;
  weekHref?: string;
  weekHrefLabel?: string;
  giving?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  sermons?: boolean;
  livestreamHref?: string;
  livestreamLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  subtitle,
  image,
  imageAlt,
  nextService,
  nextServiceLabel = 'Următoarea slujbă',
  week = [],
  weekLabel = 'Săptămâna aceasta',
  weekHref,
  weekHrefLabel = 'Programul complet',
  giving = true,
  ctaLabel = 'Donează',
  ctaHref,
  sermons = false,
  livestreamHref,
  livestreamLabel = 'Urmărește live',
  secondaryLabel,
  secondaryHref,
  class: className,
} = Astro.props;

const hasImage = Boolean(image);
const hasWeek = week.length > 0;
const showGiving = giving && Boolean(ctaHref);
const showLivestream = sermons && Boolean(livestreamHref);
const showSecondary = Boolean(secondaryHref && secondaryLabel);
const hasActions = showGiving || showLivestream || showSecondary;
---

<section
  class:list={[
    'relative overflow-hidden bg-surface',
    className,
  ]}
>
  {/* Quiet tonal wash + a faint corner glyph so the cream hero never feels empty
      on an image-less parish, without resorting to a dark scrim. */}
  <div
    class="pointer-events-none absolute inset-0 -z-0"
    aria-hidden="true"
    style="background: radial-gradient(120% 80% at 88% 0%, color-mix(in srgb, var(--secondary) 9%, transparent), transparent 55%), radial-gradient(90% 70% at 0% 100%, color-mix(in srgb, var(--primary) 6%, transparent), transparent 60%);"
  >
  </div>

  <div class="relative z-10 w-full max-w-container-max mx-auto px-sm md:px-gutter py-xl">
    <div class="flex gap-sm md:gap-lg">
      <Rail markers={7} class="hidden sm:block" />

      <div class="min-w-0 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-lg lg:gap-xl items-stretch">
        <!-- LEFT: identity + next service + CTAs -->
        <div class="lg:col-span-6 flex flex-col justify-center">
          {eyebrow && (
            <p class="font-overline text-overline uppercase text-on-secondary-container mb-sm">
              {eyebrow}
            </p>
          )}

          <h1 class="font-display-xl text-display-xl text-primary text-balance m-0">
            {title}
          </h1>

          {subtitle && (
            <p class="mt-md max-w-xl font-body-lg text-body-lg text-on-surface-variant text-pretty">
              {subtitle}
            </p>
          )}

          {nextService && (
            <div class="mt-lg flex items-start gap-sm border-l-2 border-secondary pl-md">
              <Icon name="schedule" size={22} class="mt-1 text-secondary shrink-0" />
              <div class="min-w-0">
                <p class="font-overline text-overline uppercase text-on-surface-variant">
                  {nextServiceLabel}
                </p>
                <p class="font-headline-md text-headline-md text-primary text-balance">
                  {nextService}
                </p>
              </div>
            </div>
          )}

          {hasActions && (
            <div class="mt-xl flex flex-col sm:flex-row gap-sm">
              {showGiving && (
                <a
                  href={withBase(ctaHref)}
                  class="inline-flex items-center justify-center gap-xs font-label-md text-label-md uppercase px-7 py-3.5 rounded bg-primary text-on-primary shadow-sm hover:shadow-md hover:bg-primary-container transition-[box-shadow,background-color] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                >
                  {ctaLabel}
                  <Icon name="arrow_forward" size={18} />
                </a>
              )}
              {showLivestream && (
                <a
                  href={withBase(livestreamHref)}
                  class="inline-flex items-center justify-center gap-xs font-label-md text-label-md uppercase px-7 py-3.5 rounded border border-primary/40 text-primary bg-transparent hover:bg-surface-container-high transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                >
                  <Icon name="live_tv" size={18} />
                  {livestreamLabel}
                </a>
              )}
              {showSecondary && (
                <a
                  href={withBase(secondaryHref)}
                  class="inline-flex items-center justify-center gap-xs font-label-md text-label-md uppercase px-7 py-3.5 rounded border border-primary/40 text-primary bg-transparent hover:bg-surface-container-high transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                >
                  {secondaryLabel}
                </a>
              )}
            </div>
          )}
        </div>

        <!-- RIGHT: framed image + this-week timeline -->
        <div class="lg:col-span-6 flex flex-col gap-md">
          {/* Framed image — icon-in-its-frame: a gold hairline + offset shadow,
              not a full-bleed scrim. Falls back to a tonal burgundy panel. The
              frame grows to fill the column so it stays balanced against the left. */}
          <figure class="relative m-0 flex-1 min-h-[16rem]">
            <div class="absolute -inset-1.5 rounded-xl border border-secondary/40" aria-hidden="true"></div>
            <div class="relative h-full overflow-hidden rounded-lg ring-1 ring-outline-variant/40 shadow-md">
              {hasImage ? (
                <img
                  src={image}
                  alt={imageAlt ?? ''}
                  aria-hidden={imageAlt ? undefined : 'true'}
                  class="block h-full min-h-[16rem] w-full object-cover"
                  width="1280"
                  height="720"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <div
                  class="flex h-full min-h-[16rem] w-full items-center justify-center bg-primary"
                  aria-hidden="true"
                  style="background-image: radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--secondary) 14%, transparent), transparent 60%);"
                >
                  <Icon name="church" fill size={104} class="text-on-primary/25" />
                </div>
              )}
            </div>
          </figure>

          {hasWeek && (
            <div class="rounded-lg border border-outline-variant/40 bg-surface-container-lowest/80 backdrop-blur-sm shadow-sm">
              <div class="flex items-center justify-between gap-sm border-b border-outline-variant/30 px-md py-sm">
                <span class="font-overline text-overline uppercase text-on-surface-variant">
                  {weekLabel}
                </span>
                {weekHref && (
                  <a
                    href={withBase(weekHref)}
                    class="inline-flex items-center gap-1 font-label-md text-caption uppercase text-primary hover:underline underline-offset-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                  >
                    {weekHrefLabel}
                    <Icon name="arrow_forward" size={14} />
                  </a>
                )}
              </div>
              <ul class="m-0 flex flex-col p-0 list-none">
                {week.map((row) => (
                  <li
                    class:list={[
                      'flex items-baseline gap-sm px-md py-sm border-b border-outline-variant/15 last:border-b-0',
                      row.highlight && 'bg-secondary/5',
                    ]}
                  >
                    <span
                      class:list={[
                        'font-overline text-overline uppercase w-12 shrink-0',
                        row.highlight ? 'text-primary' : 'text-on-surface-variant',
                      ]}
                    >
                      {row.day}
                    </span>
                    <span class="font-label-md text-label-md tabular-nums w-14 shrink-0 text-primary">
                      {row.time}
                    </span>
                    <span class="font-body-md text-body-md text-on-surface min-w-0 break-words">
                      {row.label}
                    </span>
                    {row.highlight && (
                      <Icon name="church" fill size={15} class="ml-auto shrink-0 text-secondary" />
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
