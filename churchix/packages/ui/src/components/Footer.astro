---
/**
 * `<Footer>` — white-label site footer (the porch notice, approved 2026-11-13).
 *
 * A `surface-container-high` panel with a full-strength top edge, laid out as a grid of brand and copyright,
 * quick links, contact with the IBANs, and (when set) social links. The IBAN stays on every page. Below 960 px
 * the panel pads its bottom by the `BottomBar`'s height, so the bar never covers the last line. All
 * color/spacing/type via M3 tokens — no church value or hex is hardcoded.
 */
import Icon from "./Icon.astro";
import { withBase } from "../lib/base.ts";
import type { SiteConfig } from "@churchix/schemas";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const c = site.contact;
const ibans = site.giving?.ibans ?? [];
const year = new Date().getFullYear();
const wordmark = site.shortName ?? site.name;

const hasSocial = Boolean(c.facebook || c.youtube);

// Quick links — gated so we never surface a route a church didn't enable.
const links = [
  site.features.giving && { href: "/donatii", label: "IBAN Donații" },
  { href: "/contact", label: "Contact Preot" },
  { href: "/termeni", label: "Termeni și Condiții" },
  { href: "/confidentialitate", label: "Politică de Confidențialitate" },
].filter(Boolean) as { href: string; label: string }[];

const headingClass = "mb-3 font-body-md text-body-md font-semibold text-on-surface";
const mutedLink =
  "inline-flex min-h-7 items-center rounded font-label-md text-label-md font-normal text-on-surface-variant no-underline hover:text-primary hover:underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-high";
---

<footer class="mt-0 w-full border-t border-outline-variant bg-surface-container-high pb-[calc(3rem+4rem+env(safe-area-inset-bottom))] pt-12 min-[960px]:pb-12">
  <div
    class:list={[
      "mx-auto grid w-full max-w-container-max grid-cols-1 gap-7 px-4 min-[960px]:gap-10 min-[960px]:px-6",
      hasSocial
        ? "min-[960px]:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1.2fr)_minmax(0,1fr)]"
        : "min-[960px]:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1.2fr)]",
    ]}
  >
    <!-- Brand + copyright -->
    <div>
      <a class="mb-3 block font-wordmark text-wordmark text-primary no-underline" href={withBase("/")}>
        {wordmark}
      </a>
      {site.tagline && (
        <p class="mb-2 font-label-md text-label-md font-normal text-on-surface-variant">{site.tagline}</p>
      )}
      <p class="mt-4 font-label-md text-label-md font-normal text-on-surface-variant">
        © {year} {site.name}.<br />
        Toate drepturile rezervate.
      </p>
    </div>

    <!-- Quick links -->
    <nav class="flex flex-col gap-1" aria-label="Linkuri footer">
      <h2 class={headingClass}>Navigare</h2>
      {links.map((l) => (
        <a class={mutedLink} href={withBase(l.href)}>
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Contact + IBANs -->
    <div class="flex flex-col gap-1">
      <h2 class={headingClass}>Contact</h2>
      <address class="not-italic font-label-md text-label-md font-normal text-on-surface-variant">
        {c.address}
        <br />
        {c.city}, {c.country}
      </address>
      {c.phone && (
        <a class={mutedLink} href={`tel:${c.phone.replace(/\s+/g, "")}`}>
          {c.phone}
        </a>
      )}
      {c.email && (
        <a class={mutedLink} href={`mailto:${c.email}`}>
          {c.email}
        </a>
      )}

      {ibans.length > 0 && (
        <div class="mt-4 flex flex-col gap-1">
          <h3 class={headingClass + " mb-1"}>Donații prin transfer</h3>
          <ul class="m-0 flex list-none flex-col gap-2 p-0">
            {ibans.map((i) => (
              <li class="font-label-md text-label-md font-normal text-on-surface-variant">
                <strong class="font-semibold text-on-surface">{i.label}</strong> ({i.currency})<br />
                <span class="break-all tabular-nums">{i.iban}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Social -->
    {hasSocial && (
      <nav class="flex flex-col gap-1" aria-label="Rețele sociale">
        <h2 class={headingClass}>Urmărește-ne</h2>
        {c.facebook && (
          <a class:list={[mutedLink, "gap-2"]} href={c.facebook} rel="noopener noreferrer" target="_blank">
            <Icon name="diversity_1" size={16} />
            Facebook
          </a>
        )}
        {c.youtube && (
          <a class:list={[mutedLink, "gap-2"]} href={c.youtube} rel="noopener noreferrer" target="_blank">
            <Icon name="live_tv" size={16} />
            YouTube
          </a>
        )}
      </nav>
    )}
  </div>
</footer>
