---
/**
 * `<PageShell>` — the inner-page frame (the porch notice, approved 2026-11-13).
 *
 * Every non-home page composes this. A slim `primary` band opens the page with its title (`h1`, Cardo 40/48 from
 * 960 px, 28/34 below) and its lede in `on-primary-variant`; the page's first cards rise out of the band's lower
 * edge (a negative margin of 56 px, 28 on phones), so the slotted body starts over the band. There is no kicker
 * and no rail: the title says where you are.
 *
 * @prop {string}  title              Page title → the `as` heading.
 * @prop {string}  [lede]             Optional sentence under the title.
 * @prop {'h1'|'h2'} [as='h1']        Heading level for the title.
 * @prop {string}  [class]
 *
 * @slot default — page body; its first block is drawn over the band's edge.
 * @slot actions — optional controls in the band, right-aligned on desktop (e.g. a PDF download).
 */
interface Props {
  title: string;
  lede?: string;
  as?: "h1" | "h2";
  class?: string;
}

const { title, lede, as = "h1", class: className } = Astro.props;
const Tag = as;
const hasActions = Astro.slots.has && Astro.slots.has("actions");
---

<div class:list={[className]}>
  <header class="bg-primary pb-14 pt-6 text-on-primary min-[960px]:pb-[88px] min-[960px]:pt-10">
    <div class="mx-auto flex w-full max-w-container-max flex-col gap-4 px-4 min-[960px]:flex-row min-[960px]:items-end min-[960px]:justify-between min-[960px]:px-6">
      <div class="min-w-0">
        <Tag class="m-0 text-balance break-words font-headline-md text-[28px] font-bold leading-[34px] text-on-primary min-[960px]:text-[40px] min-[960px]:leading-[48px]">
          {title}
        </Tag>
        {lede && (
          <p class="mt-2 max-w-2xl text-pretty font-body-md text-body-md text-on-primary-variant min-[960px]:text-body-lg">
            {lede}
          </p>
        )}
      </div>
      {hasActions && (
        <div class="flex shrink-0 items-center gap-4 empty:hidden">
          <slot name="actions" />
        </div>
      )}
    </div>
  </header>

  <div class="relative -mt-7 min-[960px]:-mt-14">
    <div class="mx-auto w-full max-w-container-max px-4 pb-12 min-[960px]:px-6 min-[960px]:pb-16">
      <slot />
    </div>
  </div>
</div>
