---
/**
 * `<GivingChannels>` — the Donează / Susține parohia body (Ecclesia Digitalis).
 *
 * The porch notice (approved 2026-11-13): the transfer card beside the project card, both over the page band's
 * edge, and Form 230 as a wide card below them.
 *   - LEFT  (primary giving): the optional hosted-card block, and the IBAN transfer card: the beneficiary
 *           callout inside it, the account, and `Copiază`, the page's one filled action.
 *   - RIGHT (secondary):      the featured project (CampaignCard) and the SMS card.
 *   - BELOW:                  Form 230, a wide card with its download.
 * Nested boxes are flat: accounts are hairline-separated rows, and the beneficiary line is a callout in the card.
 *
 * Every block renders only when the church configured it — no Churchix value is
 * hardcoded, all per-church data arrives via the `giving`/`campaign` props, and all
 * color/space/type goes through M3 tokens so it re-skins per church by token swap.
 *
 * PCI SAQ A: card giving is an OUTBOUND link to the hosted `cardUrl`. Amount presets
 * are UI affordances that pass `?amount=` to that hosted page — card data never
 * touches this code.
 *
 * @prop {SiteConfig['giving']} giving   The church's giving config (currency, ibans[],
 *        cardUrl?, form230 + form230Url?, smsKeyword/smsNumber/smsAmount).
 * @prop {Campaign} [campaign]           Optional featured campaign (a campaigns entry's
 *        `.data`); rendered as `<CampaignCard variant="project">` in the right column.
 * @prop {boolean} [showCampaign=true]   Gate for rendering the featured campaign block
 *        (page passes `features.campaigns && a campaign exists`).
 */
import type { SiteConfig, campaignSchema } from "@churchix/schemas";
import type { z } from "zod";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import Field from "./Field.astro";
import CampaignCard from "./CampaignCard.astro";
import CopyIban from "../islands/CopyIban.tsx";
import { withBase } from "../lib/base.ts";

type Campaign = z.infer<typeof campaignSchema>;

interface Props {
  giving: SiteConfig["giving"];
  campaign?: Campaign;
  showCampaign?: boolean;
}

const { giving, campaign, showCampaign = true } = Astro.props;

const currency = giving?.currency || "RON";
const ibans = giving?.ibans ?? [];

// Amount presets (UI only) — passed to the hosted card page; never collected here.
const presets = [50, 100, 200];

// Build an outbound card URL, deep-linking an amount when one is chosen. The hosted
// page (Stripe Payment Link / Netopia) ignores the param if it doesn't support it.
const cardHref = (amount?: number) => {
  if (!giving?.cardUrl) return undefined;
  if (!amount) return giving.cardUrl;
  try {
    const u = new URL(giving.cardUrl);
    u.searchParams.set("amount", String(amount));
    return u.toString();
  } catch {
    return giving.cardUrl;
  }
};

const hasCard = Boolean(giving?.cardUrl);
const hasIbans = ibans.length > 0;
// Show the "verify the beneficiary" band only when at least one account carries a
// holder name to verify against — otherwise the reassurance has nothing to anchor to.
const hasVerifiableHolder = ibans.some((acc) => Boolean(acc.holder));
const hasForm230 = Boolean(giving?.form230);
const hasSms = Boolean(giving?.smsKeyword && giving?.smsNumber);
const hasCampaign = Boolean(showCampaign && campaign);
const hasRightColumn = hasCampaign || hasSms;
---

<div class="grid gap-4 min-[960px]:gap-6">
  <div
    class:list={[
      "grid grid-cols-1 items-stretch gap-4 min-[960px]:gap-6",
      hasRightColumn && "min-[960px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]",
    ]}
  >
    {/* ---------- LEFT: primary giving ---------- */}
    <div class="flex min-w-0 flex-col gap-4 min-[960px]:gap-6">
      {hasCard && (
        <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-board min-[960px]:p-8">
          <h2 class="m-0 flex items-center gap-3 font-headline-md text-headline-md text-primary">
            <Icon name="payments" size={24} class="text-secondary-strong" />
            Donație online cu cardul
          </h2>
          <p class="m-0 mt-2 font-body-md text-body-md text-on-surface-variant">
            Donare rapidă și securizată, găzduită de procesatorul de plăți. Datele cardului nu trec prin acest site.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            {presets.map((amount) => (
              <Button
                variant="secondary"
                shape="rounded"
                href={cardHref(amount)}
                target="_blank"
                rel="noopener"
                class="min-w-[120px] flex-1"
              >
                {amount} {currency}
              </Button>
            ))}
            <div class="min-w-[160px] flex-1">
              <Field
                label={`Altă sumă (${currency})`}
                labelHidden
                name="suma-personalizata"
                type="number"
                min="1"
                inputmode="numeric"
                placeholder={`Altă sumă (${currency})`}
              />
            </div>
          </div>
          <Button
            variant="primary"
            block
            shape="rounded"
            href={cardHref()}
            target="_blank"
            rel="noopener"

            class="mt-4"
          >
            Donează Online
          </Button>
        </section>
      )}
      {hasIbans && (
        <section class="flex-1 rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-board min-[960px]:p-8">
          <h2 class="m-0 flex items-center gap-3 font-headline-md text-headline-md text-primary">
            <Icon name="account_balance" size={24} class="text-secondary-strong" />
            Transfer bancar (IBAN)
          </h2>
          <p class="m-0 mt-2 font-body-md text-body-md text-on-surface-variant">
            Puteți transfera fonduri direct în conturile parohiei.
          </p>
          {hasVerifiableHolder && (
            <p class="m-0 mt-5 flex items-start gap-3 rounded bg-secondary-container p-4 font-body-md text-body-md text-on-secondary-container">
              <Icon name="verified_user" size={20} class="mt-0.5 shrink-0 text-primary" />
              <span>
                Înainte de a trimite, verificați că <strong class="font-semibold">beneficiarul</strong> este parohia
                noastră, exact cum apare mai jos.
              </span>
            </p>
          )}
          <ul class="m-0 list-none p-0">
            {ibans.map((acc) => (
              <li class="mt-5 grid grid-cols-1 items-end gap-x-6 gap-y-2 border-outline-variant min-[960px]:grid-cols-[minmax(0,1fr)_auto] [&:not(:first-child)]:border-t [&:not(:first-child)]:pt-5">
                {acc.holder && (
                  <div class="min-w-0 min-[960px]:col-span-2">
                    <p class="m-0 font-label-md text-label-md text-on-surface-variant">Beneficiar</p>
                    <p class="m-0 break-words font-body-lg text-body-lg font-semibold text-on-surface">{acc.holder}</p>
                  </div>
                )}
                <div class="min-w-0">
                  <p class="m-0 flex items-baseline gap-2 font-label-md text-label-md text-on-surface-variant">
                    {acc.label}
                    <span class="font-body-md text-body-md font-normal">{acc.currency}</span>
                  </p>
                  <p class="m-0 break-words font-body-lg text-body-lg font-semibold tabular-nums text-on-surface [overflow-wrap:anywhere] min-[960px]:text-headline-md min-[960px]:leading-8 min-[960px]:font-body-lg">
                    {acc.iban}
                  </p>
                  {acc.bic && (
                    <p class="m-0 mt-1 font-label-md text-label-md font-normal text-on-surface-variant">
                      BIC/SWIFT: <span class="font-semibold text-on-surface">{acc.bic}</span>
                    </p>
                  )}
                </div>
                <CopyIban
                  client:visible
                  variant="fill"
                  iban={acc.iban}
                  label={acc.holder ? `Copiază IBAN ${acc.holder} (${acc.label})` : `Copiază IBAN ${acc.label}`}
                  className="max-[959px]:mt-2 max-[959px]:w-full"
                />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {/* ---------- RIGHT: the featured project and the SMS card ---------- */}
    {hasRightColumn && (
      <div class="flex min-w-0 flex-col gap-4 min-[960px]:gap-6">
        {/* Screen-reader section anchor so the H3s below have a valid parent H2 in the outline. */}
        <h2 class="sr-only">Alte modalități de a sprijini parohia</h2>
        {hasCampaign && campaign && <CampaignCard campaign={campaign} variant="project" class="flex-1" />}
        {hasSms && (
          <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-board min-[960px]:px-8 min-[960px]:py-7">
            <h3 class="m-0 flex items-center gap-3 font-headline-md text-headline-md text-primary">
              <Icon name="sms" size={24} class="text-secondary-strong" />
              Donație prin SMS
            </h3>
            <p class="m-0 mt-2 font-body-md text-body-md text-on-surface-variant">
              Trimite <span class="font-semibold uppercase text-on-surface">{giving?.smsKeyword}</span>
              la numărul <span class="font-semibold text-on-surface">{giving?.smsNumber}</span>
              {giving?.smsAmount && (
                <>
                  {" "}
                  pentru a dona <span class="font-semibold text-on-surface">{giving.smsAmount}</span>
                </>
              )}
              .
            </p>
            <p class="m-0 mt-2 font-label-md text-label-md font-normal text-on-surface-variant">
              *Suma este facturată lunar de operatorul dumneavoastră de telefonie.
            </p>
          </section>
        )}
      </div>
    )}
  </div>

  {hasForm230 && (
    <section class="grid grid-cols-1 items-center gap-4 rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-board min-[960px]:grid-cols-[minmax(0,1fr)_auto] min-[960px]:gap-6 min-[960px]:px-8 min-[960px]:py-7">
      <div>
        <h2 class="m-0 flex items-center gap-3 font-headline-md text-headline-md text-primary">
          <Icon name="download" size={24} class="text-secondary-strong" />
          Redirecționează 3,5%
        </h2>
        <p class="m-0 mt-2 max-w-[72ch] font-body-md text-body-md text-on-surface-variant">
          Puteți redirecționa până la 3,5% din impozitul pe venit către parohia noastră, completând Formularul 230 —
          fără niciun cost suplimentar. Termen: ~25 mai.
        </p>
      </div>
      {giving?.form230Url && (
        <Button variant="secondary" shape="rounded" href={withBase(giving.form230Url)} icon="download">
          Descarcă Formularul
        </Button>
      )}
    </section>
  )}
</div>
