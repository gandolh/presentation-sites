---
/**
 * `<Divider>` — the ornamental section separator (Ecclesia Digitalis).
 *
 * A horizontal hairline rule with a small centered Byzantine node — a cross set in
 * a gold (`secondary`) ring. Pure inline SVG so it scales crisply and re-skins by
 * token swap: the line uses `currentColor` (driven by `tone`), the node uses
 * `secondary`. No raster, no church-specific values.
 *
 * @prop {'subtle'|'strong'} [tone='subtle']  Line color via text token:
 *        subtle = `text-outline-variant`; strong = `text-on-surface-variant`.
 * @prop {boolean} [plain=false]  Drop the central cross node — a bare hairline rule.
 * @prop {string} [label]   Accessible name; when set the divider is `role="separator"`
 *                          with this `aria-label`, else it is `aria-hidden` (decorative).
 * @prop {string} [class]   Extra classes (e.g. vertical margin `my-lg`).
 *
 * @example
 *   ---
 *   import Divider from '@churchix/ui/components/Divider.astro';
 *   ---
 *   <Divider class="my-lg" />
 *   <Divider tone="strong" plain />
 */
interface Props {
  tone?: 'subtle' | 'strong';
  plain?: boolean;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  tone = 'subtle',
  plain = false,
  label,
  class: className,
  ...rest
} = Astro.props;

const toneClass = tone === 'strong' ? 'text-on-surface-variant' : 'text-outline-variant';

const a11y = label
  ? { role: 'separator', 'aria-label': label }
  : { 'aria-hidden': 'true' };
---

<div
  class:list={['cx-divider flex items-center w-full', toneClass, className]}
  {...a11y}
  {...rest}
>
  {
    plain ? (
      <span class="block h-px w-full bg-current opacity-60"></span>
    ) : (
      <>
        <span class="block h-px flex-1 bg-current opacity-50"></span>
        <svg
          class="mx-sm shrink-0"
          width="28"
          height="28"
          viewBox="0 0 28 28"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          {/* Gold ring (secondary) */}
          <circle cx="14" cy="14" r="6.5" stroke="var(--secondary)" stroke-width="1" fill="none" />
          {/* Byzantine cross — currentColor so it follows the line tone */}
          <path
            d="M14 8.5v11M9.5 14h9M11.5 11h5M11.5 17h5"
            stroke="var(--secondary)"
            stroke-width="1.25"
            stroke-linecap="round"
          />
        </svg>
        <span class="block h-px flex-1 bg-current opacity-50"></span>
      </>
    )
  }
</div>
