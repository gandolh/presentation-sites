---
/**
 * `<ServiceSchedule>` — the parish service programme (the porch notice, approved 2026-11-13).
 *
 * Two layouts, selected by `variant`:
 *
 *  - `grouped` (default) — one white card per weekday on a two-column grid (one column below 960 px), Monday to
 *    Sunday, over the page band's edge. Each card has a head (the day in Cardo, a hairline under it) and one
 *    row per service: the time at 32/40 in Inter 600, the service in Cardo 24/32, an optional muted note under
 *    it, and a cadence line for anything that is not weekly. Sunday's row sits on `surface-highlight`, its head
 *    carries the church mark in `secondary-strong` and the "Ziua Domnului" badge. Services with no weekday
 *    (movable feasts) collect into a wide trailing card, "Sărbători și rânduieli speciale". A long list grows
 *    the card downward and never scrolls inside it.
 *
 *  - `table` — the legacy flat three-column table, kept for compact inline use. Same data, no grid.
 *
 * White-label: every color/spacing/type value is an M3 token, so the component re-skins per church by token swap
 * alone.
 *
 * @prop {Service[]} items                 The schedule entries (from `serviceScheduleSchema`).
 * @prop {'grouped'|'table'} [variant='grouped']  Layout. `table` = legacy compact table.
 *
 * @example
 *   ---
 *   import ServiceSchedule from '@churchix/ui/components/ServiceSchedule.astro';
 *   ---
 *   <ServiceSchedule items={schedule} />
 *   <ServiceSchedule items={schedule} variant="table" />
 */
import type { serviceScheduleSchema } from "@churchix/schemas";
import type { z } from "zod";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";

type Service = z.infer<typeof serviceScheduleSchema>;
type Weekday = NonNullable<Service["weekday"]>;

interface Props {
  items: Service[];
  variant?: "grouped" | "table";
}

const { items, variant = "grouped" } = Astro.props;

const WEEKDAY_RO: Record<Weekday, string> = {
  mon: "Luni",
  tue: "Marți",
  wed: "Miercuri",
  thu: "Joi",
  fri: "Vineri",
  sat: "Sâmbătă",
  sun: "Duminică",
};

const CADENCE_RO: Record<Service["cadence"], string> = {
  weekly: "Săptămânal",
  biweekly: "La două săptămâni",
  monthly: "Lunar",
  special: "Ocazional",
};

// Liturgical week ordering (Mon→Sun) for deterministic grouping.
const WEEK_ORDER: Weekday[] = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];

const byOrder = (a: Service, b: Service) => (a.order ?? 0) - (b.order ?? 0);

// --- Grouped layout: bucket by weekday, plus a trailing "special" bucket ---
const dayBuckets: { weekday: Weekday; services: Service[] }[] = WEEK_ORDER.map((weekday) => ({
  weekday,
  services: items.filter((s) => s.weekday === weekday).sort(byOrder),
})).filter((b) => b.services.length > 0);

const specialServices = items.filter((s) => !s.weekday).sort(byOrder);

const cardClass =
  "rounded-lg border border-outline-variant bg-surface-container-lowest px-5 py-5 shadow-board min-[960px]:px-8 min-[960px]:py-7";
const headClass = "flex items-center justify-between gap-3 border-b border-outline-variant pb-4";
const rowClass =
  "-mx-3 mt-3 grid min-h-16 grid-cols-[96px_minmax(0,1fr)] items-center gap-x-3 gap-y-2 rounded px-3 py-2 min-[960px]:min-h-[72px] min-[960px]:grid-cols-[112px_minmax(0,1fr)] min-[960px]:gap-x-4";
const timeClass =
  "font-time text-[28px] font-semibold leading-9 tabular-nums text-primary min-[960px]:text-[32px] min-[960px]:leading-10";
const nameClass =
  "m-0 break-words font-headline-md text-[22px] font-bold leading-7 text-on-surface min-[960px]:text-headline-md min-[960px]:leading-8";
const noteClass = "m-0 col-start-2 break-words font-body-md text-body-md text-on-surface-variant";

// Sort the legacy table flat by order for stable output.
const tableSorted = [...items].sort(byOrder);
---

{variant === "table" ? (
  <table class="cx-schedule">
    <thead>
      <tr>
        <th scope="col">Slujbă</th>
        <th scope="col">Zi</th>
        <th scope="col">Ora</th>
      </tr>
    </thead>
    <tbody>
      {tableSorted.map((s) => (
        <tr>
          <td>
            <strong>{s.label}</strong>
            {s.note && <span class="cx-schedule__note">{s.note}</span>}
          </td>
          <td>{s.weekday ? WEEKDAY_RO[s.weekday] : CADENCE_RO[s.cadence]}</td>
          <td>{s.time}</td>
        </tr>
      ))}
    </tbody>
  </table>
) : (
  <div class="grid gap-4 min-[960px]:gap-6">
    {dayBuckets.length > 0 && (
      <div class="grid grid-cols-1 items-start gap-4 min-[960px]:grid-cols-2 min-[960px]:gap-6">
        {dayBuckets.map(({ weekday, services }) => {
          const isSunday = weekday === "sun";
          return (
            <section class={cardClass}>
              <div class={headClass}>
                <h2 class="m-0 flex items-center gap-3 font-headline-md text-2xl font-bold leading-8 text-primary min-[960px]:text-[28px] min-[960px]:leading-9">
                  {isSunday && <Icon name="church" fill size={24} class="text-secondary-strong" />}
                  {WEEKDAY_RO[weekday]}
                </h2>
                {isSunday && <Badge tone="secondary">Ziua Domnului</Badge>}
              </div>
              {services.map((s) => (
                <div class:list={[rowClass, isSunday && "bg-surface-highlight"]}>
                  <span class={timeClass}>{s.time}</span>
                  <h3 class={nameClass}>{s.label}</h3>
                  {s.note && <p class={noteClass}>{s.note}</p>}
                  {s.cadence !== "weekly" && <p class={noteClass}>{CADENCE_RO[s.cadence]}</p>}
                </div>
              ))}
            </section>
          );
        })}
      </div>
    )}
    {specialServices.length > 0 && (
      <section class={cardClass}>
        <div class={headClass}>
          <h2 class="m-0 font-headline-md text-2xl font-bold leading-8 text-primary min-[960px]:text-[28px] min-[960px]:leading-9">
            Sărbători și rânduieli speciale
          </h2>
          <Badge tone="secondary">{CADENCE_RO.special}</Badge>
        </div>
        {specialServices.map((s) => (
          <div class={rowClass}>
            <span class={timeClass}>{s.time}</span>
            <h3 class={nameClass}>{s.label}</h3>
            {s.note && <p class={noteClass}>{s.note}</p>}
            {s.cadence !== "special" && <p class={noteClass}>{CADENCE_RO[s.cadence]}</p>}
          </div>
        ))}
      </section>
    )}
  </div>
)}
<style>
  .cx-schedule {
    width: 100%;
    border-collapse: collapse;
  }
  .cx-schedule th,
  .cx-schedule td {
    text-align: left;
    padding: 0.8rem 0.75rem;
    border-bottom: 1px solid var(--outline-variant);
    vertical-align: top;
  }
  /* Alternating row tints for scanning ease (DESIGN.md §Lists). */
  .cx-schedule tbody tr:nth-child(odd) {
    background: var(--surface-container-low);
  }
  .cx-schedule th {
    color: var(--on-surface-variant);
    font-size: 0.85rem;
  }
  .cx-schedule__note {
    display: block;
    color: var(--on-surface-variant);
    font-size: 0.9rem;
    font-weight: 400;
  }
</style>
