---
/**
 * `<SectionHeading>` — section title + optional subtitle (the porch notice: no kicker, no gradient rule).
 *
 * Left-aligned: an optional overline KICKER (the formal liturgical voice), a serif
 * `headline-lg` title in `primary`, then an optional muted subtitle. A thin gold
 * rule sits under the block, echoing the liturgical rail rather than boxing the
 * title in a full underline. Pure M3 utilities — re-skins per church by token swap.
 *
 * @prop {string} title          Heading text (rendered in the `as` tag).
 * @prop {string} [subtitle]     Optional muted lede below the title.
 * @prop {'h1'|'h2'|'h3'} [as='h2']  Heading level for document outline.
 * @prop {string} [class]        Extra classes appended to the wrapper.
 *
 * @example
 *   <SectionHeading title="Sprijină parohia" subtitle="Orice dar ne ajută." />
 */
interface Props {
  title: string;
  subtitle?: string;
  as?: "h1" | "h2" | "h3";
  class?: string;
}
const { title, subtitle, as = "h2", class: className } = Astro.props;
const Tag = as;
---

<div class:list={["mb-lg", className]}>
  <Tag class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary text-balance m-0">{title}</Tag>
  <div class="mt-2 h-px w-full bg-outline-variant"></div>
  {subtitle && <p class="mt-md max-w-2xl font-body-lg text-body-lg text-on-surface-variant text-pretty">{subtitle}</p>}
</div>
