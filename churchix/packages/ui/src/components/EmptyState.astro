---
/**
 * `<EmptyState>` — placeholder for empty lists/sections (Ecclesia Digitalis).
 *
 * Centered icon + title + message, with an optional CTA slot. Re-skins via tokens.
 *
 * @prop {IconName} [icon='calendar_month']  Leading glyph (Material Symbol).
 * @prop {string} title         Heading line (`text-headline-md`, burgundy).
 * @prop {string} [message]     Supporting copy (`text-body-md`, muted).
 * @prop {boolean} [iconFill=false]  Filled glyph variant.
 * @prop {'h1'|'h2'|'h3'} [as='h3']  Heading level. Defaults to `h3` (the common
 *        case: an empty list nested under a section h2). Set `as="h1"` when the
 *        empty state IS the page's primary heading (e.g. a 404/disabled page) so
 *        the document keeps exactly one h1 and a valid heading order.
 * @prop {string} [class]       Extra classes appended last.
 *
 * @slot default — optional message markup (overrides `message` prop if both given).
 * @slot cta     — optional call-to-action (e.g. a `<Button>`).
 *
 * @example
 *   ---
 *   import EmptyState from '@churchix/ui/components/EmptyState.astro';
 *   import Button from '@churchix/ui/components/Button.astro';
 *   ---
 *   <EmptyState icon="campaign" title="Nicio campanie activă"
 *               message="Reveniți curând pentru noi proiecte.">
 *     <Button slot="cta" href="/doneaza">Susține parohia</Button>
 *   </EmptyState>
 */
import Icon from "./Icon.astro";
import type { IconName } from "./icons.ts";

interface Props {
  icon?: IconName;
  title: string;
  message?: string;
  iconFill?: boolean;
  as?: "h1" | "h2" | "h3";
  class?: string;
  [key: string]: unknown;
}

const {
  icon = "calendar_month",
  title,
  message,
  iconFill = false,
  as: HeadingTag = "h3",
  class: className,
  ...rest
} = Astro.props;

const classes = [
  "grid justify-items-center gap-2 rounded-lg border border-outline-variant bg-surface-container-lowest px-6 py-10 text-center",
  className,
];
---

<div class:list={classes} {...rest}>
  <span class="text-primary">
    <Icon name={icon} fill={iconFill} size={32} />
  </span>
  <HeadingTag class="m-0 font-headline-md text-[22px] font-bold leading-7 text-primary">{title}</HeadingTag>
  {Astro.slots.has("default") ? (
    <div class="max-w-[28rem] font-body-md text-body-md text-on-surface-variant">
      <slot />
    </div>
  ) : (
    message && <p class="m-0 max-w-[28rem] font-body-md text-body-md text-on-surface-variant">{message}</p>
  )}
  {Astro.slots.has("cta") && (
    <div class="mt-xs">
      <slot name="cta" />
    </div>
  )}
</div>
