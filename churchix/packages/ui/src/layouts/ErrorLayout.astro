---
/**
 * `<ErrorLayout>` — shared, white-label error composition (the porch notice, approved 2026-11-13).
 *
 * Wraps `BaseLayout` chrome (per-church Header/Footer + brand tokens) around a `PageShell`: the slim name band
 * carries the heading (`h1`) and the supporting copy, and a raised card over its edge holds the church glyph, the
 * status code and the way home. Used for 404 (and any other terminal error screen). All copy is overridable per
 * church via props; reverent Romanian defaults live here.
 *
 * No per-church value is hardcoded — branding arrives through `site` (tokens emitted
 * by BaseLayout) and the component re-skins by token swap alone.
 *
 * @prop {SiteConfig} site        Required. Church `site` content entry (drives chrome + tokens).
 * @prop {string} [code='404']    Status code shown in the card.
 * @prop {string} [title]         Heading (defaults to "Pagina nu a fost găsită").
 * @prop {string} [message]       Supporting copy (reverent default below).
 * @prop {IconName} [icon='church']  Illustration glyph (`church` or `diversity_1`).
 * @prop {string} [homeLabel]     Home CTA label (defaults to "Înapoi la pagina principală").
 * @prop {string} [homeHref='/']  Home CTA target.
 * @prop {string} [path]          Canonical path passed to BaseLayout.
 *
 * @slot default — optional extra markup rendered under the CTA (e.g. helpful links).
 *
 * @example
 *   ---
 *   import ErrorLayout from '@churchix/ui/layouts/ErrorLayout.astro';
 *   import { getEntry } from 'astro:content';
 *   const site = (await getEntry('site', 'config'))!.data;
 *   ---
 *   <ErrorLayout site={site} />
 */
import BaseLayout from "./BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import { withBase } from "../lib/base.ts";
import type { IconName } from "../components/icons.ts";
import type { SiteConfig } from "@churchix/schemas";

interface Props {
  site: SiteConfig;
  code?: string;
  title?: string;
  message?: string;
  icon?: IconName;
  homeLabel?: string;
  homeHref?: string;
  path?: string;
}

const {
  site,
  code = "404",
  title = "Pagina nu a fost găsită",
  message = "Pagina pe care o căutați nu există sau a fost mutată. Vă rugăm să reveniți la pagina principală a parohiei.",
  icon = "church",
  homeLabel = "Înapoi la pagina principală",
  homeHref = "/",
  path,
} = Astro.props;
---

<BaseLayout site={site} title={title} description={message} path={path}>
  <PageShell title={title} lede={message}>
    <div class="mx-auto grid w-full max-w-[36rem] justify-items-center gap-2 rounded-lg border border-outline-variant bg-surface-container-lowest px-6 py-10 text-center shadow-board">
      <span class="text-primary">
        <Icon name={icon} size={32} />
      </span>
      {code && <p class="m-0 font-headline-md text-[22px] font-bold leading-7 text-primary">{code}</p>}
      <div class="mt-3">
        <Button variant="primary" href={withBase(homeHref)} icon="arrow_forward">
          {homeLabel}
        </Button>
      </div>
      <slot />
    </div>
  </PageShell>
</BaseLayout>
