---
import { site } from "../content/site";
---
{
  site.demo.show && (
    <div
      id="demo-banner"
      class="fixed top-0 inset-x-0 z-[var(--z-overlay)] bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] text-center text-[0.78rem] font-semibold tracking-wide px-4 py-1.5"
    >
      {site.demo.text}
    </div>
  )
}

<script is:inline>
  // Publish the banner height as --banner-h so the fixed nav can sit directly
  // beneath it and stay clear. Kept in sync on resize (text can wrap on mobile).
  (function () {
    var b = document.getElementById("demo-banner");
    if (!b) {
      document.documentElement.style.setProperty("--banner-h", "0px");
      return;
    }
    function set() {
      document.documentElement.style.setProperty("--banner-h", b.offsetHeight + "px");
    }
    set();
    window.addEventListener("resize", set, { passive: true });
  })();
</script>
